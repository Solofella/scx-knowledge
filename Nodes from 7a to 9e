        "jsCode": "const inp = $input.first().json;\nconst s2 = $('Step 2 - Payload Validation').first().json;\nconst bv = (typeof inp.brand_voice === 'string' ? JSON.parse(inp.brand_voice) : inp.brand_voice) || {};\n\nlet draft = inp.public_response_draft;\nconst notes = [];\nlet humanReviewRequired = inp.human_review_required;\n\nfunction flag(msg) {\n  notes.push(msg);\n  humanReviewRequired = true;\n}\n\n// ---- Auto-corrections (word and punctuation swaps only) ----\nconst landedRegex = /\\blanded\\b/gi;\nconst landingRegex = /\\blanding\\b/gi;\nif (landedRegex.test(draft)) {\n  draft = draft.replace(landedRegex, 'came together');\n  notes.push('BANNED WORD: landed (auto-corrected)');\n}\nif (landingRegex.test(draft)) {\n  draft = draft.replace(landingRegex, 'coming together');\n  notes.push('BANNED WORD: landing (auto-corrected)');\n}\n\nconst hasDash = /[\\u2014\\u2013]|\\s--+\\s/.test(draft);\nif (hasDash) {\n  draft = draft\n    .replace(/\\s*[\\u2014\\u2013]\\s*|\\s+--+\\s+/g, ', ')\n    .replace(/,\\s*,/g, ',')\n    .replace(/,\\s*([.!?])/g, '$1');\n  notes.push('DASH SWAP (auto-corrected)');\n}\n\n// ---- Fault, verdict and promise scan (flag only) ----\nconst faultChecks = [\n  ['APOLOGY OR REGRET', /\\b(sorry|apologi[sz]e[sd]?|apologies|regret(?:s|ted)?)\\b/i],\n  ['FAULT ADMISSION', /\\b(our fault|our mistake|we failed|fell short|let you down|we should have|should have been)\\b/i],\n  ['VERDICT ON COMPLAINT', /\\b(reasonable|fair|justified|legitimate|valid)\\b[^.!?]{0,40}\\b(expect\\w*|concern|complaint|request|frustrat\\w*)\\b|\\byou(?:'re| are) (?:absolutely |completely )?(?:right|correct)\\b/i],\n  ['PROMISE OF CHANGE', /\\bwe(?:'re| are) (?:reviewing|looking into|working on|investigating)\\b|\\bwe will (?:review|look into|address|change|improve|retrain)\\b/i]\n];\nfor (let i = 0; i < faultChecks.length; i++) {\n  if (faultChecks[i][1].test(draft)) flag(faultChecks[i][0] + ' (flagged, not auto-corrected)');\n}\n\n// ---- Contact checks (flag only) ----\nconst emails = draft.match(/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}/g) || [];\nconst allowed = (s2.needs_contact && bv.escalation_contact) ? String(bv.escalation_contact).trim() : null;\nconst strangers = emails.filter(function(e) { return !allowed || e.toLowerCase() !== allowed.toLowerCase(); });\nif (strangers.length > 0) flag('UNAUTHORIZED EMAIL: ' + strangers.join(', '));\n\nconst inviteRegex = /reach out|contact us|hear from you|get in touch|speak with you|follow up/i;\nif (s2.needs_contact) {\n  if (allowed) {\n    const count = draft.toLowerCase().split(allowed.toLowerCase()).length - 1;\n    if (count !== 1) flag('CONTACT ADDRESS appears ' + count + ' times, needs exactly 1');\n  } else {\n    flag('ESCALATION CONTACT NOT CONFIGURED for ' + inp.client_id);\n  }\n  if (!inviteRegex.test(draft)) flag('MISSING PRIVATE CONTACT INVITATION');\n}\n\n// ---- Existing near-miss check ----\nconst nearMissRegex = /\\bwe (genuinely |truly )?(carry|will carry)\\b/i;\nif (nearMissRegex.test(draft)) {\n  flag('NEAR-MISS PHRASE: \"carry\" construction close to banned pattern (flagged for review)');\n}\n\n// ---- High-liability hold ----\nif (s2.hold_for_review) flag('HOLD: high-liability, non-publishable until elevated review');\n\nlet auditFailedItems = inp.audit_failed_items;\nif (notes.length > 0) {\n  const newItems = notes.join(' | ');\n  auditFailedItems = auditFailedItems\n    ? auditFailedItems + ' | DETERMINISTIC: ' + newItems\n    : 'DETERMINISTIC: ' + newItems;\n}\n\nreturn [{ json: {\n  bra_record_id: inp.bra_record_id,\n  confirmed_response_tier: inp.confirmed_response_tier,\n  governance_flag: inp.governance_flag,\n  human_review_required: humanReviewRequired,\n  solution_type: inp.solution_type,\n  emotional_axis: inp.emotional_axis,\n  pain_axis: inp.pain_axis,\n  stability_axis: inp.stability_axis,\n  signal_based_consideration: inp.signal_based_consideration,\n  urgency_level: inp.urgency_level,\n  commercial_risk_flag: inp.commercial_risk_flag,\n  behavioral_interpretation: inp.behavioral_interpretation,\n  lang: inp.lang,\n  client_id: inp.client_id,\n  enriched_emotion_tag: inp.enriched_emotion_tag,\n  enriched_pain_point: inp.enriched_pain_point,\n  pain_point_sub_category: inp.pain_point_sub_category,\n  signal_type: inp.signal_type,\n  intensity_level: inp.intensity_level,\n  hsi_record_id: inp.hsi_record_id,\n  ess_record_id: inp.ess_record_id,\n  eip_record_id: inp.eip_record_id,\n  ala_record_id: inp.ala_record_id,\n  prior_run_id: inp.prior_run_id,\n  reviewer_handle: inp.reviewer_handle,\n  guest_name: inp.guest_name || null,\n  emotion_hypothesis: inp.emotion_hypothesis,\n  keywords: inp.keywords,\n  brand_voice: inp.brand_voice,\n  brand_voice_brief: inp.brand_voice_brief,\n  lang_resolved: inp.lang_resolved,\n  audit_passed: inp.audit_passed,\n  seo_keywords_used: inp.seo_keywords_used,\n  audit_failed_items: auditFailedItems,\n  public_response_draft: draft,\n  internal_followup_draft: inp.internal_followup_draft\n} }];"
