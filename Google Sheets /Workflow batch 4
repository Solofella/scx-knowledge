lock;background-color:#3b82f6;color:#fff;padding:12px 24px;text-decoration:none;border-radius:6px;margin:16px 0;font-weight:500}\n.sla-reminder{background-color:#fef3c7;padding:12px;border-left:4px solid #f59e0b;border-radius:4px;margin:16px 0;font-size:14px}\n.governance{font-size:13px;color:#6b7280;font-style:italic;margin:16px 0;padding:12px;background-color:#f9fafb;border-radius:4px}\n.footer{margin-top:24px;padding-top:16px;border-top:1px solid #e5e7eb;font-size:12px;color:#6b7280}\n</style>\n</head>\n<body>\n<div class=\"container\">\n<h2>Daily Review Response Summary</h2>\n<p>Good morning,</p>\n<p>Here is your daily platform reviews summary from <strong>${vars.prior_date}</strong>.</p>\n<div class=\"summary\">\n<div style=\"font-weight:600;margin-bottom:12px\">📊 New Responses Added Today:</div>\n${platformLines}\n<div style=\"margin-top:12px;padding-top:12px;border-top:1px solid #d1d5db;font-size:15px\">\n<strong>Total new responses:</strong> ${vars.records_processed_today}\n</div>\n</div>\n${elevatedBlock}\n<div style=\"margin:16px 0;font-size:14px\">\n📋 <strong>${vars.pending_previous_days} pending from previous days</strong> (still awaiting approval)\n</div>\n<div class=\"total-pending\">\nTotal Pending Your Review: ${vars.total_pending}\n</div>\n<div class=\"governance\">\nSubtextCX detects and interprets signals only. Operational decisions remain with your team.\n</div>\n<center>\n<a href=\"${vars.sheet_url}\" class=\"button\">👉 Review & Approve Responses</a>\n</center>\n<div class=\"sla-reminder\">\n<strong>⏱️ SLA Reminder:</strong> 48-hour approval window from first notification\n</div>\n<p style=\"margin-top:20px\">Questions? Reply to this email.</p>\n<div class=\"footer\">\n<div><strong>SubtextCX</strong> by Solofella LLC</div>\n<div>${vars.client_name} (${vars.client_id})</div>\n<div style=\"margin-top:8px;font-size:11px\">Sent: ${vars.date} at 07:05 UTC</div>\n</div>\n</div>\n</body>\n</html>`;\n\n// Build Brevo API payload object\nconst brevoPayload = {\n  sender: {\n    name: 'VRYOH intelligence',\n    email: vars.from_email\n  },\n  to: [{\n    email: vars.approval_contact_email,\n    name: 'Miguel'\n  }],\n  subject: `New Review Responses Ready (${vars.date})`,\n  htmlContent: htmlContent\n};\n\n// CRITICAL: Stringify the payload for RAW body mode (matching MRA pattern)\nconst brevoBodyStringified = JSON.stringify(brevoPayload);\n\n// Return with brevo_body as string (matching MRA Step 17 output)\nreturn [{ json: {\n  brevo_body: brevoBodyStringified,\n  // Pass through for logging\n  date: vars.date,\n  client_id: vars.client_id,\n  total_pending: vars.total_pending,\n  recipient_email: vars.approval_contact_email\n} }];"
