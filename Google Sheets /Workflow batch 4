        "jsCode": "// Step 11a - Ensure Output + Platform Count\n// Guarantees Step 12 always fires, even when loop returns 0 new records\n// ALSO counts platforms for Step 12a\n\nconst loopItems = $input.all();\n\n// Count total processed AND platform breakdown\nlet processedCount = 0;\nlet googleCount = 0;\nlet openTableCount = 0;\nlet yelpCount = 0;\nlet tripAdvisorCount = 0;\nlet otherCount = 0;\nlet t3Count = 0;\n\nfor (let i = 0; i < loopItems.length; i++) {\n  const item = loopItems[i].json;\n  \n  // Skip empty items\n  if (!item || Object.keys(item).length === 0) continue;\n  \n  processedCount++;\n  \n  // Count by platform (CAPITAL P - field name from Step 8)\n  const platform = (item.Platform || '').toLowerCase();\n  if (platform === 'google') googleCount++;\n  else if (platform === 'opentable') openTableCount++;\n  else if (platform === 'yelp') yelpCount++;\n  else if (platform === 'tripadvisor') tripAdvisorCount++;\n  else if (platform !== '') otherCount++;\n  \n  // Count T3 (CAPITAL S - field name from Step 8)\n  const status = item.Status || '';\n  if (status === 'Pending-Elevated') t3Count++;\n}\n\n// Return summary with platform counts\nreturn [{ json: {\n  loop_completed: true,\n  records_processed: processedCount,\n  completion_timestamp: new Date().toISOString(),\n  workflow_name: 'SCX-Sheet-Sync',\n  // Platform counts for Step 12a\n  google_count: googleCount,\n  opentable_count: openTableCount,\n  yelp_count: yelpCount,\n  tripadvisor_count: tripAdvisorCount,\n  other_count: otherCount,\n  t3_count: t3Count\n} }];"
