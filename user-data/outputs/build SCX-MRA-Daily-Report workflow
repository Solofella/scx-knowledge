### NODE 4 — Code Node (Calculate All Metrics)

**Node Title:** `Node 4 - Calculate All Metrics`  
**Node Type:** Code Node  
**Wire FROM:** Node 2 AND Node 3 (receives input from BOTH)  
**Wire TO:** Node 5 (Send Email)

**Code:**

```javascript
const yesterday = $("Node 2 - Query Yesterday Published Records").first().json.list || [];
const todayPending = $("Node 3 - Query Today New Pending Records").first().json.list || [];

// PERFORMANCE METRICS (Yesterday's published only)
let approved = 0;
let editedApproved = 0;
let stillPending = 0;
let notAccepted = 0;

for (let i = 0; i < yesterday.length; i++) {
  const status = yesterday[i]['Approval Status'];
  if (status === 'Approved') {
    approved++;
  } else if (status === 'Edited-Approved') {
    editedApproved++;
  } else if (status === 'Pending' || status === 'Pending-Elevated') {
    stillPending++;
  } else if (status === 'Not Accepted') {
    notAccepted++;
  }
}

// SLA COMPLIANCE (Yesterday's approved records only)
const totalApproved = approved + editedApproved;
let ontimeCount = 0;
let overdueCount = 0;

for (let i = 0; i < yesterday.length; i++) {
  const status = yesterday[i]['Approval Status'];
  if (status === 'Approved' || status === 'Edited-Approved') {
    const rdaTime = new Date(yesterday[i]['RDA Timestamp']).getTime();
    const pubTime = new Date(yesterday[i]['Published Timestamp']).getTime();
    const elapsedMs = pubTime - rdaTime;
    const slaMs = 48 * 60 * 60 * 1000; // 48 hours in milliseconds
    
    if (elapsedMs <= slaMs) {
      ontimeCount++;
    } else {
      overdueCount++;
    }
  }
}

// SIGNAL DISTRIBUTION (Yesterday's published)
let tNegative = 0;
let tAmbiguous = 0;
let tPositive = 0;

for (let i = 0; i < yesterday.length; i++) {
  const tier = yesterday[i]['Confirmed Response Tier'];
  if (tier === 'T3') {
    tNegative++;
  } else if (tier === 'T2') {
    tAmbiguous++;
  } else if (tier === 'T1') {
    tPositive++;
  }
}

// PLATFORM BREAKDOWN (Yesterday's published)
let googlePublished = 0;
let openTablePublished = 0;
let yelpPublished = 0;

for (let i = 0; i < yesterday.length; i++) {
  const platform = yesterday[i]['Platform'];
  if (platform === 'Google') {
    googlePublished++;
  } else if (platform === 'OpenTable') {
    openTablePublished++;
  } else if (platform === 'Yelp') {
    yelpPublished++;
  }
}

// TODAY'S WORKLOAD
const newToday = todayPending.length;
const stillPendingTotal = todayPending.length;
const totalPendingToday = newToday + stillPendingTotal;

// DATES
const now = new Date();
const priorDate = new Date(now.getTime() - 86400000).toISOString().split('T')[0];

return [{ json: {
  prior_date: priorDate,
  approved_count: approved,
  edited_approved_count: editedApproved,
  still_pending_count: stillPending,
  not_accepted_count: notAccepted,
  ontime_count: ontimeCount,
  total_approved_count: totalApproved,
  overdue_count: overdueCount,
  t_negative_count: tNegative,
  t_ambiguous_count: tAmbiguous,
  t_positive_count: tPositive,
  google_published_count: googlePublished,
  openTable_published_count: openTablePublished,
  yelp_published_count: yelpPublished,
  new_today_count: newToday,
  still_pending_total: stillPendingTotal,
  total_pending_today: totalPendingToday,
  approval_contact_email: 'marellano@solofella.com',
  client_name: 'Park Avenue Kitchen by David Burke',
  client_id: 'PAK-001',
  sheet_url: 'https://docs.google.com/spreadsheets/d/1JT0jt_l4NthR2n3Eu0-DUcWkhsMLV6mKaVJ5FFgIU6w/edit#gid=0'
} }];
```

**Purpose:** Calculates all metrics from yesterday's published records and today's pending records. Outputs a complete object with all 17 variables needed for the email template.

