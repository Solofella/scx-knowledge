Step 7 - Build Clusters
const inp = $input.first().json;
const eip_records = inp.eip_records;
const prior_n_map = inp.prior_n_map;
const has_prior_run = inp.has_prior_run;
const trend_threshold = inp.trend_threshold;
const min_cluster_size = inp.min_cluster_size;

function getSignalTier(signal_type) {
  if (['Dignity-Risk Signal','Negative Signal','Masked Negative Signal'].includes(signal_type))
    return 'T-NEGATIVE';
  if (['Ambiguous Negative Signal','Mixed Signal'].includes(signal_type))
    return 'T-AMBIGUOUS';
  return 'T-POSITIVE';
}

const tierOrder = {};
tierOrder['T-NEGATIVE'] = 0;
tierOrder['T-AMBIGUOUS'] = 1;
tierOrder['T-POSITIVE'] = 2;

const clusterMap = {};

for (const rec of eip_records) {
  const domain = rec['Domain'] || 'Unknown';
  const tier = getSignalTier(rec['Signal Type'] || '');
  const key = domain + '||' + tier;
  if (!clusterMap[key]) {
    clusterMap[key] = {};
    clusterMap[key].domain = domain;
    clusterMap[key].signal_tier = tier;
    clusterMap[key].n = 0;
    clusterMap[key].pain_points = {};
    clusterMap[key].emotions = {};
  }
  const cl = clusterMap[key];
  cl.n++;
  const pp = rec['Enriched Pain Point'] || 'Unknown';
  cl.pain_points[pp] = (cl.pain_points[pp] || 0) + 1;
  const em = rec['Enriched Emotion Tag'] || 'Unknown';
  cl.emotions[em] = (cl.emotions[em] || 0) + 1;
}

const clusters = [];
const clusterKeys = Object.keys(clusterMap);

for (const key of clusterKeys) {
  const cl = clusterMap[key];
  const priorN = prior_n_map[key];
  let trend_direction = 'New';
  let prior_n = null;
  let n_delta = null;
  if (has_prior_run && priorN !== undefined) {
    prior_n = priorN;
    n_delta = cl.n - priorN;
    const pct = priorN > 0 ? Math.abs(n_delta) / priorN : 1;
    trend_direction = pct <= trend_threshold ? 'Stable' : n_delta > 0 ? 'Growing' : 'Declining';
  }
  const ppEntries = Object.keys(cl.pain_points).map(k => ({ k: k, v: cl.pain_points[k] }));
  ppEntries.sort((a,b) => b.v - a.v);
  const ppBreakdown = {};
  for (const e of ppEntries) ppBreakdown[e.k] = e.v;
  const emEntries = Object.keys(cl.emotions).map(k => ({ k: k, v: cl.emotions[k] }));
  emEntries.sort((a,b) => b.v - a.v);
  const emBreakdown = {};
  for (const e of emEntries) emBreakdown[e.k] = e.v;
  const clusterItem = {};
  clusterItem.domain = cl.domain;
  clusterItem.signal_tier = cl.signal_tier;
  clusterItem.n = cl.n;
  clusterItem.prior_n = prior_n;
  clusterItem.n_delta = n_delta;
  clusterItem.trend_direction = trend_direction;
  clusterItem.enriched_pain_point_breakdown = JSON.stringify(ppBreakdown);
  clusterItem.enriched_emotion_breakdown = JSON.stringify(emBreakdown);
  clusterItem.is_singleton = cl.n < min_cluster_size;
  clusterItem.tier_order = tierOrder[cl.signal_tier];
  clusterItem.pct = 0;
  clusters.push(clusterItem);
}

clusters.sort((a,b) => {
  if (a.domain < b.domain) return -1;
  if (a.domain > b.domain) return 1;
  return a.tier_order - b.tier_order;
});

// Calculate percentage of total records per cluster
const totalN = clusters.reduce((sum, c) => sum + c.n, 0);
for (const c of clusters) {
  c.pct = totalN > 0 ? Math.round((c.n / totalN) * 10000) / 100 : 0;
}

let tNeg = 0;
let tAmb = 0;
let tPos = 0;
let growing = 0;
let declining = 0;
let stable = 0;
let newC = 0;
let singletons = 0;
let active = 0;

for (const c of clusters) {
  if (c.signal_tier === 'T-NEGATIVE') tNeg++;
  else if (c.signal_tier === 'T-AMBIGUOUS') tAmb++;
  else tPos++;
  if (c.trend_direction === 'Growing') growing++;
  else if (c.trend_direction === 'Declining') declining++;
  else if (c.trend_direction === 'Stable') stable++;
  else newC++;
  if (c.is_singleton) singletons++;
  else active++;
}

return [{ json: {
  window_days: inp.window_days,
  window_start: inp.window_start,
  window_end: inp.window_end,
  sia_run_id: inp.sia_run_id,
  run_timestamp: inp.run_timestamp,
  total_records: inp.total_records,
  clusters: clusters,
  cluster_count: clusters.length,
  t_negative_count: tNeg,
  t_ambiguous_count: tAmb,
  t_positive_count: tPos,
  growing: growing,
  declining: declining,
  stable: stable,
  new_clusters: newC,
  singletons: singletons,
  active: active
} }];


Step 7b - Split Clusters
const inp = $input.first().json;
const clusters = inp.clusters || [];
const output = [];

for (const cl of clusters) {
  const item = {};
  item.domain = cl.domain;
  item.signal_tier = cl.signal_tier;
  item.n = cl.n;
  item.prior_n = cl.prior_n;
  item.n_delta = cl.n_delta;
  item.trend_direction = cl.trend_direction;
  item.enriched_pain_point_breakdown = cl.enriched_pain_point_breakdown;
  item.enriched_emotion_breakdown = cl.enriched_emotion_breakdown;
  item.is_singleton = cl.is_singleton;
  item.pct = cl.pct;
  item.sia_run_id = inp.sia_run_id;
  item.run_timestamp = inp.run_timestamp;
  item.window_days = inp.window_days;
  item.total_records = inp.total_records;
  item.cluster_count = inp.cluster_count;
  item.t_negative_count = inp.t_negative_count;
  item.t_ambiguous_count = inp.t_ambiguous_count;
  item.t_positive_count = inp.t_positive_count;
  item.growing = inp.growing;
  item.declining = inp.declining;
  item.stable = inp.stable;
  item.new_clusters = inp.new_clusters;
  item.singletons = inp.singletons;
  item.active = inp.active;
  output.push({ json: item });
}

return output;


Step 8 - Build Bulk POST Body
const items = $input.all();
const records = [];

for (const item of items) {
  const cl = item.json;
  const record = {};
  record["SIA Run ID"] = cl.sia_run_id;
  record["Run Timestamp"] = cl.run_timestamp;
  record["Window Days"] = cl.window_days;
  record["Domain"] = cl.domain;
  record["Signal Tier"] = cl.signal_tier;
  record["N"] = cl.n;
  record["Prior N"] = cl.prior_n;
  record["N Delta"] = cl.n_delta;
  record["Trend Direction"] = cl.trend_direction;
  record["Enriched Pain Point Breakdown"] = cl.enriched_pain_point_breakdown;
  record["Enriched Emotion Breakdown"] = cl.enriched_emotion_breakdown;
  record["Is Singleton"] = cl.is_singleton;
  record["Percentage"] = cl.pct;
  records.push(record);
}

const firstItem = $input.first().json;

return [{ json: {
  sia_run_id: firstItem.sia_run_id,
  cluster_count: firstItem.cluster_count,
  bulk_post_body: JSON.stringify(records)
} }];


