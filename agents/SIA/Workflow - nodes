Step 4 - Handle Empty Window
const response = $input.first().json;
const allRecords = response.list || [];
const s2 = $('Step 2 - Set Window Bounds').first().json;

const windowStart = new Date(s2.window_start).getTime();
const windowEnd = new Date(s2.window_end).getTime();

const records = allRecords.filter(rec => {
  const ts = rec['EIP Timestamp'] ? new Date(rec['EIP Timestamp']).getTime() : 0;
  return ts >= windowStart && ts <= windowEnd;
});

return [{ json: {
  window_days: s2.window_days,
  window_start: s2.window_start,
  window_end: s2.window_end,
  trend_threshold: s2.trend_threshold,
  min_cluster_size: s2.min_cluster_size,
  sia_run_id: s2.sia_run_id,
  run_timestamp: s2.run_timestamp,
  eip_records: records,
  total_records: records.length,
  empty_run: records.length === 0
} }];


