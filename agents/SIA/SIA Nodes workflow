    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst allAla = response.list || [];\nconst s4 = $('Step 4 - Set Window Bounds').first().json;\n\nconst periodStartTs = new Date(s4.window_start).getTime();\nconst periodEndTs = new Date(s4.window_end).getTime();\n\nconst filteredAla = [];\nconst alaIdList = [];\nconst alaClientMap = {};\n\nfor (let i = 0; i < allAla.length; i++) {\n  const rec = allAla[i];\n  const raw = rec['Date'] || '';\n  \n  if (raw.length > 0) {\n    const parts = raw.split('/');\n    if (parts.length === 3) {\n      const month = parseInt(parts[0]);\n      const day = parseInt(parts[1]);\n      const year = 2000 + parseInt(parts[2]);\n      const ts = new Date(year, month - 1, day).getTime();\n      \n      if (ts >= periodStartTs && ts < periodEndTs) {\n        filteredAla.push(rec);\n        const alaId = rec['Id'];\n        alaIdList.push(alaId);\n        alaClientMap[alaId] = rec['Client ID'] || 'UNKNOWN';\n      }\n    }\n  }\n}\n\nreturn [{ json: {\n  window_type: s4.window_type,\n  window_days: s4.window_days,\n  window_start: s4.window_start,\n  window_end: s4.window_end,\n  trend_threshold: s4.trend_threshold,\n  min_cluster_size: s4.min_cluster_size,\n  sia_run_id: s4.sia_run_id,\n  run_timestamp: s4.run_timestamp,\n  filtered_ala_records: filteredAla,\n  ala_id_list: alaIdList,\n  ala_client_map: alaClientMap,\n  ala_count: filteredAla.length,\n  empty_run: filteredAla.length === 0\n} }];"
