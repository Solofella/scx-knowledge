        "jsCode": "const eipResponse = $input.first().json;\nconst allEip = eipResponse.list || [];\nconst s6 = $('Step 6 - Filter ALA by Date').first().json;\n\nconst alaIdList = s6.ala_id_list;\nconst alaClientMap = s6.ala_client_map;\n\nconst alaIdSet = {};\nfor (let i = 0; i < alaIdList.length; i++) {\n  alaIdSet[alaIdList[i]] = true;\n}\n\nconst filteredEip = [];\nfor (let i = 0; i < allEip.length; i++) {\n  const rec = allEip[i];\n  const alaId = rec['ALA Record ID'];\n  if (alaIdSet[alaId]) {\n    rec.client_id = alaClientMap[alaId];\n    filteredEip.push(rec);\n  }\n}\n\nreturn [{ json: {\n  window_type: s6.window_type,\n  window_days: s6.window_days,\n  window_start: s6.window_start,\n  window_end: s6.window_end,\n  trend_threshold: s6.trend_threshold,\n  min_cluster_size: s6.min_cluster_size,\n  sia_run_id: s6.sia_run_id,\n  run_timestamp: s6.run_timestamp,\n  eip_records: filteredEip,\n  total_records: filteredEip.length,\n  empty_run: filteredEip.length === 0\n} }];"
