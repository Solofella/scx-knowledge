        "jsCode": "const inp = $input.first().json;\nconst clusters = inp.clusters || [];\nconst output = [];\n\nfor (let i = 0; i < clusters.length; i++) {\n  const cl = clusters[i];\n  const item = {};\n  item.client_id = cl.client_id;\n  item.domain = cl.domain;\n  item.signal_tier = cl.signal_tier;\n  item.n = cl.n;\n  item.prior_n = cl.prior_n;\n  item.n_delta = cl.n_delta;\n  item.trend_direction = cl.trend_direction;\n  item.enriched_pain_point_breakdown = cl.enriched_pain_point_breakdown;\n  item.enriched_emotion_breakdown = cl.enriched_emotion_breakdown;\n  item.is_singleton = cl.is_singleton;\n  item.pct = cl.pct;\n  item.window_type = inp.window_type;\n  item.sia_run_id = inp.sia_run_id;\n  item.run_timestamp = inp.run_timestamp;\n  item.window_days = inp.window_days;\n  item.total_records = inp.total_records;\n  item.cluster_count = inp.cluster_count;\n  item.t_negative_count = inp.t_negative_count;\n  item.t_ambiguous_count = inp.t_ambiguous_count;\n  item.t_positive_count = inp.t_positive_count;\n  item.growing = inp.growing;\n  item.declining = inp.declining;\n  item.stable = inp.stable;\n  item.new_clusters = inp.new_clusters;\n  item.singletons = inp.singletons;\n  item.active = inp.active;\n  output.push({ json: item });\n}\n\nreturn output;"
