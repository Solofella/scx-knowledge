    {
      "parameters": {
        "jsCode": "const inp = $input.first().json;\n\nconst now = new Date();\nconst window_type = inp.window_type || 'monthly';\nconst window_days = inp.window_days || 30;\n\nlet windowStart;\nlet windowEnd;\n\nif (window_type === 'weekly') {\n  // Calculate previous complete week (Monday-Sunday)\n  const currentDay = now.getUTCDay(); // 0=Sunday, 1=Monday, ..., 6=Saturday\n  \n  // If today is Monday, go back to previous Sunday 23:59:59\n  // If today is any other day, calculate back to most recent Sunday 23:59:59\n  let daysToLastSunday;\n  if (currentDay === 0) {\n    daysToLastSunday = 0; // Today is Sunday\n  } else if (currentDay === 1) {\n    daysToLastSunday = 1; // Today is Monday, go back 1 day to Sunday\n  } else {\n    daysToLastSunday = currentDay; // Go back to most recent Sunday\n  }\n  \n  // Last Sunday 23:59:59.999 UTC\n  const lastSunday = new Date(now.getTime() - daysToLastSunday * 86400000);\n  lastSunday.setUTCHours(23, 59, 59, 999);\n  windowEnd = lastSunday.toISOString();\n  \n  // Previous Monday 00:00:00.000 UTC (6 days before last Sunday)\n  const previousMonday = new Date(lastSunday.getTime() - 6 * 86400000);\n  previousMonday.setUTCHours(0, 0, 0, 0);\n  windowStart = previousMonday.toISOString();\n} else {\n  // Daily and Monthly use rolling window (unchanged)\n  windowEnd = now.toISOString();\n  windowStart = new Date(now.getTime() - window_days * 86400000).toISOString();\n}\n\nconst pad = (n, l=2) => String(n).padStart(l, '0');\nconst d = `${now.getFullYear()}${pad(now.getMonth()+1)}${pad(now.getDate())}`;\nconst t = `${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;\n\nreturn [{ json: {\n  window_type: window_type,\n  window_days: window_days,\n  window_start: windowStart,\n  window_end: windowEnd,\n  trend_threshold: 0.20,\n  min_cluster_size: 2,\n  sia_run_id: `SIA-${d}-${t}`,\n  run_timestamp: now.toISOString()\n} }];"
