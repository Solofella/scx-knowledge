    {
      "parameters": {
        "jsCode": "const inp = $input.first().json;\nconst eip_records = inp.eip_records;\nconst prior_n_map = inp.prior_n_map;\nconst has_prior_run = inp.has_prior_run;\nconst trend_threshold = inp.trend_threshold;\nconst min_cluster_size = inp.min_cluster_size;\n\nfunction getSignalTier(signal_type) {\n  if (['Dignity-Risk Signal','Negative Signal','Masked Negative Signal'].includes(signal_type))\n    return 'T-NEGATIVE';\n  if (['Ambiguous Negative Signal','Mixed Signal'].includes(signal_type))\n    return 'T-AMBIGUOUS';\n  return 'T-POSITIVE';\n}\n\nconst tierOrder = {};\ntierOrder['T-NEGATIVE'] = 0;\ntierOrder['T-AMBIGUOUS'] = 1;\ntierOrder['T-POSITIVE'] = 2;\n\nconst clusterMap = {};\n\nfor (let i = 0; i < eip_records.length; i++) {\n  const rec = eip_records[i];\n  const domain = rec['Domain'] || 'Unknown';\n  const tier = getSignalTier(rec['Signal Type'] || '');\n  const key = domain + '||' + tier;\n  if (!clusterMap[key]) {\n    clusterMap[key] = {};\n    clusterMap[key].domain = domain;\n    clusterMap[key].signal_tier = tier;\n    clusterMap[key].n = 0;\n    clusterMap[key].pain_points = {};\n    clusterMap[key].emotions = {};\n    clusterMap[key].client_id = rec.client_id || 'UNKNOWN';\n  }\n  const cl = clusterMap[key];\n  cl.n++;\n  const pp = rec['Enriched Pain Point'] || 'Unknown';\n  cl.pain_points[pp] = (cl.pain_points[pp] || 0) + 1;\n  const em = rec['Enriched Emotion Tag'] || 'Unknown';\n  cl.emotions[em] = (cl.emotions[em] || 0) + 1;\n}\n\nconst clusters = [];\nconst clusterKeys = Object.keys(clusterMap);\n\nfor (let j = 0; j < clusterKeys.length; j++) {\n  const key = clusterKeys[j];\n  const cl = clusterMap[key];\n  const clusterKey = cl.client_id + '||' + cl.domain + '||' + cl.signal_tier;\nconst priorN = prior_n_map[clusterKey];\n  let trend_direction = 'New';\n  let prior_n = null;\n  let n_delta = null;\n  if (has_prior_run && priorN !== undefined) {\n    prior_n = priorN;\n    n_delta = cl.n - priorN;\n    const pct = priorN > 0 ? Math.abs(n_delta) / priorN : 1;\n    trend_direction = pct <= trend_threshold ? 'Stable' : n_delta > 0 ? 'Growing' : 'Declining';\n  }\n  const ppEntries = Object.keys(cl.pain_points).map(k => ({ k: k, v: cl.pain_points[k] }));\n  ppEntries.sort((a,b) => b.v - a.v);\n  const ppBreakdown = {};\n  for (let p = 0; p < ppEntries.length; p++) {\n    const e = ppEntries[p];\n    ppBreakdown[e.k] = e.v;\n  }\n  const emEntries = Object.keys(cl.emotions).map(k => ({ k: k, v: cl.emotions[k] }));\n  emEntries.sort((a,b) => b.v - a.v);\n  const emBreakdown = {};\n  for (let m = 0; m < emEntries.length; m++) {\n    const e = emEntries[m];\n    emBreakdown[e.k] = e.v;\n  }\n  const clusterItem = {};\n  clusterItem.client_id = cl.client_id;\n  clusterItem.domain = cl.domain;\n  clusterItem.signal_tier = cl.signal_tier;\n  clusterItem.n = cl.n;\n  clusterItem.prior_n = prior_n;\n  clusterItem.n_delta = n_delta;\n  clusterItem.trend_direction = trend_direction;\n  clusterItem.enriched_pain_point_breakdown = JSON.stringify(ppBreakdown);\n  clusterItem.enriched_emotion_breakdown = JSON.stringify(emBreakdown);\n  clusterItem.is_singleton = cl.n < min_cluster_size;\n  clusterItem.tier_order = tierOrder[cl.signal_tier];\n  clusterItem.pct = 0;\n  clusters.push(clusterItem);\n}\n\nclusters.sort((a,b) => {\n  if (a.domain < b.domain) return -1;\n  if (a.domain > b.domain) return 1;\n  return a.tier_order - b.tier_order;\n});\n\nconst totalN = clusters.reduce((sum, c) => sum + c.n, 0);\nfor (let c = 0; c < clusters.length; c++) {\n  clusters[c].pct = totalN > 0 ? Math.round((clusters[c].n / totalN) * 10000) / 100 : 0;\n}\n\nlet tNeg = 0;\nlet tAmb = 0;\nlet tPos = 0;\nlet growing = 0;\nlet declining = 0;\nlet stable = 0;\nlet newC = 0;\nlet singletons = 0;\nlet active = 0;\n\nfor (let c = 0; c < clusters.length; c++) {\n  const cluster = clusters[c];\n  if (cluster.signal_tier === 'T-NEGATIVE') tNeg++;\n  else if (cluster.signal_tier === 'T-AMBIGUOUS') tAmb++;\n  else tPos++;\n  if (cluster.trend_direction === 'Growing') growing++;\n  else if (cluster.trend_direction === 'Declining') declining++;\n  else if (cluster.trend_direction === 'Stable') stable++;\n  else newC++;\n  if (cluster.is_singleton) singletons++;\n  else active++;\n}\n\nreturn [{ json: {\n  window_type: inp.window_type,\n  window_days: inp.window_days,\n  window_start: inp.window_start,\n  window_end: inp.window_end,\n  sia_run_id: inp.sia_run_id,\n  run_timestamp: inp.run_timestamp,\n  total_records: inp.total_records,\n  clusters: clusters,\n  cluster_count: clusters.length,\n  t_negative_count: tNeg,\n  t_ambiguous_count: tAmb,\n  t_positive_count: tPos,\n  growing: growing,\n  declining: declining,\n  stable: stable,\n  new_clusters: newC,\n  singletons: singletons,\n  active: active\n} }];"
