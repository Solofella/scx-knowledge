    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst priorClusters = response.list || [];\nconst s8 = $('Step 8 - Filter EIP by ALA Match').first().json;\n\nconst priorNByKey = {};\nfor (let i = 0; i < priorClusters.length; i++) {\n  const pc = priorClusters[i];\n  const key = (pc['Client ID'] || 'UNKNOWN') + '||' + pc['Domain'] + '||' + pc['Signal Tier'];\n  if (!priorNByKey[key]) {\n    priorNByKey[key] = parseInt(pc['N'] || 0);\n  }\n}\n\nreturn [{ json: {\n  window_type: s8.window_type,\n  window_days: s8.window_days,\n  window_start: s8.window_start,\n  window_end: s8.window_end,\n  trend_threshold: s8.trend_threshold,\n  min_cluster_size: s8.min_cluster_size,\n  sia_run_id: s8.sia_run_id,\n  run_timestamp: s8.run_timestamp,\n  eip_records: s8.eip_records,\n  total_records: s8.total_records,\n  empty_run: s8.empty_run,\n  prior_n_map: priorNByKey,\n  has_prior_run: priorClusters.length > 0\n} }];"
