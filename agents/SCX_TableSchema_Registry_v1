    {
      "parameters": {
        "jsCode": "const resp   = $input.first().json;\nconst config = $('Config').first().json;\n\nconst tables = (resp.list || []).map(t => ({\n  table_id:          t.id,\n  table_name:        t.title,\n  nocodb_base_url:   config.nocodb_base_url,\n  nocodb_base_id:    config.nocodb_base_id,\n  registry_table_id: config.registry_table_id,\n  nocodb_token:      config.nocodb_token,\n  batch_size:        config.batch_size,\n}));\n\nif (tables.length === 0) {\n  throw new Error('No tables found.');\n}\n\nreturn tables.map(t => ({ json: t }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        0
      ],
      "id": "b1e0b20b-4956-4a04-ad31-ca56f8d71521",
      "name": "Extract Tables"
    },
    {
      "parameters": {
        "jsCode": "const http = require('http');\nconst items = $input.all();\nconst now = new Date().toISOString().split('.')[0] + 'Z';\nconst config = $('Config').first().json;\nconst allFieldRecords = [];\n\nfunction httpGet(url, token) {\n  return new Promise((resolve, reject) => {\n    const req = http.get(url, {\n      headers: { 'xc-token': token }\n    }, (res) => {\n      let body = '';\n      res.on('data', chunk => body += chunk);\n      res.on('end', () => {\n        try { resolve(JSON.parse(body)); }\n        catch(e) { reject(e); }\n      });\n    });\n    req.on('error', reject);\n  });\n}\n\nfor (const item of items) {\n  const tableId   = item.json.table_id;\n  const tableName = item.json.table_name;\n  const url = `${config.nocodb_base_url}/api/v1/db/meta/tables/${tableId}`;\n  const data = await httpGet(url, config.nocodb_token);\n  const columns = data.columns || [];\n\n  for (const col of columns) {\n    allFieldRecords.push({\n      'Table Name':   tableName,\n      'Table ID':     tableId,\n      'Field Name':   col.title,\n      'Field ID':     col.id,\n      'Type':         col.uidt || 'Unknown',\n      'Last Updated': now,\n    });\n  }\n}\n\nconsole.log(`Total fields: ${allFieldRecords.length}`);\n\nreturn [{ json: {\n  all_field_records: allFieldRecords,\n  nocodb_base_url:   config.nocodb_base_url,\n  nocodb_base_id:    config.nocodb_base_id,\n  registry_table_id: config.registry_table_id,\n  nocodb_token:      config.nocodb_token,\n  batch_size:        config.batch_size,\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
