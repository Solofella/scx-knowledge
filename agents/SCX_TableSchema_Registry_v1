      "id": "27e667b7-a1e8-496f-a347-d58a367f614e",
      "name": "Get Registry Rows",
      "alwaysOutputData": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "DT9tnRgqYpPc3rXo",
          "name": "xc-token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const config = $('Config').first().json;\n\n// Registry rows come from Get Registry Rows (previous node)\nconst registryResponse = $('Get Registry Rows').first().json;\nconst existing = registryResponse.list || [];\n\n// Field records come from Fetch All Fields\nconst allFieldRecords = $('Fetch All Fields').first().json.all_field_records || [];\n\nconst existingMap = {};\nfor (const rec of existing) {\n  if (rec['Field ID']) {\n    existingMap[rec['Field ID']] = rec.Id;\n  }\n}\n\nconst toCreate = [];\nconst toUpdate = [];\n\nfor (const rec of allFieldRecords) {\n  const existingId = existingMap[rec['Field ID']];\n  if (existingId) {\n    toUpdate.push({ Id: existingId, ...rec });\n  } else {\n    toCreate.push(rec);\n  }\n}\n\nconsole.log(`To create: ${toCreate.length} | To update: ${toUpdate.length}`);\n\nreturn [{ json: {\n  to_create:         toCreate,\n  to_update:         toUpdate,\n  create_count:      toCreate.length,\n  update_count:      toUpdate.length,\n  nocodb_base_url:   config.nocodb_base_url,\n  nocodb_base_id:    config.nocodb_base_id,\n  registry_table_id: config.registry_table_id,\n  nocodb_token:      config.nocodb_token,\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        0
      ],
      "id": "040c2f3c-f111-4b4d-98d8-e9ca611d16fb",
      "name": "Dedup Split"
    },
    {
      "parameters": {
        "jsCode": "const http = require('http');\nconst row = $input.first().json;\nconst records = row.to_create;\nconst url = `${row.nocodb_base_url}/api/v1/db/data/bulk/noco/${row.nocodb_base_id}/${row.registry_table_id}`;\n\nfunction httpPost(url, token, data) {\n  return new Promise((resolve, reject) => {\n    const body = JSON.stringify(data);\n    const options = {\n      method: 'POST',\n      headers: {\n        'xc-token': token,\n        'Content-Type': 'application/json',\n        'Content-Length': Buffer.byteLength(body)\n      }\n    };\n    const req = http.request(url, options, (res) => {\n      let response = '';\n      res.on('data', chunk => response += chunk);\n      res.on('end', () => {\n        try { resolve(JSON.parse(response)); }\n        catch(e) { resolve(response); }\n      });\n    });\n    req.on('error', reject);\n    req.write(body);\n    req.end();\n  });\n}\n\n// Chunk into batches of 100 — NocoDB limit per bulk request\nconst chunkSize = 100;\nlet totalCreated = 0;\n\nfor (let i = 0; i < records.length; i += chunkSize) {\n  const chunk = records.slice(i, i + chunkSize);\n  await httpPost(url, row.nocodb_token, chunk);\n  totalCreated += chunk.length;\n  console.log(`Created batch ${Math.floor(i/chunkSize)+1}: ${chunk.length} records`);\n}\n\nconsole.log(`Total created: ${totalCreated}`);\n\nreturn [{ json: {\n  created: totalCreated,\n  summary: `Created ${totalCreated} registry rows`\n} }];"
      },
