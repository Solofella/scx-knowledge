      "parameters": {
        "url": "={{$json.nocodb_base_url}}/api/v1/db/data/noco/{{$json.nocodb_base_id}}/{{$json.registry_table_id}}?limit=1000&where=(Id,gt,0)",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
