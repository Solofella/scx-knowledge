        "jsCode": "// Step 12a - Count Platform Records\n// Read platform counts from Step 11a (passed through Step 12)\n\nconst input = $input.first().json;\n\n// Calculate dates\nconst today = new Date();\nconst yesterday = new Date(today.getTime() - 86400000);\n\nreturn [{ json: {\n  date: today.toISOString().split('T')[0],\n  prior_date: yesterday.toISOString().split('T')[0],\n  google_count: input.google_count || 0,\n  opentable_count: input.opentable_count || 0,\n  yelp_count: input.yelp_count || 0,\n  tripadvisor_count: input.tripadvisor_count || 0,\n  other_count: input.other_count || 0,\n  t3_count: input.t3_count || 0,\n  records_processed: input.records_processed || 0\n} }];"
