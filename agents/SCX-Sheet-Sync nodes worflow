    {
      "parameters": {
        "jsCode": "// Read from both parallel branches\nconst currentCounts = $('Step 12a - Count Platform Records').first().json;\nconst previousCounts = $('Step 12b-filter - Filter Previous Pending').first().json;\n\nconst pendingPreviousDays = previousCounts.pending_previous_days || 0;\nconst totalPending = currentCounts.records_processed + pendingPreviousDays;\n\n// Email configuration\nconst emailVariables = {\n  // Date fields\n  date: currentCounts.date,\n  prior_date: currentCounts.prior_date,\n  \n  // Platform counts (only today's new records)\n  google_count: currentCounts.google_count,\n  opentable_count: currentCounts.opentable_count,\n  yelp_count: currentCounts.yelp_count,\n  tripadvisor_count: currentCounts.tripadvisor_count,\n  other_count: currentCounts.other_count,\n  \n  // Elevated attention (T3 records from today)\n  t3_count: currentCounts.t3_count,\n  \n  // Pending counts\n  pending_previous_days: pendingPreviousDays,\n  total_pending: totalPending,\n  records_processed_today: currentCounts.records_processed,\n  \n  // Email recipient\n  approval_contact_email: 'miguel@solofella.com',\n  from_email: 'marellano@solofella.com',\n  \n  // Client info\n  client_name: 'Park Avenue Kitchen by David Burke',\n  client_id: 'PAK-001',\n  sheet_url: 'https://docs.google.com/spreadsheets/d/1JT0jt_l4NthR2n3Eu0-DUcWkhsMLV6mKaVJ5FFgIU6w/edit#gid=0'\n};\n\nreturn [{ json: emailVariables }];"
