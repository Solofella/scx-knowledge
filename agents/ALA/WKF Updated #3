      "parameters": {
        "jsCode": "const row = $('Step 9 - Dedup Hash').first().json;\n\nconst systemPrompt = 'You are a classification agent for customer reviews of hospitality businesses. Produce a basic first-pass assessment: pain point domain, dominant emotion, keywords. You do not use a controlled taxonomy. Plain reasoning only. pain_point_domain: 2-4 plain descriptive words. e.g. Staff behavior, Room quality, Check-in. preliminary_emotion_tag: exactly one plain emotion word. e.g. Frustrated, Ignored, Grateful. keywords: 3-5 lowercase literal terms extracted directly from the review text. OUTPUT: JSON only. { \"pain_point_domain\": \"...\", \"preliminary_emotion_tag\": \"...\", \"keywords\": [...] }';\n\nconst userPrompt = 'REVIEW:\\nStar Rating: ' + (row.star_rating !== null && row.star_rating !== undefined ? row.star_rating : 'not provided') + '\\nPlatform: ' + row.platform + '\\nText: ' + row.clean_text + '\\n\\nClassify this review. Return JSON only.';\n\nconst requestBody = JSON.stringify({\n  model: \"gpt-5.2\",\n  temperature: 0,\n  max_completion_tokens: 150,\n  response_format: { type: \"json_object\" },\n  messages: [\n    { role: \"system\", content: systemPrompt },\n    { role: \"user\", content: userPrompt }\n  ]\n});\n\nconst result = {};\nresult.date = row.date;\nresult.platform = row.platform;\nresult.raw_text = row.raw_text;\nresult.reviewer_name = row.reviewer_name;\nresult.lang_csv = row.lang_csv;\nresult.lang = row.lang;\nresult.lang_source = row.lang_source;\nresult.star_rating = row.star_rating;\nresult.clean_text = row.clean_text;\nresult.raw_text_original = row.raw_text_original;\nresult.reviewer_handle = row.reviewer_handle;\nresult.dedup_hash = row.dedup_hash;\nresult.client_id = row.client_id;\nresult.system_prompt = systemPrompt;\nresult.user_prompt = userPrompt;\nresult.request_body = requestBody;\nreturn [{ json: result }];"
