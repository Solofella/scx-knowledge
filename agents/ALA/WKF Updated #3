      "parameters": {
        "jsCode": "const row = $input.first().json;\nconst raw = row.choices?.[0]?.message?.content;\n\nif (!raw) throw new Error('GPT returned empty response.');\n\nlet parsed;\ntry { parsed = JSON.parse(raw); }\ncatch(e) { throw new Error('GPT invalid JSON: ' + raw.substring(0, 300)); }\n\nif (!parsed.pain_point_domain || typeof parsed.pain_point_domain !== 'string')\n  throw new Error('Missing pain_point_domain in GPT response.');\n\nif (parsed.pain_point_domain.length > 80)\n  parsed.pain_point_domain = parsed.pain_point_domain.substring(0, 80).trim();\n\nif (!parsed.preliminary_emotion_tag || typeof parsed.preliminary_emotion_tag !== 'string')\n  throw new Error('Missing preliminary_emotion_tag in GPT response.');\n\nif (!Array.isArray(parsed.keywords))\n  throw new Error('keywords must be an array.');\n\nif (parsed.keywords.length < 3 || parsed.keywords.length > 5)\n  console.warn(`keywords count ${parsed.keywords.length} outside 3-5 range.`);\n\nparsed.keywords = parsed.keywords\n  .filter(k => typeof k === 'string')\n  .map(k => k.toLowerCase().trim())\n  .slice(0, 5);\n\nconst upstream = $('Step 9 - Dedup Hash').first().json;\n\nconst out = {};\nout.date = upstream.date;\nout.platform = upstream.platform;\nout.raw_text = upstream.raw_text;\nout.reviewer_name = upstream.reviewer_name;\nout.lang_csv = upstream.lang_csv;\nout.lang = upstream.lang;\nout.lang_source = upstream.lang_source;\nout.star_rating = upstream.star_rating;\nout.clean_text = upstream.clean_text;\nout.raw_text_original = upstream.raw_text_original;\nout.reviewer_handle = upstream.reviewer_handle;\nout.dedup_hash = upstream.dedup_hash;\nout.client_id = upstream.client_id;\nout.pain_point_domain = parsed.pain_point_domain;\nout.preliminary_emotion_tag = parsed.preliminary_emotion_tag;\nout.keywords = parsed.keywords.join(', ');\nreturn [{ json: out }];"
