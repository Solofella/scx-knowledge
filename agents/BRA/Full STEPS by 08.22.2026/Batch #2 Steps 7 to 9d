        "jsCode": "const inp = $input.first().json;\nconst templates = inp.templates || [];\nfunction hashId(id) {\n  let h = 0;\n  const s = String(id);\n  for (let i = 0; i < s.length; i++) {\n    h = Math.imul(31, h) + s.charCodeAt(i) | 0;\n  }\n  return Math.abs(h);\n}\nconst seed = hashId(inp.hsi_record_id);\nconst pole = inp.dominant_pole || \"Negative\";\nconst filtered = templates.filter(t => t[\"Signal Category\"] === pole);\nconst pool = filtered.length > 0 ? filtered : templates;\nconst selected = pool[seed % pool.length];\nreturn [{ json: {\n  hsi_record_id: inp.hsi_record_id,\n  preliminary_response_tier: inp.preliminary_response_tier,\n  human_review_required: inp.human_review_required,\n  signal_synthesis_summary: inp.signal_synthesis_summary,\n  contextual_linguistic_framing: inp.contextual_linguistic_framing,\n  temporal_signal_insight: inp.temporal_signal_insight,\n  masked_emotion_hypothesis: inp.masked_emotion_hypothesis,\n  interpretation_confidence: inp.interpretation_confidence,\n  pattern_type_recurrence: inp.pattern_type_recurrence,\n  prior_record_count: inp.prior_record_count,\n  enriched_pain_point: inp.enriched_pain_point,\n  pain_point_sub_category: inp.pain_point_sub_category,\n  signal_type: inp.signal_type,\n  intensity_level: inp.intensity_level,\n  dominant_pole: inp.dominant_pole,\n  enriched_emotion_tag: inp.enriched_emotion_tag,\n  ambiguity_flag: inp.ambiguity_flag,\n  masked_emotion_flag: inp.masked_emotion_flag,\n  collapse_flag: inp.collapse_flag,\n  lang: inp.lang,\n  reviewer_handle: inp.reviewer_handle,\n  client_id: inp.client_id,\n  ess_record_id: inp.ess_record_id,\n  eip_record_id: inp.eip_record_id,\n  ala_record_id: inp.ala_record_id,\n  prior_run_id: inp.prior_run_id,\n  emotion_hypothesis: inp.emotion_hypothesis,\n  keywords: inp.keywords,\n  templates: inp.templates,\n  stability_axis: inp.stability_axis,\n  pain_axis: inp.pain_axis,\n  urgency_level_default: inp.urgency_level_default,\n  commercial_risk_preflag: