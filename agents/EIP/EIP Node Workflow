      "parameters": {
        "jsCode": "const painData = $input.first().json;\nconst entries = painData.list || [];\n\nif (entries.length === 0) {\n  throw new Error('Pain Point Master returned empty.');\n}\n\nlet painLines = [];\nlet domainGroup = {};\nconst swMap = {};\n\nfor (const entry of entries) {\n  const domain = entry['Domain'];\n  const enrichedPP = entry['Enriched Pain Point'];\n  const sw = parseInt(entry['Signal Weight']);\n  if (enrichedPP && !isNaN(sw)) swMap[enrichedPP] = sw;\n  if (!domainGroup[domain]) domainGroup[domain] = [];\n\n  let block = `  ${enrichedPP}`;\n  if (entry['Description']) block += `\\n    Description: ${entry['Description']}`;\n  if (entry['Operational Signal']) block += `\\n    Operational Signal: ${entry['Operational Signal']}`;\n  if (entry['Emotional Signal']) block += `\\n    Emotional Signal: ${entry['Emotional Signal']}`;\n  if (entry['Sample User Expression']) block += `\\n    Sample Expression: ${entry['Sample User Expression']}`;\n\n  domainGroup[domain].push(block);\n}\n\nfor (const [domain, lines] of Object.entries(domainGroup)) {\n  painLines.push(domain + ':');\n  for (const line of lines) painLines.push(line);\n}\n\nconst pain_point_master_text = painLines.join('\\n\\n');\n\nconst inp = $('Step 5 - INIT 2 Emotion Dict Cache').first().json;\n\nreturn [{ json: {\n  ala_record_id: inp.ala_record_id,\n  ala_run_id: inp.ala_run_id,\n  prior_run_id: inp.prior_run_id,\n  lang: inp.lang,\n  client_id: inp.client_id,\n  raw_text: inp.raw_text,\n  clean_text: inp.clean_text,\n  star_rating: inp.star_rating,\n  platform: inp.platform,\n  review_date: inp.review_date,\n  ala_pain_domain: inp.ala_pain_domain,\n  ala_prelim_emotion: inp.ala_prelim_emotion,\n  ala_keywords: inp.ala_keywords,\n  reviewer_handle: inp.reviewer_handle,\n  emotion_dictionary_text: inp.emotion_dictionary_text,\n  pain_point_master_text: pain_point_master_text,\n  signal_weight_map: JSON.stringify(swMap),\n  dict_status: 'both_cached'\n} }];"
