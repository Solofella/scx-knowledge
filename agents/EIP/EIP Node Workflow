      "parameters": {
        "jsCode": "const inp = $input.first().json;\n\nconst fullSystemPrompt = inp.gpt_system_prompt +\n  '\\n\\nEMOTION DICTIONARY (use ONLY these canonical emotion names):\\n' +\n  (inp.emotion_dictionary_text || 'NOT LOADED') +\n  '\\n\\nPAIN POINT MASTER (use ONLY these exact domain and enriched pain point names):\\n' +\n  (inp.pain_point_master_text || 'NOT LOADED');\n\nconst body = JSON.stringify({\n  model: 'gpt-5.2',\n  temperature: 0.2,\n  max_completion_tokens: 600,\n  response_format: { type: 'json_object' },\n  messages: [\n    { role: 'system', content: fullSystemPrompt },\n    { role: 'user', content: inp.gpt_user_prompt }\n  ]\n});\n\nreturn [{ json: {\n  ala_record_id: inp.ala_record_id,\n  ala_run_id: inp.ala_run_id,\n  prior_run_id: inp.prior_run_id,\n  lang: inp.lang,\n  client_id: inp.client_id,\n  raw_text: inp.raw_text,\n  clean_text: inp.clean_text,\n  star_rating: inp.star_rating,\n  platform: inp.platform,\n  review_date: inp.review_date,\n  ala_pain_domain: inp.ala_pain_domain,\n  ala_prelim_emotion: inp.ala_prelim_emotion,\n  ala_keywords: inp.ala_keywords,\n  reviewer_handle: inp.reviewer_handle,\n  emotion_dictionary_text: inp.emotion_dictionary_text,\n  pain_point_master_text: inp.pain_point_master_text,\n  signal_weight_map: inp.signal_weight_map,\n  gpt_request_body: body\n} }];"
