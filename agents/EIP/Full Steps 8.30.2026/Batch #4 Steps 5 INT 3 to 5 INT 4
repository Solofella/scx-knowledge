xperience':     'Experiencia de reserva',\n  'Expectation vs. Reality':              'Expectativas frente a la realidad',\n  'Special Occasion & Personalization':   'Ocasiones especiales y personalización',\n  'Operational Failures':                 'Fallas operativas',\n  'Trust, Dignity & Belonging':           'Confianza, dignidad y pertenencia',\n  'Accessibility & Inclusion':            'Accesibilidad e inclusión',\n  'Safety & Security':                    'Seguridad y protección',\n  'Digital Experience & Technology':      'Experiencia digital y tecnología'\n};\n\nfunction normalizeDomain(rawDomain, reviewLang, clientLang) {\n  if (reviewLang === clientLang) return rawDomain;\n  if (reviewLang === 'es' && clientLang === 'en') {\n    return DOMAIN_MAP_ES_EN[rawDomain] || rawDomain;\n  }\n  if (reviewLang === 'en' && clientLang === 'es') {\n    return DOMAIN_MAP_EN_ES[rawDomain] || rawDomain;\n  }\n  return rawDomain;\n}\n\nconst painLines = [];\nconst domainGroup = {};\nconst swMap = {};\n\nif (lang === 'es') {\n  for (let i = 0; i < entries.length; i++) {\n    const entry = entries[i];\n    const rawDomain = entry['Dominio'] || 'Desconocido';\n    const domain = normalizeDomain(rawDomain, 'es', client_lang);\n    const enrichedPP = entry['Punto_Dolor_Enriquecido'] || '';\n    const sw = parseInt(entry['Peso_Señal']);\n    if (enrichedPP && !isNaN(sw)) swMap[enrichedPP] = sw;\n    if (!domainGroup[domain]) domainGroup[domain] = [];\n    let block = '  ' + enrichedPP;\n    if (entry['Descripcion']) block += '\\n    Descripción: ' + entry['Descripcion'];\n    if (entry['Señal_Operacional']) block += '\\n    Señal Operacional: ' + entry['Señal_Operacional'];\n    if (entry['Señal_Emocional']) block += '\\n    Señal Emocional: ' + entry['Señal_Emocional'];\n    if (entry['Ejemplo_Expresion_Usuario']) block += '\\n    Expresión de Ejemplo: ' + entry['Ejemplo_Expresion_Usuario'];\n    domainGroup[domain].push(block);\n  }\n} else {\n  for (let i = 0; i < entries.length; i++) {\n    const entry = entries[i];\n    const rawDomain = entry['Domain'] || 'Unknown';\n    const domain = normalizeDomain(rawDomain, 'en', client_lang);\n    const enrichedPP = entry['Enriched Pain Point'] || '';\n    const sw = parseInt(entry['Signal Weight']);\n    if (enrichedPP && !isNaN(sw)) swMap[enrichedPP] = sw;\n    if (!domainGroup[domain]) domainGroup[domain] = [];\n    let block = '  ' + enrichedPP;\n    if (entry['Description']) block += '\\n    Description: ' + entry['Description'];\n    if (entry['Operational Signal']) block += '\\n    Operational Signal: ' + entry['Operational Signal'];\n    if (entry['Emotional Signal']) block += '\\n    Emotional Signal: ' + entry['Emotional Signal'];\n    if (entry['Sample User Expression']) block += '\\n    Sample Expression: ' + entry['Sample User Expression'];\n    domainGroup[domain].push(block);\n  }\n}\n\nconst domainKeys = Object.keys(domainGroup);\nfor (let i = 0; i < domainKeys.length; i++) {\n  const domain = domainKeys[i];\n  painLines.push(domain + ':');\n  const lines = domainGroup[domain];\n  for (let j = 0; j < lines.length; j++) {\n    painLines.push(lines[j]);\n  }\n}\n\nconst pain_point_master_text = painLines.join('\\n\\n');\n\nreturn [{ json: {\n  ala_record_id:          inp.ala_record_id,\n  ala_run_id:             inp.ala_run_id,\n  prior_run_id:           inp.prior_run_id,\n  lang:                   inp.lang,\n  client_lang:            inp.client_lang,\n  client_id:              inp.client_id,\n  raw_text:               inp.raw_text,\n  clean_text:             inp.clean_text,\n  star_rating:            inp.star_rating,\n  platform:               inp.platform,\n  review_date:            inp.review_date,\n  ala_pain_domain:        inp.ala_pain_domain,\n  ala_prelim_emotion:     inp.ala_prelim_emotion,\n  ala_keywords:           inp.ala_keywords,\n  reviewer_handle:        inp.reviewer_handle,\n  emotion_dictionary_text: inp.emotion_dictionary_text,\n  pain_point_master_text: pain_poin