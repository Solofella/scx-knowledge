    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst raw = response.choices?.[0]?.message?.content;\nif (!raw) throw new Error('GPT returned empty response content.');\n\nlet parsed;\ntry { parsed = JSON.parse(raw); }\ncatch(e) { throw new Error('GPT invalid JSON: ' + raw.substring(0,300)); }\n\nif (!parsed.emotion || typeof parsed.emotion !== 'object') throw new Error('Missing emotion block.');\nif (!parsed.pain || typeof parsed.pain !== 'object') throw new Error('Missing pain block.');\n\nconst e = parsed.emotion;\nconst p = parsed.pain;\n\nconst reqEm = ['core_emotion','enriched_emotion_tag','emotion_category','intensity_level',\n               'dominant_pole','cognitive_driver','need_state','emotion_hypothesis'];\nfor (let i = 0; i < reqEm.length; i++) {\n  const f = reqEm[i];\n  if (!e[f] || typeof e[f] !== 'string') throw new Error('Emotion block missing: ' + f);\n}\n\nconst validIntensity = ['Low','Moderate','High','Critical'];\nif (!validIntensity.includes(e.intensity_level)) throw new Error('Invalid intensity_level: ' + e.intensity_level);\n\nconst validPole = ['Positive','Negative','Mixed'];\nif (!validPole.includes(e.dominant_pole)) throw new Error('Invalid dominant_pole: ' + e.dominant_pole);\n\nlet polarity = parseFloat(e.polarity_balance);\nif (isNaN(polarity)) polarity = 0.5;\npolarity = Math.min(1, Math.max(0, polarity));\n\nlet certainty = parseFloat(e.certainty_score);\nif (isNaN(certainty)) certainty = 0.50;\ncertainty = Math.min(1, Math.max(0, certainty));\n\nconst masked = (e.masked_emotion_flag === true || e.masked_emotion_flag === 'true' || e.masked_emotion_flag === 1);\n\nif (/[0-9\\[\\]\\{\\}]/.test(e.enriched_emotion_tag)) certainty = Math.min(certainty, 0.40);\n\nconst inp = $('Step 7 - Build GPT Request Body').first().json;\nconst recordLang = (inp.lang || 'en').toLowerCase().trim();\n\nif (recordLang !== 'es') {\n  const validDomains = ['Service Quality & Delivery','Trust, Dignity & Belonging',\n    'Operational Failures','Expectation vs. Reality','Special Occasion & Personalization',\n    'Staff Behavior & Interaction','Physical Environment & Ambiance','Booking & Reservation Experience',\n    'Food & Beverage Quality','Value & Pricing Perception','Accessibility & Inclusion',\n    'Safety & Security','Digital Experience & Technology'];\n  if (!validDomains.includes(p.pain_point_domain_confirmed))\n    throw new Error('Invalid pain domain: ' + p.pain_point_domain_confirmed);\n}\n\nconst reqPain = ['pain_point_sub_category','enriched_pain_point','pain_hypothesis'];\nfor (let i = 0; i < reqPain.length; i++) {\n  const f = reqPain[i];\n  if (!p[f] || typeof p[f] !== 'string') throw new Error('Pain block missing: ' + f);\n}\n\nconst swMap = JSON.parse(inp.signal_weight_map || '{}');\nconst signal_weight = swMap[p.pain_point_sub_category] || null;\n\nreturn [{ json: {\n  ala_record_id:              inp.ala_record_id,\n  ala_run_id:                 inp.ala_run_id,\n  prior_run_id:               inp.prior_run_id,\n  lang:                       inp.lang,\n  client_id:                  inp.client_id,\n  raw_text:                   inp.raw_text,\n  clean_text:                 inp.clean_text,\n  star_rating:                inp.star_rating,\n  platform:                   inp.platform,\n  review_date:                inp.review_date,\n  ala_pain_domain:            inp.ala_pain_domain,\n  ala_keywords:               inp.ala_keywords,\n  reviewer_handle:            inp.reviewer_handle,\n  emotion_dictionary_text:    inp.emotion_dictionary_text,\n  pain_point_master_text:     inp.pain_point_master_text,\n  signal_weight_map:          inp.signal_weight_map,\n  core_emotion:               e.core_emotion.trim(),\n  enriched_emotion_tag:       e.enriched_emotion_tag.trim(),\n  emotion_category:           e.emotion_category.trim(),\n  intensity_level:            e.intensity_level,\n  polarity_balance:           polarity,\n  dominant_pole:              e.dominant_pole,\n  certainty_score:            certainty,\n  masked_emotion_flag:        masked,\n  cognitive_driver:           e.cognitive_driver.trim(),\n  need_state:                 e.need_state.trim(),\n  emotion_hypothesis:         e.emotion_hypothesis.trim(),\n  pain_point_domain_confirmed: p.pain_point_domain_confirmed,\n  pain_point_sub_category:    p.pain_point_sub_category.trim(),\n  enriched_pain_point:        p.enriched_pain_point.trim(),\n  pain_hypothesis:            p.pain_hypothesis.trim(),\n  signal_weight:              signal_weight\n} }];"
