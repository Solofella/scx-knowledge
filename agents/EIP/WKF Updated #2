        "jsCode": "const emotionData = $input.first().json;\nconst emotions = emotionData.list || [];\nconst inp = $('Step 5 - Dictionary Load Check').first().json;\nconst lang = (inp.lang || 'en').toLowerCase().trim();\n\nif (emotions.length === 0) {\n  throw new Error('Emotion Dictionary returned empty. lang: ' + lang);\n}\n\nlet emotion_dictionary_text;\n\nif (lang === 'es') {\n  emotion_dictionary_text = emotions.map(function(e) {\n    let entry = (e['Emoción Central'] || '') + '\\n';\n    entry += '  Definición: ' + (e['Definición'] || '') + '\\n';\n    entry += '  Sinónimos: ' + (e['Sinónimos'] || '') + '\\n';\n    entry += '  Formas Enmascaradas: ' + (e['Formas Enmascaradas'] || '') + '\\n';\n    entry += '  Expresiones Comunes: ' + (e['Expresiones Comunes'] || '') + '\\n';\n    entry += '  Estado de Necesidad: ' + (e['Estado de Necesidad'] || '') + '\\n';\n    entry += '  Impulsor Cognitivo Negativo: ' + (e['Impulsor Cognitivo Negativo'] || '');\n    return entry;\n  }).join('\\n\\n');\n} else {\n  emotion_dictionary_text = emotions.map(function(e) {\n    let entry = (e['Core Emotion'] || '') + '\\n';\n    entry += '  Definition: ' + (e['Definition'] || '') + '\\n';\n    entry += '  Synonyms: ' + (e['Synonyms'] || '') + '\\n';\n    entry += '  Masked Forms: ' + (e['Masked Forms'] || '') + '\\n';\n    entry += '  Common Expressions: ' + (e['Common Expressions'] || '') + '\\n';\n    entry += '  Need State: ' + (e['Need_State'] || '') + '\\n';\n    entry += '  Negative Cognitive Driver: ' + (e['Negative Cognitive Driver'] || '');\n    if (e['Ambiguity Triggers']) {\n      entry += '\\n  Ambiguity Triggers: ' + e['Ambiguity Triggers'];\n    }\n    return entry;\n  }).join('\\n\\n');\n}\n\nreturn [{ json: {\n  ala_record_id:      inp.ala_record_id,\n  ala_run_id:         inp.ala_run_id,\n  prior_run_id:       inp.prior_run_id,\n  lang:               inp.lang,\n  client_id:          inp.client_id,\n  raw_text:           inp.raw_text,\n  clean_text:         inp.clean_text,\n  star_rating:        inp.star_rating,\n  platform:           inp.platform,\n  review_date:        inp.review_date,\n  ala_pain_domain:    inp.ala_pain_domain,\n  ala_prelim_emotion: inp.ala_prelim_emotion,\n  ala_keywords:       inp.ala_keywords,\n  reviewer_handle:    inp.reviewer_handle,\n  pain_table_id:      inp.pain_table_id,\n  emotion_dictionary_text: emotion_dictionary_text,\n  dict_status:        'emotion_cached'\n} }];"
