        "jsCode": "const record = $input.first().json.list?.[0];\n\nif (!record) {\n  throw new Error('ALA record not found for Id=' + \n    $('Step 1 - Payload Validation').first().json.ala_record_id);\n}\n\nconst required = ['Raw Tex', 'Platform', 'Date', 'Pain Point Domain', 'Preliminary Emotion Tag'];\nconst missing = required.filter(f => !record[f] || record[f].toString().trim() === '');\nif (missing.length > 0) {\n  throw new Error('ALA record missing required fields: ' + missing.join(', '));\n}\n\nconst cleanText = record['Raw Tex'].replace(/^[\\[\\d[\\u2605*]?\\]\\s*]*/,'').trim();\n\nreturn [{ json: {\n  ala_record_id: record.Id,\n  ala_run_id: record['Run ID'],\n  prior_run_id: $('Step 1 - Payload Validation').first().json.prior_run_id,\n  lang: $('Step 1 - Payload Validation').first().json.lang || record['lang'] || null,\n  client_id: $('Step 1 - Payload Validation').first().json.client_id || record['Client ID'] || null,\n  raw_text: record['Raw Tex'],\n  clean_text: cleanText,\n  star_rating: record['Star Rating'] || null,\n  platform: record['Platform'],\n  review_date: record['Date'],\n  ala_pain_domain: record['Pain Point Domain'],\n  ala_prelim_emotion: record['Preliminary Emotion Tag'],\n  ala_keywords: record['Keywords'],\n  reviewer_handle: record['Reviewer Handle']\n} }];"
