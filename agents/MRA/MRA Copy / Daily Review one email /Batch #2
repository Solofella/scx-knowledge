        "jsCode": "// Step 4a-NEW — Group Client Config rows by parent_account_id\nconst input = $input.first().json;\nconst records = input.list || [];\nif (records.length === 0) {\n  throw new Error('MRA: No Client Config found in database');\n}\n\nconst groups = {};\n\nfor (let i = 0; i < records.length; i++) {\n  const row = records[i];\n  const key = row['parent_account_id'] || row['Client ID'];\n\n  if (!groups[key]) {\n    const newGroup = {};\n    newGroup['parent_account_id'] = key;\n    newGroup['locations'] = [];\n    groups[key] = newGroup;\n  }\n\n  const locEntry = {};\n  locEntry['client_id'] = row['Client ID'];\n  locEntry['client_name'] = row['Client Name'];\n  locEntry['approval_email'] = row['Approval Contact Email'];\n  locEntry['sheet_id'] = row['Sheet ID'];\n  groups[key].locations.push(locEntry);\n}\n\nconst output = [];\nconst groupKeys = Object.keys(groups);\nfor (let i = 0; i < groupKeys.length; i++) {\n  const item = {};\n  item['json'] = groups[groupKeys[i]];\n  output.push(item);\n}\n\nreturn output;"
