const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const startDate = new Date(period_start);
const monthName = monthNames[startDate.getMonth()];
const yearName = startDate.getFullYear();

const total_signals = (s16.t_negative_count || 0) + (s16.t_ambiguous_count || 0) + (s16.t_positive_count || 0);
const neg_pct = total_signals > 0 ? Math.round(((s16.t_negative_count || 0) / total_signals) * 100) : 0;
const amb_pct = total_signals > 0 ? Math.round(((s16.t_ambiguous_count || 0) / total_signals) * 100) : 0;
const pos_pct = total_signals > 0 ? Math.round(((s16.t_positive_count || 0) / total_signals) * 100) : 0;

const email_subject = 'Monthly Pattern Report — ' + client_id_str + ' — ' + monthName + ' ' + yearName;

let summary_html = '';
summary_html += '<div class="metric-row"><span class="metric-label">Total reviews processed</span><span class="metric-value">' + (s16.total_records || 0) + '</span></div>';
summary_html += '<div class="metric-row"><span class="metric-label">Average star rating</span><span class="metric-value">' + (s16.avg_star_rating || 0) + ' ⭐</span></div>';
summary_html += '<div class="metric-row"><span class="metric-label">T-NEGATIVE</span><span class="metric-value" style="color: #C3643D; font-weight: 700;">' + (s16.t_negative_count || 0) + ' (' + neg_pct + '%)</span></div>';
summary_html += '<div class="metric-row"><span class="metric-label">T-AMBIGUOUS</span><span class="metric-value" style="color: #E9CFC9; font-weight: 700;">' + (s16.t_ambiguous_count || 0) + ' (' + amb_pct + '%)</span></div>';
summary_html += '<div class="metric-row"><span class="metric-label">T-POSITIVE</span><span class="metric-value" style="color: #64B8CE; font-weight: 700;">' + (s16.t_positive_count || 0) + ' (' + pos_pct + '%)</span></div>';

let domain_cards_html = '';
let domain_limit = top_domains.length > 5 ? 5 : top_domains.length;
for (let i = 0; i < domain_limit; i++) {
  let dom = top_domains[i];
  domain_cards_html += '<div class="domain-item"><span class="domain-name">' + (i + 1) + '. ' + dom.domain + '</span><span class="domain-count">' + dom.total + '</span></div>';
}

let platform_cards_html = '';
const platform_order = ['Google', 'OpenTable', 'Yelp', 'TripAdvisor'];
for (let i = 0; i < platform_order.length; i++) {
  let plat = platform_order[i];
  let count = platform_counts[plat] || 0;
  platform_cards_html += '<div class="platform-item"><div class="platform-name">' + plat + '</div><div class="platform-count">' + count + '</div></div>';
}

let alert_html = '';
if (t3_total > 0) {
  alert_html = '<div class="alert-box"><p class="alert-text">⚠️ ' + t3_total + ' dignity-risk event(s) this month — elevated reviews requiring special attention</p></div>';
}

let email_body = '<!DOCTYPE html><html><head><style>' + emailStyles + '</style></head><body>';
email_body += '<div class="container">';
email_body += '<div class="header"><h1>Monthly Pattern Report</h1><p>' + client_id_str + ' • ' + monthName + ' ' + yearName + '</p></div>';
email_body += '<div class="content">';

email_body += '<div class="section"><h2 class="section-title"><span class="emoji">📊</span>30-Day Signal Summary</h2>';
email_body += '<div class="metric-card">' + summary_html + '</div></div>';

if (domain_cards_html) {
  email_body += '<div class="section"><h2 class="section-title"><span class="emoji">🔍</span>Top 5 Pain Point Domains</h2>' + domain_cards_html + '</div>';
}

if (alert_html) {
  email_body += alert_html;
}

email_body += '<div class="section"><h2 class="section-title"><span class="emoji">📈</span>Platform Performance</h2>';
email_body += '<div class="platform-grid">' + platform_cards_html + '</div></div>';

email_body += '<div class="section"><h2 class="section-title"><span class="emoji">📊</span>Response Metrics</h2>';
email_body += '<div class="metric-card">';
email_body += '<div class="metric-row"><span class="metric-label">Total drafts generated</span><span class="metric-value">' + (s16.total_records || 0) + '</span></div>';
email_body += '<div class="metric-row"><span class="metric-label">Approved within 48hr SLA</span><span class="metric-value">' + (s16.sla_compliance_rate || 0) + '%</span></div>';
email_body += '<div class="metric-row"><span class="metric-label">Average approval time</span><span class="metric-value">' + (s16.seo_avg_velocity_hrs || 0) + ' hours</span></div>';
email_body += '</div></div>';

email_body += '<a href="' + dashboard_url + '" class="cta-button" style="color: #FFFFFF; text-decoration: none; border-bottom: none;">View Dashboard →</a>';

email_body += '</div>';
email_body += '<div class="footer">' +
  '<div style="margin-bottom: 12px; font-weight: 600; color: #2E304E; font-size: 13px;">VRYOH</div>' +
  '<div style="margin-bottom: 12px; font-size: 11px; color: #94A3B8;">Governed Review Responses & Guest Signal Intelligence</div>' +
  '<div class="footer-note" style="margin: 12px 0; padding: 12px; background-color: #F1F5F9; border-left: 3px solid #3A6B7E; border-radius: 4px; font-size: 11px;">' +
    '<strong>Governance:</strong> VRYOH detects and interprets signals only. It never prescribes operational actions. Your team applies operational judgment. We provide the intelligence you can\'t see in raw reviews.' +
  '</div>' +
  '<div style="margin-top: 12px; font-size: 10px; color: #94A3B8;">' +
    '<a href="https://vryoh.com" style="color: #3A6B7E; text-decoration: none;">vryoh.com</a> | ' +
    '<a href="https://vryoh.com/archive" style="color: #3A6B7E; text-decoration: none;">Archive</a><br/>' +
    '© 2026 VRYOH. All rights reserved.<br/>' +
    'This is an automated message. Please do not reply to this email.' +
  '</div>' +
'</div>';
email_body += '</div></body></html>';

const brevo_to = {};
brevo_to['email'] = s16.approval_email || 'miguel@solofella.com';
brevo_to['name'] = client_name;
const brevo_to_arr = [];
brevo_to_arr.push(brevo_to);

const brevo_sender = {};
brevo_sender['name'] = 'VRYOH Intelligence';
brevo_sender['email'] = 'intelligence@vryoh.com';

const brevo_obj = {};
brevo_obj['sender'] = brevo_sender;
brevo_obj['to'] = brevo_to_arr;
brevo_obj['subject'] = email_subject;
brevo_obj['htmlContent'] = email_body;

return [{ json: {
  mra_run_id: s16.mra_run_id,
  report_type: 'monthly',
  client_id: client_id_str,
  approval_email: s16.approval_email,
  nocodb_record_id: s16.nocodb_record_id || null,
  email_subject: email_subject,
  email_body: email_body,
  magic_token: magic_token,
  dashboard_url: dashboard_url,
  brevo_body: JSON.stringify(brevo_obj)
} }];
