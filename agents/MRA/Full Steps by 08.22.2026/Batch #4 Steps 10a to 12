        "jsCode": "const s11 = $('Step 11 - Process SIA and SEO').first().json;\n\nconst now = new Date();\nconst expires = new Date(now.getTime() + 72 * 3600000);\n\nconst ey = expires.getFullYear();\nconst em = expires.getMonth() + 1;\nconst ed = expires.getDate();\nconst eh = expires.getHours();\nconst emin = expires.getMinutes();\nconst esec = expires.getSeconds();\nconst exp_str = ey + '-' + (em < 10 ? '0' + em : '' + em) + '-' + (ed < 10 ? '0' + ed : '' + ed) + 'T' + (eh < 10 ? '0' + eh : '' + eh) + ':' + (emin < 10 ? '0' + emin : '' + emin) + ':' + (esec < 10 ? '0' + esec : '' + esec) + '.000Z';\n\nconst hex_chars = '0123456789abcdef';\nlet tok_a = '';\nlet tok_b = '';\nlet tok_c = '';\nlet tok_d = '';\nlet tok_e = '';\nfor (let i = 0; i < 8; i++) { tok_a += hex_chars[Math.floor(Math.random() * 16)]; }\nfor (let i = 0; i < 4; i++) { tok_b += hex_chars[Math.floor(Math.random() * 16)]; }\nfor (let i = 0; i < 3; i++) { tok_c += hex_chars[Math.floor(Math.random() * 16)]; }\nfor (let i = 0; i < 3; i++) { tok_d += hex_chars[Math.floor(Math.random() * 16)]; }\nfor (let i = 0; i < 12; i++) { tok_e += hex_chars[Math.floor(Math.random() * 16)]; }\nconst magic_token = tok_a + '-' + tok_b + '-4' + tok_c + '-a' + tok_d + '-' + tok_e;\n\nconst top_domains_json = JSON.stringify(s11.top_domains);\nconst tier_breakdown_json = JSON.stringify(s11.tier_breakdown);\nconst trend_signals_json = JSON.stringify(s11.trend_signals);\nconst platform_counts_json = JSON.stringify(s11.platform_counts);\n\nconst record = {};\nrecord['MRA Run ID'] = s11.mra_run_id;\nrecord['Report Type'] = s11.report_type;\nrecord['Client ID'] = s11.client_id;\nrecord['Period Start'] = s11.period_start;\nrecord['Period End'] = s11.period_end;\nrecord['Total Records'] = s11.total_records;\nrecord['Avg Star Rating'] = s11.avg_star_rating;\nrecord['SLA Compliance Rate'] = s11.sla_compliance_rate;\nrecord['T Negative Count'] = s11.t_negative_count;\nrecord['T Ambiguous Count'] = s11.t_ambiguous_count;\nrecord['T Positive Count'] = s11.t_positive_count;\nrecord['Top Domains JSON'] = top_domains_json;\nrecord['Tier Breakdown JSON'] = tier_breakdown_json;\nrecord['Trend Signals JSON'] = trend_signals_json;\nrecord['SEO Keyword Hits'] = s11.seo_keyword_hits;\nrecord['SEO Top Keyword'] = s11.seo_top_keyword;\nrecord['SEO Coverage Rate'] = s11.seo_coverage_rate;\nrecord['SEO Response Rate'] = s11.seo_response_rate;\nrecord['SEO Avg Velocity Hrs'] = s11.seo_avg_velocity_hrs;\nrecord['Platform Counts JSON'] = platform_counts_json;\nrecord['Magic Link Token'] = magic_token;\nrecord['Token Expires At'] = exp_str;\nrecord['Error Log'] = '';\n\nreturn [{ json: {\n  mra_run_id: s11.mra_run_id,\n  report_type: s11.report_type,\n  client_id: s11.client_id,\n  client_name: s11.client_name,\n  approval_email: s11.approval_email,\n  sheet_id: s11.sheet_id,\n  parent_account_id: s11.parent_account_id,\n  period_start: s11.period_start,\n  period_end: s11.period_end,\n  run_timestamp: s11.run_timestamp,\n  magic_token: magic_token,\n  token_expires_at: exp_str,\n  total_records: s11.total_records,\n  avg_star_rating: s11.avg_star_rating,\n  platform_counts: s11.platform_counts,\n  sla_compliance_rate: s11.sla_compliance_rate,\n  t_negative_count: s11.t_negative_count,\n  t_ambiguous_count: s11.t_ambiguous_count,\n  t_positive_count: s11.t_positive_count,\n  top_domains: s11.top_domains,\n  tier_breakdown: s11.tier_breakdown,\n  trend_signals: s11.trend_signals,\n  seo_keyword_hits: s11.seo_keyword_hits,\n  seo_top_keyword: s11.seo_top_keyword,\n  seo_coverage_rate: s11.seo_coverage_rate,\n  seo_response_rate: s11.seo_response_rate,\n  seo_avg_velocity_hrs: s11.seo_avg_velocity_hrs,\n  all_time_pending: s11.all_time_pending,\n  nocodb_body: JSON.stringify(record)\n} }];"
