      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst s9 = $('Step 10a - Build SIA Query URL').first().json;\nconst s10c = $('Step 10c - Fetch ESS Records').first().json;\nconst s10d = $('Step 10d - Fetch EIP Records').first().json;\n\nconst report_type = s9.report_type || 'weekly';\n\nlet t_negative_count = 0;\nlet t_ambiguous_count = 0;\nlet t_positive_count = 0;\nconst domain_map = {};\nlet trend_signals_top5 = [];\n\nif (report_type === 'daily') {\n  const eip_records = s10d.list || [];\n  const filtered_ids = s9.filtered_ala_record_ids || [];\n  \n  // Build lookup set for fast filtering\n  const id_set = {};\n  for (let i = 0; i < filtered_ids.length; i++) {\n    id_set[String(filtered_ids[i])] = true;\n  }\n  \n  for (let i = 0; i < eip_records.length; i++) {\n    let rec = eip_records[i];\n    let ala_id = String(rec['ALA Record ID'] || '');\n    \n    // CRITICAL: Only process records in the daily window\n    if (!id_set[ala_id]) {\n      continue;\n    }\n    \n    let signal_type = (rec['Signal Type'] || '').trim();\n    let domain = (rec['Domain'] || '').trim();\n    \n    if (!domain || domain === '') {\n      domain = 'Unknown';\n    }\n    \n    if (signal_type === 'Positive Signal') {\n      t_positive_count++;\n    } else if (signal_type === 'Negative Signal') {\n      t_negative_count++;\n    } else if (signal_type === 'Mixed Signal' || signal_type === 'Ambiguous Signal') {\n      t_ambiguous_count++;\n    }\n    \n    if (!domain_map[domain]) {\n      domain_map[domain] = {\n        domain: domain,\n        neg: 0,\n        amb: 0,\n        pos: 0,\n        total: 0\n      };\n    }\n    \n    if (signal_type === 'Positive Signal') {\n      domain_map[domain].pos++;\n    } else if (signal_type === 'Negative Signal') {\n      domain_map[domain].neg++;\n    } else if (signal_type === 'Mixed Signal' || signal_type === 'Ambiguous Signal') {\n      domain_map[domain].amb++;\n    }\n    \n    domain_map[domain].total++;\n  }\n  \n  trend_signals_top5 = [];\n\n} else {\n  const sia_input = $('Step 10b - Fetch SIA Clusters').first().json;\n  const allClusters = sia_input.list || [];\n  const latestRunTs = allClusters.length > 0 ? allClusters[0]['Run Timestamp'] : null;\n  \n  const clusters = [];\n  for (let i = 0; i < allClusters.length; i++) {\n    if (allClusters[i]['Run Timestamp'] === latestRunTs) {\n      clusters.push(allClusters[i]);\n    }\n  }\n  \n  for (let i = 0; i < clusters.length; i++) {\n    let cl = clusters[i];\n    let tier = (cl['Signal Tier'] || '').trim();\n    let domain = (cl['Domain'] || '').trim();\n    \n    if (!domain || domain === '') {\n      domain = 'Unknown';\n    }\n    \n    let n = parseInt(cl['N'] || 0);\n    \n    if (tier === 'T-NEGATIVE') t_negative_count += n;\n    else if (tier === 'T-AMBIGUOUS') t_ambiguous_count += n;\n    else if (tier === 'T-POSITIVE') t_positive_count += n;\n    \n    if (!domain_map[domain]) {\n      domain_map[domain] = {\n        domain: domain,\n        neg: 0,\n        amb: 0,\n        pos: 0,\n        total: 0\n      };\n    }\n    \n    if (tier === 'T-NEGATIVE') {\n      domain_map[domain].neg += n;\n    } else if (tier === 'T-AMBIGUOUS') {\n      domain_map[domain].amb += n;\n    } else if (tier === 'T-POSITIVE') {\n      domain_map[domain].pos += n;\n    }\n    \n    domain_map[domain].total += n;\n  }\n  \n  const trend_signals = [];\n  for (let i = 0; i < clusters.length; i++) {\n    let cl = clusters[i];\n    let is_singleton = cl['Is Singleton'] === true || cl['Is Singleton'] === 1;\n    if (!is_singleton) {\n      let ts = {};\n      ts.domain = (cl['Domain'] || '').trim();\n      ts.tier = (cl['Signal Tier'] || '').trim();\n      ts.n = parseInt(cl['N'] || 0);\n      let prior_n_val = null;\n      if (cl['Prior N'] !== null && cl['Prior N'] !== undefined) {\n        prior_n_val = parseInt(cl['Prior N']);\n      }\n      ts.prior_n = prior_n_val;\n      ts.trend_direction = (cl['Trend Direction'] || '').trim();\n      ts.percentage = parseFloat(cl['Percentage'] || 0);\n      trend_signals.push(ts);\n    }\n  }\n  \n  const tierOrder = {};\n  tierOrder['T-NEGATIVE'] = 0;\n  tierOrder['T-AMBIGUOUS'] = 1;\n  tierOrder['T-POSITIVE'] = 2;\n  \n  let sort_tmp;\n  for (let i = 0; i < trend_signals.length - 1; i++) {\n    for (let j = i + 1; j < trend_signals.length; j++) {\n      let ta = tierOrder[trend_signals[i].tier] !== undefined ? tierOrder[trend_signals[i].tier] : 3;\n      let tb = tierOrder[trend_signals[j].tier] !== undefined ? tierOrder[trend_signals[j].tier] : 3;\n      let do_swap = false;\n      if (tb < ta) do_swap = true;\n      else if (tb === ta && trend_signals[j].n > trend_signals[i].n) do_swap = true;\n      if (do_swap) {\n        sort_tmp = trend_signals[i];\n        trend_signals[i] = trend_signals[j];\n        trend_signals[j] = sort_tmp;\n      }\n    }\n  }\n  \n  for (let i = 0; i < trend_signals.length && i < 5; i++) {\n    trend_signals_top5.push(trend_signals[i]);\n  }\n}\n\nconst domain_keys = Object.keys(domain_map);\nconst top_domains = [];\nfor (let i = 0; i < domain_keys.length; i++) {\n  top_domains.push(domain_map[domain_keys[i]]);\n}\n\nlet swap_tmp;\nfor (let i = 0; i < top_domains.length - 1; i++) {\n  for (let j = i + 1; j < top_domains.length; j++) {\n    if (top_domains[j].total > top_domains[i].total) {\n      swap_tmp = top_domains[i];\n      top_domains[i] = top_domains[j];\n      top_domains[j] = swap_tmp;\n    }\n  }\n}\n\nconst seo_keywords = s9.seo_keywords || [];\nconst published_drafts = s9.published_drafts || [];\n\nconst keyword_hits = {};\nfor (let i = 0; i < seo_keywords.length; i++) {\n  keyword_hits[seo_keywords[i]] = 0;\n}\n\nfor (let i = 0; i < published_drafts.length; i++) {\n  let text = published_drafts[i].draft_text || '';\n  for (let j = 0; j < seo_keywords.length; j++) {\n    if (text.includes(seo_keywords[j])) {\n      keyword_hits[seo_keywords[j]]++;\n    }\n  }\n}\n\nlet seo_top_keyword = '';\nlet seo_top_count = 0;\n\nconst kw_keys = Object.keys(keyword_hits);\nfor (let i = 0; i < kw_keys.length; i++) {\n  let kw = kw_keys[i];\n  let count = keyword_hits[kw];\n  if (count > seo_top_count) {\n    seo_top_count = count;\n    seo_top_keyword = kw;\n  }\n}\n\nconst total_published = s9.published_count || 0;\nlet drafts_with_keyword = 0;\nfor (let i = 0; i < published_drafts.length; i++) {\n  let text = published_drafts[i].draft_text || '';\n  let found = false;\n  for (let j = 0; j < seo_keywords.length; j++) {\n    if (text.includes(seo_keywords[j])) {\n      found = true;\n    }\n  }\n  if (found) {\n    drafts_with_keyword++;\n  }\n}\n\nconst seo_coverage_rate = total_published > 0 ? Math.round((drafts_with_keyword / total_published) * 10000) / 100 : 0;\n\nconst ess_records = s10c.list || [];\nconst filtered_ala_ids = s9.filtered_ala_record_ids || [];\n\nconst ess_map = {};\nfor (let i = 0; i < ess_records.length; i++) {\n  let alaId = String(ess_records[i]['ALA Record ID'] || '');\n  let expr = (ess_records[i]['Expression Mode'] || 'Absent').trim();\n  ess_map[alaId] = expr;\n}\n\nconst expression_modes = {\n  'Explicit': 0,\n  'Implicit': 0,\n  'Masked': 0,\n  'Performative': 0,\n  'Conflicted': 0,\n  'Absent': 0\n};\n\nfor (let i = 0; i < filtered_ala_ids.length; i++) {\n  let alaId = filtered_ala_ids[i];\n  if (ess_map[alaId]) {\n    let expr = ess_map[alaId];\n    if (expression_modes.hasOwnProperty(expr)) {\n      expression_modes[expr]++;\n    }\n  } else {\n    expression_modes['Absent']++;\n  }\n}\n\nreturn [{ json: {\n  mra_run_id: s9.mra_run_id,\n  report_type: s9.report_type,\n  period_start: s9.period_start,\n  period_end: s9.period_end,\n  window_days: s9.window_days,\n  run_timestamp: s9.run_timestamp,\n  client_id: s9.client_id,\n  client_name: s9.client_name,\n  approval_email: s9.approval_email,\n  seo_keywords: s9.seo_keywords,\n  sheet_id: s9.sheet_id,\n  parent_account_id: s9.parent_account_id,\n  total_records: s9.total_records,\n  avg_star_rating: s9.avg_star_rating,\n  platform_counts: s9.platform_counts,\n  sla_compliance_rate: s9.sla_compliance_rate,\n  seo_avg_velocity_hrs: s9.seo_avg_velocity_hrs,\n  seo_response_rate: s9.seo_response_rate,\n  tier_breakdown: s9.tier_breakdown,\n  published_count: s9.published_count,\n  all_time_pending: s9.all_time_pending,\n  t_negative_count: t_negative_count,\n  t_ambiguous_count: t_ambiguous_count,\n  t_positive_count: t_positive_count,\n  top_domains: top_domains,\n  trend_signals: trend_signals_top5,\n  seo_keyword_hits: drafts_with_keyword,\n  seo_top_keyword: seo_top_keyword,\n  seo_coverage_rate: seo_coverage_rate,\n  expression_modes: expression_modes\n} }];"
