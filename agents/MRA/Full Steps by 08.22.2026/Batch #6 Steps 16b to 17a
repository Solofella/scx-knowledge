        "jsCode": "let all4c = [];\ntry {\n  all4c = $('Step 4c - Explode Locations for Account').all().map(function(item) { return item.json; });\n} catch (e) {\n  return [{ json: { error: '4c failed: ' + e.message } }];\n}\n\nlet allLoopResults = [];\ntry {\n  allLoopResults = $('Step 4d - Split Locations for Processing').all().map(function(item) { return item.json; });\n} catch (e) {\n  return [{ json: { error: '4d failed: ' + e.message } }];\n}\n\nconst currentAccountId = all4c.length > 0 ? all4c[all4c.length - 1].parent_account_id : null;\n\nconst expectedClientIds = {};\nfor (let i = 0; i < all4c.length; i++) {\n  if (all4c[i].parent_account_id === currentAccountId) {\n    expectedClientIds[all4c[i].client_id] = true;\n  }\n}\n\nconst locationResults = [];\nfor (let i = 0; i < allLoopResults.length; i++) {\n  const item = allLoopResults[i];\n  if (expectedClientIds[item.client_id]) {\n    locationResults.push(item);\n  }\n}\n\nlet total_reviews = 0;\nlet weighted_rating_sum = 0;\nlet total_drafts = 0;\nlet total_pending = 0;\n\nfor (let i = 0; i < locationResults.length; i++) {\n  const loc = locationResults[i];\n  const reviewCount = loc.total_records || 0;\n  const avgRating = loc.avg_star_rating || 0;\n  total_reviews += reviewCount;\n  weighted_rating_sum += avgRating * reviewCount;\n  total_pending += loc.all_time_pending || 0;\n  total_drafts += (loc.t_negative_count || 0) + (loc.t_ambiguous_count || 0) + (loc.t_positive_count || 0);\n}\n\nlet blended_avg_rating = 0;\nif (total_reviews > 0) {\n  blended_avg_rating = weighted_rating_sum / total_reviews;\n} else if (locationResults.length > 0) {\n  blended_avg_rating = locationResults[0].avg_star_rating || 0;\n}\nblended_avg_rating = Math.round(blended_avg_rating * 10) / 10;\n\nconst result = {};\nresult['parent_account_id'] = currentAccountId;\nresult['total_reviews_24h'] = total_reviews;\nresult['blended_avg_rating'] = blended_avg_rating;\nresult['total_drafts_generated_24h'] = total_drafts;\nresult['total_pending_all_locations'] = total_pending;\nresult['locations'] = locationResults;\n\nreturn [{ json: result }];"
