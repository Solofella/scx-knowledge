let email_subject = '';
let email_body = '';

// ========== DAILY REPORT ==========
if (report_type === 'daily') {
  email_subject = '48-Hour Draft Summary — ' + client_id_str + ' — ' + period_end;
  
  let platform_cards_html = '';
  const platform_order = ['Google', 'OpenTable', 'Yelp', 'TripAdvisor'];
