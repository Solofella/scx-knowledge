  email_body += '<div class="metric-label">Draft(s) awaiting your review (all time)</div></div>';
  email_body += '<a href="https://docs.google.com/spreadsheets/d/1JT0jt_l4NthR2n3Eu0-DUcWkhsMLV6mKaVJ5FFgIU6w" class="cta-button" style="color: #F6F6F6; text-decoration: none; border-bottom: none;">View & Approve Drafts →</a></div>';
  
  email_body += '</div>';
  email_body += '<div class="footer"><div class="footer-note">SubtextCX detects and interprets signals only.<br>Operational decisions remain with your team.</div></div>';
  email_body += '</div></body></html>';
}

// ========== WEEKLY REPORT ==========
if (report_type === 'weekly') {
  email_subject = 'Weekly Intelligence Brief — ' + client_id_str + ' — Week of ' + period_start;
  
  const total_signals = (p.t_negative_count || 0) + (p.t_ambiguous_count || 0) + (p.t_positive_count || 0);
  
  let signal_bars_html = '';
  signal_bars_html += '<div class="metric-row"><span class="metric-label">T-NEGATIVE</span><span class="metric-value" style="color: #ae4900; font-weight: 700;">' + (p.t_negative_count || 0) + ' signal(s)</span></div>';
  signal_bars_html += '<div class="metric-row"><span class="metric-label">T-AMBIGUOUS</span><span class="metric-value" style="color: #c05621; font-weight: 700;">' + (p.t_ambiguous_count || 0) + ' signal(s)</span></div>';
  signal_bars_html += '<div class="metric-row"><span class="metric-label">T-POSITIVE</span><span class="metric-value" style="color: #475a28; font-weight: 700;">' + (p.t_positive_count || 0) + ' signal(s)</span></div>';
  
  let domain_cards_html = '';
  let domain_limit = top_domains.length > 5 ? 5 : top_domains.length;
  for (let i = 0; i < domain_limit; i++) {
    let dom = top_domains[i];
    domain_cards_html += '<div class="domain-item"><span class="domain-name">' + dom.domain + '</span><span class="domain-count">' + dom.total + '</span></div>';
  }
  
  let trend_cards_html = '';
  for (let i = 0; i < trend_signals.length; i++) {
    let ts = trend_signals[i];
    let badge_class = 'trend-ambiguous';
    if (ts.tier === 'T-NEGATIVE') badge_class = 'trend-negative';
    else if (ts.tier === 'T-POSITIVE') badge_class = 'trend-positive';
    
    let prior_str = 'new';
    if (ts.prior_n !== null && ts.prior_n !== undefined) {
      let arrow = '→';
      if (ts.trend_direction === 'UP') arrow = '↑';
      else if (ts.trend_direction === 'DOWN') arrow = '↓';
      prior_str = arrow + ' from ' + ts.prior_n;
    }
    
    trend_cards_html += '<div class="trend-item"><span class="trend-badge ' + badge_class + '">' + ts.tier + '</span><span style="flex: 1; color: #111111;">' + ts.domain + ' — <strong>' + ts.n + '</strong> signal(s) <em style="color: #A8A9AD;">(' + prior_str + ')</em></span></div>';
  }
  
  let platform_cards_html = '';
  const platform_order = ['Google', 'OpenTable', 'Yelp', 'TripAdvisor'];
  for (let i = 0; i < platform_order.length; i++) {
    let plat = platform_order[i];
    let count = platform_counts[plat] || 0;
    platform_cards_html += '<div class="platform-item"><div class="platform-name">' + plat + '</div><div class="platform-count">' + count + '</div></div>';
  }
  
  let alert_html = '';
  if (t3_total > 0) {
    alert_html = '<div class="alert-box"><p class="alert-text">⚠️ ' + t3_total + ' dignity-risk event(s) this week — elevated reviews requiring special attention</p></div>';
  }
  
  email_body = '<!DOCTYPE html><html><head><style>' + emailStyles + '</style></head><body>';
  email_body += '<div class="container">';
  email_body += '<div class="header"><h1>Weekly Intelligence Brief</h1><p>' + client_id_str + ' • ' + period_start + ' – ' + period_end + '</p></div>';
  email_body += '<div class="content">';
  
  email_body += '<div class="section"><h2 class="section-title"><span class="emoji">📊</span>Signal Distribution</h2>';
  email_body += '<div class="metric-card">' + signal_bars_html;
  email_body += '<hr class="divider"><div class="metric-row"><span class="metric-label" style="font-weight: 600; color: #111111;">Total signals</span><span class="metric-value" style="font-size: 18px; color: #002D72;">' + total_signals + '</span></div>';
  email_body += '</div></div>';
  
  if (domain_cards_html) {
    email_body += '<div class="section"><h2 class="section-title"><span class="emoji">🔍</span>Top Pain Point Domains</h2>' + domain_cards_html + '</div>';
  }
  
  if (alert_html) {
    email_body += alert_html;
  }
  
  email_body += '<div class="section"><h2 class="section-title"><span class="emoji">📈</span>Platform Breakdown</h2>';
  email_body += '<div class="platform-grid">' + platform_cards_html + '</div></div>';
  
  email_body += '<div class="section"><h2 class="section-title"><span class="emoji">📊</span>Performance Metrics</h2>';
  email_body += '<div class="metric-card">';
  email_body += '<div class="metric-row"><span class="metric-label">Average Star Rating</span><span class="metric-value">' + (p.avg_star_rating || 0) + ' ⭐</span></div>';
  email_body += '<div class="metric-row"><span class="metric-label">SLA Compliance Rate</span><span class="metric-value">' + (p.sla_compliance_rate || 0) + '%</span></div>';
  email_body += '</div></div>';
  
  if (trend_cards_html) {
    email_body += '<div class="section"><h2 class="section-title"><span class="emoji">🔍</span>Trend Signals</h2>' + trend_cards_html + '</div>';
  }
  
  email_body += '<div class="section"><h2 class="section-title"><span class="emoji">📊</span>SEO Performance</h2>';
  email_body += '<div class="metric-card">';
  email_body += '<div class="metric-row"><span class="metric-label">Drafts with keyword placed</span><span class="metric-value">' + (p.seo_keyword_hits || 0) + '</span></div>';
  email_body += '<div class="metric-row"><span class="metric-label">Top keyword</span><span class="metric-value">' + (p.seo_top_keyword || 'none') + '</span></div>';
  email_body += '<div class="metric-row"><span class="metric-label">Coverage rate</span><span class="metric-value">' + (p.seo_coverage_rate || 0) + '%</span></div>';
  email_body += '<div class="metric-row"><span class="metric-label">Response velocity</span><span class="metric-value">' + (p.seo_avg_velocity_hrs || 0) + ' hrs avg</span></div>';
  email_body += '</div></div>';
  
  email_body += '<a href="' + dashboard_url + '" class="cta-button" style="color: #F6F6F6; text-decoration: none; border-bottom: none; ">View Dashboard →</a>';
  
  email_body += '</div>';
  email_body += '<div class="footer"><div class="footer-note">SubtextCX detects and interprets signals only.<br>Operational decisions remain with your team.</div></div>';
  email_body += '</div></body></html>';
}

// ========== MONTHLY REPORT ==========
if (report_type === 'monthly') {
  const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const startDate = new Date(period_start);
  const monthName = monthNames[startDate.getMonth()];
  const yearName = startDate.getFullYear();
  
  const total_signals = (p.t_negative_count || 0) + (p.t_ambiguous_count || 0) + (p.t_positive_count || 0);
  const neg_pct = total_signals > 0 ? Math.round(((p.t_negative_count || 0) / total_signals) * 100) : 0;
  const amb_pct = total_signals > 0 ? Math.round(((p.t_ambiguous_count || 0) / total_signals) * 100) : 0;
  const pos_pct = total_signals > 0 ? Math.round(((p.t_positive_count || 0) / total_signals) * 100) : 0;
  
  email_subject = 'Monthly Pattern Report — ' + client_id_str + ' — ' + monthName + ' ' + yearName;
  
  let summary_html = '';
  summary_html += '<div class="metric-row"><span class="metric-label">Total reviews processed</span><span class="metric-value">' + (p.total_records || 0) + '</span></div>';
  summary_html += '<div class="metric-row"><span class="metric-label">Average star rating</span><span class="metric-value">' + (p.avg_star_rating || 0) + ' ⭐</span></div>';
  summary_html += '<div class="metric-row"><span class="metric-label">T-NEGATIVE</span><span class="metric-value" style="color: #ae4900; font-weight: 700;">' + (p.t_negative_count || 0) + ' (' + neg_pct + '%)</span></div>';
  summary_html += '<div class="metric-row"><span class="metric-label">T-AMBIGUOUS</span><span class="metric-value" style="color: #c05621; font-weight: 700;">' + (p.t_ambiguous_count || 0) + ' (' + amb_pct + '%)</span></div>';
  summary_html += '<div class="metric-row"><span class="metric-label">T-POSITIVE</span><span class="metric-value" style="color: #475a28; font-weight: 700;">' + (p.t_positive_count || 0) + ' (' + pos_pct + '%)</span></div>';
  
  let domain_cards_html = '';
  let domain_limit = top_domains.length > 5 ? 5 : top_domains.length;
  for (let i = 0; i < domain_limit; i++) {
    let dom = top_domains[i];
    domain_cards_html += '<div class="domain-item"><span class="domain-name">' + (i + 1) + '. ' + dom.domain + '</span><span class="domain-count">' + dom.total + '</span></div>';
  }
  
  let platform_cards_html = '';
  const platform_order = ['Google', 'OpenTable', 'Yelp', 'TripAdvisor'];
  for (let i = 0; i < platform_order.length; i++) {
    let plat = platform_order[i];
    let count = platform_counts[plat] || 0;
    platform_cards_html += '<div class="platform-item"><div class="platform-name">' + plat + '</div><div class="platform-count">' + count + '</div></div>';
  }
  
  let alert_html = '';
  if (t3_total > 0) {
    alert_html = '<div class="alert-box"><p class="alert-text">⚠️ ' + t3_total + ' dignity-risk event(s) this month — elevated reviews requiring special attention</p></div>';
  }
  
  email_body = '<!DOCTYPE html><html><head><style>' + emailStyles + '</style></head><body>';
  email_body += '<div class="container">';
  email_body += '<div class="header"><h1>Monthly Pattern Report</h1><p>' + client_id_str + ' • ' + monthName + ' ' + yearName + '</p></div>';
  email_body += '<div class="content">';
  
  email_body += '<div class="section"><h2 class="section-title"><span class="emoji">📊</span>30-Day Signal Summary</h2>';
  email_body += '<div class="metric-card">' + summary_html + '</div></div>';
  
  if (domain_cards_html) {
    email_body += '<div class="section"><h2 class="section-title"><span class="emoji">🔍</span>Top 5 Pain Point Domains</h2>' + domain_cards_html + '</div>';
  }
  
  if (alert_html) {
    email_body += alert_html;
  }
  
  email_body += '<div class="section"><h2 class="section-title"><span class="emoji">📈</span>Platform Performance</h2>';
  email_body += '<div class="platform-grid">' + platform_cards_html + '</div></div>';
  
  email_body += '<div class="section"><h2 class="section-title"><span class="emoji">📊</span>Response Metrics</h2>';
  email_body += '<div class="metric-card">';
  email_body += '<div class="metric-row"><span class="metric-label">Total drafts generated</span><span class="metric-value">' + (p.total_records || 0) + '</span></div>';
  email_body += '<div class="metric-row"><span class="metric-label">Approved within 48hr SLA</span><span class="metric-value">' + (p.sla_compliance_rate || 0) + '%</span></div>';
  email_body += '<div class="metric-row"><span class="metric-label">Average approval time</span><span class="metric-value">' + (p.seo_avg_velocity_hrs || 0) + ' hours</span></div>';
  email_body += '</div></div>';
  
  email_body += '<a href="' + dashboard_url + '" class="cta-button" style="color: #F6F6F6; text-decoration: none; border-bottom: none; ">View Dashboard →</a>';
  
  email_body += '</div>';
  email_body += '<div class="footer"><div class="footer-note">SubtextCX detects and interprets signals only.<br>Operational decisions remain with your team.</div></div>';
  email_body += '</div></body></html>';
}

const brevo_to = {};
brevo_to['email'] = p.approval_email || 'miguel@solofella.com';
brevo_to['name'] = client_name;
const brevo_to_arr = [];
brevo_to_arr.push(brevo_to);

const brevo_sender = {};
brevo_sender['name'] = 'SubtextCX Reports';
brevo_sender['email'] = 'marellano@solofella.com';

const brevo_obj = {};
brevo_obj['sender'] = brevo_sender;
brevo_obj['to'] = brevo_to_arr;
brevo_obj['subject'] = email_subject;
brevo_obj['htmlContent'] = email_body;

return [{ json: {
  mra_run_id: p.mra_run_id,
  report_type: report_type,
  client_id: client_id_str,
  approval_email: p.approval_email,
  nocodb_record_id: p.nocodb_record_id || null,
  email_subject: email_subject,
  email_body: email_body,
  magic_token: magic_token,
  dashboard_url: dashboard_url,
  brevo_body: JSON.stringify(brevo_obj)
} }];
