    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst s7 = $('Step 7 - Filter ALA by Window').first().json;\n\nconst allRecords = input.list || [];\nconst ala_records = s7.ala_records || [];\n\nconst ala_id_set = {};\nfor (let i = 0; i < ala_records.length; i++) {\n  ala_id_set[String(ala_records[i]['Id'])] = true;\n}\n\nconst records = [];\nfor (let i = 0; i < allRecords.length; i++) {\n  let rec = allRecords[i];\n  let ala_id = String(rec['ALA Record ID'] || '');\n  if (ala_id_set[ala_id]) {\n    records.push(rec);\n  }\n}\n\nconst total_rda = records.length;\n\nlet approved_count = 0;\nlet published_count = 0;\nlet sla_compliant = 0;\nlet velocity_sum = 0;\nlet velocity_count = 0;\n\nconst tier_map = {};\ntier_map['T1'] = {};\ntier_map['T1'].total = 0;\ntier_map['T1'].approved = 0;\ntier_map['T1'].pending = 0;\ntier_map['T1'].velocity_sum = 0;\ntier_map['T1'].velocity_count = 0;\ntier_map['T2'] = {};\ntier_map['T2'].total = 0;\ntier_map['T2'].approved = 0;\ntier_map['T2'].pending = 0;\ntier_map['T2'].velocity_sum = 0;\ntier_map['T2'].velocity_count = 0;\ntier_map['T3'] = {};\ntier_map['T3'].total = 0;\ntier_map['T3'].approved = 0;\ntier_map['T3'].pending = 0;\ntier_map['T3'].velocity_sum = 0;\ntier_map['T3'].velocity_count = 0;\n\nconst published_drafts = [];\n\nfor (let i = 0; i < records.length; i++) {\n  let rec = records[i];\n  let status = (rec['Approval Status'] || '').trim();\n  let tier_raw = (rec['Confirmed Response Tier'] || '').trim();\n  let tier = null;\n  if (tier_raw.indexOf('T1') === 0) tier = 'T1';\n  else if (tier_raw.indexOf('T2') === 0) tier = 'T2';\n  else if (tier_raw.indexOf('T3') === 0) tier = 'T3';\n\n  if (tier && tier_map[tier]) {\n    tier_map[tier].total++;\n  }\n\n  let is_approved = status === 'Approved' || status === 'Edited-Approved';\n  let is_pending = status === 'Pending' || status === 'Pending-Elevated';\n  let is_published = status === 'Published';\n\n  if (is_approved || is_published) {\n    approved_count++;\n    if (tier && tier_map[tier]) {\n      tier_map[tier].approved++;\n    }\n  }\n\n  if (is_pending) {\n    if (tier && tier_map[tier]) {\n      tier_map[tier].pending++;\n    }\n  }\n\n  if (is_published) {\n    published_count++;\n    let pub_ts = rec['Published Timestamp'] ? new Date(rec['Published Timestamp']).getTime() : 0;\n    let ala_id = String(rec['ALA Record ID'] || '');\n    let ala_rec = null;\n    for (let j = 0; j < ala_records.length; j++) {\n      if (String(ala_records[j]['Id']) === ala_id) {\n        ala_rec = ala_records[j];\n        break;\n      }\n    }\n    let ala_ts = ala_rec && ala_rec['ALA Timestamp'] ? new Date(ala_rec['ALA Timestamp']).getTime() : 0;\n\n    if (pub_ts > 0 && ala_ts > 0) {\n      let hrs = (pub_ts - ala_ts) / 3600000;\n      velocity_sum += hrs;\n      velocity_count++;\n      if (tier && tier_map[tier]) {\n        tier_map[tier].velocity_sum += hrs;\n        tier_map[tier].velocity_count++;\n      }\n      if (hrs <= 48) {\n        sla_compliant++;\n      }\n    }\n\n    let draft_text = (rec['Public Response Draft'] || '').toLowerCase();\n    let pd = {};\n    pd.draft_text = draft_text;\n    pd.tier = tier;\n    published_drafts.push(pd);\n  }\n}\n\nconst sla_compliance_rate = published_count > 0 ? Math.round((sla_compliant / published_count) * 10000) / 100 : 0;\nconst seo_avg_velocity_hrs = velocity_count > 0 ? Math.round((velocity_sum / velocity_count) * 100) / 100 : 0;\nconst seo_response_rate = s7.total_records > 0 ? Math.round((published_count / s7.total_records) * 10000) / 100 : 0;\n\nconst tier_labels = {};\ntier_labels['T1'] = 'T1 Standard';\ntier_labels['T2'] = 'T2 Calibrated';\ntier_labels['T3'] = 'T3 Dignity-restoration';\n\nconst tier_breakdown = [];\nconst tier_keys = ['T1', 'T2', 'T3'];\nfor (let i = 0; i < tier_keys.length; i++) {\n  let tk = tier_keys[i];\n  let tm = tier_map[tk];\n  let avg_hrs = tm.velocity_count > 0 ? Math.round((tm.velocity_sum / tm.velocity_count) * 10) / 10 : 0;\n  let tb = {};\n  tb.tier = tier_labels[tk];\n  tb.total = tm.total;\n  tb.approved = tm.approved;\n  tb.pending = tm.pending;\n  tb.avg_approval_hrs = avg_hrs;\n  tier_breakdown.push(tb);\n}\n\nreturn [{ json: {\n  mra_run_id: s7.mra_run_id,\n  report_type: s7.report_type,\n  period_start: s7.period_start,\n  period_end: s7.period_end,\n  window_days: s7.window_days,\n  run_timestamp: s7.run_timestamp,\n  client_id: s7.client_id,\n  client_name: s7.client_name,\n  approval_email: s7.approval_email,\n  seo_keywords: s7.seo_keywords,\n  total_records: s7.total_records,\n  avg_star_rating: s7.avg_star_rating,\n  platform_counts: s7.platform_counts,\n  sla_compliance_rate: sla_compliance_rate,\n  seo_avg_velocity_hrs: seo_avg_velocity_hrs,\n  seo_response_rate: seo_response_rate,\n  tier_breakdown: tier_breakdown,\n  published_drafts: published_drafts,\n  total_rda: total_rda,\n  published_count: published_count\n} }];"
