    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst s9 = $('Step 9 - Process RDA Records').first().json;\n\nconst allClusters = input.list || [];\n\nconst latestRunTs = allClusters.length > 0 ? allClusters[0]['Run Timestamp'] : null;\n\nconst clusters = [];\nfor (let i = 0; i < allClusters.length; i++) {\n  if (allClusters[i]['Run Timestamp'] === latestRunTs) {\n    clusters.push(allClusters[i]);\n  }\n}\n\nlet t_negative_count = 0;\nlet t_ambiguous_count = 0;\nlet t_positive_count = 0;\n\nconst domain_map = {};\n\nfor (let i = 0; i < clusters.length; i++) {\n  let cl = clusters[i];\n  let tier = (cl['Signal Tier'] || '').trim();\n  let domain = (cl['Domain'] || 'Unknown').trim();\n  let n = parseInt(cl['N'] || 0);\n\n  if (tier === 'T-NEGATIVE') t_negative_count++;\n  else if (tier === 'T-AMBIGUOUS') t_ambiguous_count++;\n  else if (tier === 'T-POSITIVE') t_positive_count++;\n\n  if (!domain_map[domain]) {\n    domain_map[domain] = {};\n    domain_map[domain].domain = domain;\n    domain_map[domain].neg = 0;\n    domain_map[domain].amb = 0;\n    domain_map[domain].pos = 0;\n    domain_map[domain].total = 0;\n  }\n\n  if (tier === 'T-NEGATIVE') domain_map[domain].neg += n;\n  else if (tier === 'T-AMBIGUOUS') domain_map[domain].amb += n;\n  else if (tier === 'T-POSITIVE') domain_map[domain].pos += n;\n\n  domain_map[domain].total += n;\n}\n\nconst domain_keys = Object.keys(domain_map);\nconst top_domains = [];\nfor (let i = 0; i < domain_keys.length; i++) {\n  top_domains.push(domain_map[domain_keys[i]]);\n}\n\nlet swap_tmp;\nfor (let i = 0; i < top_domains.length - 1; i++) {\n  for (let j = i + 1; j < top_domains.length; j++) {\n    if (top_domains[j].total > top_domains[i].total) {\n      swap_tmp = top_domains[i];\n      top_domains[i] = top_domains[j];\n      top_domains[j] = swap_tmp;\n    }\n  }\n}\n\nconst trend_signals = [];\nfor (let i = 0; i < clusters.length; i++) {\n  let cl = clusters[i];\n  let is_singleton = cl['Is Singleton'] === true || cl['Is Singleton'] === 1;\n  if (!is_singleton) {\n    let ts = {};\n    ts.domain = (cl['Domain'] || '').trim();\n    ts.tier = (cl['Signal Tier'] || '').trim();\n    ts.n = parseInt(cl['N'] || 0);\n    let prior_n_val = null;\n    if (cl['Prior N'] !== null && cl['Prior N'] !== undefined) {\n      prior_n_val = parseInt(cl['Prior N']);\n    }\n    ts.prior_n = prior_n_val;\n    ts.trend_direction = (cl['Trend Direction'] || '').trim();\n    ts.percentage = parseFloat(cl['Percentage'] || 0);\n    trend_signals.push(ts);\n  }\n}\n\nconst tierOrder = {};\ntierOrder['T-NEGATIVE'] = 0;\ntierOrder['T-AMBIGUOUS'] = 1;\ntierOrder['T-POSITIVE'] = 2;\n\nlet sort_tmp;\nfor (let i = 0; i < trend_signals.length - 1; i++) {\n  for (let j = i + 1; j < trend_signals.length; j++) {\n    let ta = tierOrder[trend_signals[i].tier] !== undefined ? tierOrder[trend_signals[i].tier] : 3;\n    let tb = tierOrder[trend_signals[j].tier] !== undefined ? tierOrder[trend_signals[j].tier] : 3;\n    let do_swap = false;\n    if (tb < ta) do_swap = true;\n    else if (tb === ta && trend_signals[j].n > trend_signals[i].n) do_swap = true;\n    if (do_swap) {\n      sort_tmp = trend_signals[i];\n      trend_signals[i] = trend_signals[j];\n      trend_signals[j] = sort_tmp;\n    }\n  }\n}\n\nconst trend_signals_top5 = [];\nfor (let i = 0; i < trend_signals.length && i < 5; i++) {\n  trend_signals_top5.push(trend_signals[i]);\n}\n\nconst seo_keywords = s9.seo_keywords || [];\nconst published_drafts = s9.published_drafts || [];\n\nconst keyword_hits = {};\nfor (let i = 0; i < seo_keywords.length; i++) {\n  keyword_hits[seo_keywords[i]] = 0;\n}\n\nfor (let i = 0; i < published_drafts.length; i++) {\n  let text = published_drafts[i].draft_text || '';\n  for (let j = 0; j < seo_keywords.length; j++) {\n    if (text.includes(seo_keywords[j])) {\n      keyword_hits[seo_keywords[j]]++;\n    }\n  }\n}\n\nlet seo_top_keyword = '';\nlet seo_top_count = 0;\n\nconst kw_keys = Object.keys(keyword_hits);\nfor (let i = 0; i < kw_keys.length; i++) {\n  let kw = kw_keys[i];\n  let count = keyword_hits[kw];\n  if (count > seo_top_count) {\n    seo_top_count = count;\n    seo_top_keyword = kw;\n  }\n}\n\nconst total_published = s9.published_count || 0;\nlet drafts_with_keyword = 0;\nfor (let i = 0; i < published_drafts.length; i++) {\n  let text = published_drafts[i].draft_text || '';\n  let found = false;\n  for (let j = 0; j < seo_keywords.length; j++) {\n    if (text.includes(seo_keywords[j])) {\n      found = true;\n    }\n  }\n  if (found) {\n    drafts_with_keyword++;\n  }\n}\n\nconst seo_coverage_rate = total_published > 0 ? Math.round((drafts_with_keyword / total_published) * 10000) / 100 : 0;\n\nreturn [{ json: {\n  mra_run_id: s9.mra_run_id,\n  report_type: s9.report_type,\n  period_start: s9.period_start,\n  period_end: s9.period_end,\n  window_days: s9.window_days,\n  run_timestamp: s9.run_timestamp,\n  client_id: s9.client_id,\n  client_name: s9.client_name,\n  approval_email: s9.approval_email,\n  seo_keywords: s9.seo_keywords,\n  total_records: s9.total_records,\n  avg_star_rating: s9.avg_star_rating,\n  platform_counts: s9.platform_counts,\n  sla_compliance_rate: s9.sla_compliance_rate,\n  seo_avg_velocity_hrs: s9.seo_avg_velocity_hrs,\n  seo_response_rate: s9.seo_response_rate,\n  tier_breakdown: s9.tier_breakdown,\n  published_count: s9.published_count,\n  t_negative_count: t_negative_count,\n  t_ambiguous_count: t_ambiguous_count,\n  t_positive_count: t_positive_count,\n  top_domains: top_domains,\n  trend_signals: trend_signals_top5,\n  seo_keyword_hits: drafts_with_keyword,\n  seo_top_keyword: seo_top_keyword,\n  seo_coverage_rate: seo_coverage_rate\n} }];"
