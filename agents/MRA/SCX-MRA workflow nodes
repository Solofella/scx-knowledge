      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst s5 = $('Step 5 - Extract Client Config').first().json;\n\nconst allRecords = input.list || [];\nconst periodStart = new Date(s5.period_start).getTime();\nconst periodEnd = new Date(s5.period_end).getTime();\n\nconst records = [];\nfor (let i = 0; i < allRecords.length; i++) {\n  let rec = allRecords[i];\n  let raw = rec['Date'] || '';\n  let ts = 0;\n  if (raw.length > 0) {\n    let parts = raw.split('/');\n    if (parts.length === 3) {\n      let month = parseInt(parts[0]);\n      let day = parseInt(parts[1]);\n      let year = 2000 + parseInt(parts[2]);\n      ts = new Date(year, month - 1, day).getTime();\n    }\n  }\n  if (ts >= periodStart && ts <= periodEnd) {\n    records.push(rec);\n  }\n}\n\nconst total_records = records.length;\n\nlet avg_star_rating = 0;\nif (total_records > 0) {\n  let sum = 0;\n  for (let i = 0; i < records.length; i++) {\n    sum += parseFloat(records[i]['Star Rating'] || 0);\n  }\n  avg_star_rating = Math.round((sum / total_records) * 100) / 100;\n}\n\nconst platform_counts = {};\nfor (let i = 0; i < records.length; i++) {\n  let plat = records[i]['Platform'] || 'Unknown';\n  platform_counts[plat] = (platform_counts[plat] || 0) + 1;\n}\n\nreturn [{ json: {\n  mra_run_id: s5.mra_run_id,\n  report_type: s5.report_type,\n  period_start: s5.period_start,\n  period_end: s5.period_end,\n  window_days: s5.window_days,\n  run_timestamp: s5.run_timestamp,\n  client_id: s5.client_id,\n  client_name: s5.client_name,\n  approval_email: s5.approval_email,\n  seo_keywords: s5.seo_keywords,\n  total_records: total_records,\n  avg_star_rating: avg_star_rating,\n  platform_counts: platform_counts,\n  ala_records: records\n} }];"
