const s16 = $input.first().json;

const client_name = s16.client_name || s16.client_id || 'Client';
const period_end = s16.period_end ? s16.period_end.slice(0, 10) : '';
const client_id_str = s16.client_id || '';

const tier_breakdown = s16.tier_breakdown || [];
const platform_counts = s16.platform_counts || {};
const top_domains = s16.top_domains || [];
const expression_modes = s16.expression_modes || {};

let t3_total = 0;
for (let i = 0; i < tier_breakdown.length; i++) {
  if (tier_breakdown[i].tier === 'T3 Dignity-restoration') {
    t3_total = tier_breakdown[i].total || 0;
  }
}

const emailStyles = `
  body { 
    font-family: 'Host Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; 
    line-height: 1.6; 
    color: #384653; 
    background-color: #F6F6F6; 
    margin: 0; 
    padding: 0; 
  }
  .container { max-width: 600px; margin: 0 auto; background-color: #ffffff; }
  .header { 
    background: linear-gradient(135deg, #C7E0E7 0%, #64B8CE 99%); 
    color: #2E304E; 
    padding: 32px 24px; 
    text-align: center; 
  }
  .header h1 { margin: 0 0 8px 0; font-size: 24px; font-weight: 600; color: #2E304E; }
  .header p { margin: 0; font-size: 14px; opacity: 0.95; color: #384653; }
  .content { padding: 24px; }
  .section { margin-bottom: 24px; }
  .section-title { 
    font-size: 16px; 
    font-weight: 600; 
    color: #2E304E; 
    margin: 0 0 12px 0; 
    display: flex; 
    align-items: center; 
  }
  .section-title .emoji { margin-right: 8px; font-size: 18px; }
  .metric-card { 
    background-color: #C7E0E7; 
    border-left: 4px solid #64B8CE; 
    padding: 16px; 
    border-radius: 6px; 
    margin-bottom: 12px; 
  }
  .metric-row { display: flex; justify-content: space-between; margin-bottom: 8px; }
  .metric-label { font-size: 14px; color: #A8A9AD; }
  .metric-value { font-size: 14px; font-weight: 600; color: #2E304E; }
  .metric-large { font-size: 28px; font-weight: 700; color: #2E304E; margin: 8px 0; }
  .alert-box { 
    background-color: #fff5f0; 
    border-left: 4px solid #C3643D; 
    padding: 12px 16px; 
    border-radius: 6px; 
    margin-bottom: 12px; 
  }
  .alert-text { color: #C3643D; font-size: 14px; margin: 0; font-weight: 500; }
  .platform-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .platform-item { 
    background-color: #C7E0E7; 
    padding: 12px; 
    border-radius: 6px; 
    text-align: center; 
    border: 1px solid #64B8CE; 
  }
  .platform-name { 
    font-size: 12px; 
    color: #A8A9AD; 
    margin-bottom: 4px; 
    text-transform: uppercase; 
    font-weight: 600; 
    letter-spacing: 0.5px; 
  }
  .platform-count { font-size: 20px; font-weight: 700; color: #2E304E; }
  .domain-item { 
    background-color: #C7E0E7; 
    padding: 12px 16px; 
    border-radius: 6px; 
    margin-bottom: 8px; 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    border-left: 3px solid #64B8CE; 
  }
  .domain-name { font-size: 14px; color: #2E304E; font-weight: 500; }
  .domain-count { 
    font-size: 14px; 
    font-weight: 700; 
    color: #2E304E; 
    background-color: rgba(100,184,206,0.2); 
    padding: 4px 12px; 
    border-radius: 12px; 
  }
  .cta-button { 
    display: inline-block; 
    background: linear-gradient(135deg, #C7E0E7 0%, #64B8CE 99%); 
    color: #FFFFFF !important; 
    padding: 14px 28px; 
    text-decoration: none; 
    border-bottom: none; 
    border-radius: 6px; 
    font-weight: 600; 
    font-size: 14px; 
    margin: 16px 0; 
    box-shadow: 0 2px 4px rgba(100,184,206,0.3); 
  }
  .footer { 
    background-color: #C7E0E7; 
    padding: 20px 24px; 
    text-align: center; 
    font-size: 12px; 
    color: #A8A9AD; 
    border-top: 1px solid #64B8CE; 
  }
  .footer-note { margin: 8px 0; font-style: italic; color: #2E304E; }
  .divider { border: 0; height: 1px; background-color: #64B8CE; margin: 12px 0; }
  a { color: #3A6B7E; text-decoration: none; }
`;

const email_subject = '48-Hour Draft Summary — ' + client_id_str + ' — ' + period_end;

let platform_cards_html = '';
const platform_order = ['Google', 'OpenTable', 'Yelp', 'TripAdvisor'];
for (let i = 0; i < platform_order.length; i++) {
  let plat = platform_order[i];
  let count = platform_counts[plat] || 0;
  platform_cards_html += '<div class="platform-item"><div class="platform-name">' + plat + '</div><div class="platform-count">' + count + '</div></div>';
}

let tier_cards_html = '';
for (let i = 0; i < tier_breakdown.length; i++) {
  let tb = tier_breakdown[i];
  let short_label = tb.tier.replace(' Standard', '').replace(' Calibrated', '').replace(' Dignity-restoration', '');
  tier_cards_html += '<div class="metric-row"><span class="metric-label">' + short_label + '</span><span class="metric-value">' + tb.total + ' draft(s)</span></div>';
}

let alert_html = '';
if (t3_total > 0) {
  alert_html = '<div class="alert-box"><p class="alert-text">⚠️ ' + t3_total + ' draft(s) require elevated attention (T3 — dignity-risk signals)</p></div>';
}

let email_body = '<!DOCTYPE html><html><head><style>' + emailStyles + '</style></head><body>';
email_body += '<div class="container">';
email_body += '<div class="header"><h1>48-Hour Draft Summary</h1><p>' + client_id_str + ' • ' + period_end + '</p></div>';
email_body += '<div class="content">';

email_body += '<div class="section"><h2 class="section-title"><span class="emoji">📊</span>New Drafts Generated</h2>';
email_body += '<div class="metric-card">' + tier_cards_html;
email_body += '<hr class="divider"><div class="metric-row"><span class="metric-label" style="font-weight: 600; color: #2E304E;">Total new drafts</span><span class="metric-value" style="font-size: 18px; color: #2E304E;">' + (s16.total_records || 0) + '</span></div>';
email_body += '</div></div>';

if (alert_html) {
  email_body += alert_html;
}

email_body += '<div class="section"><h2 class="section-title"><span class="emoji">📈</span>Platform Breakdown</h2>';
email_body += '<div class="platform-grid">' + platform_cards_html + '</div></div>';

const total_sig = (s16.t_negative_count || 0) + (s16.t_ambiguous_count || 0) + (s16.t_positive_count || 0);
const neg_pct = total_sig > 0 ? Math.round(((s16.t_negative_count || 0) / total_sig) * 100) : 0;
const amb_pct = total_sig > 0 ? Math.round(((s16.t_ambiguous_count || 0) / total_sig) * 100) : 0;
const pos_pct = total_sig > 0 ? Math.round(((s16.t_positive_count || 0) / total_sig) * 100) : 0;

email_body += '<div class="section"><h2 class="section-title"><span class="emoji">📊</span>Signal Direction</h2>';
email_body += '<div class="metric-card">';
email_body += '<div class="metric-row"><span class="metric-label">Positive</span><span class="metric-value" style="color: #64B8CE; font-weight: 700;">' + (s16.t_positive_count || 0) + ' (' + pos_pct + '%)</span></div>';
email_body += '<div class="metric-row"><span class="metric-label">Ambiguous</span><span class="metric-value" style="color: #E9CFC9; font-weight: 700;">' + (s16.t_ambiguous_count || 0) + ' (' + amb_pct + '%)</span></div>';
email_body += '<div class="metric-row"><span class="metric-label">Negative</span><span class="metric-value" style="color: #C3643D; font-weight: 700;">' + (s16.t_negative_count || 0) + ' (' + neg_pct + '%)</span></div>';
email_body += '</div></div>';

const total_expr = (expression_modes.Explicit || 0) + (expression_modes.Implicit || 0) + (expression_modes.Masked || 0) + (expression_modes.Performative || 0) + (expression_modes.Conflicted || 0) + (expression_modes.Absent || 0);

const expr_pct_explicit = total_expr > 0 ? Math.round(((expression_modes.Explicit || 0) / total_expr) * 100) : 0;
const expr_pct_implicit = total_expr > 0 ? Math.round(((expression_modes.Implicit || 0) / total_expr) * 100) : 0;
const expr_pct_masked = total_expr > 0 ? Math.round(((expression_modes.Masked || 0) / total_expr) * 100) : 0;
const expr_pct_performative = total_expr > 0 ? Math.round(((expression_modes.Performative || 0) / total_expr) * 100) : 0;
const expr_pct_conflicted = total_expr > 0 ? Math.round(((expression_modes.Conflicted || 0) / total_expr) * 100) : 0;
const expr_pct_absent = total_expr > 0 ? Math.round(((expression_modes.Absent || 0) / total_expr) * 100) : 0;

email_body += '<div class="section"><h2 class="section-title"><span class="emoji">🔍</span>Expression Mode</h2>';
email_body += '<div class="metric-card">';
email_body += '<div class="metric-row"><span class="metric-label">Explicit</span><span class="metric-value">' + (expression_modes.Explicit || 0) + ' (' + expr_pct_explicit + '%)</span></div>';
email_body += '<div class="metric-row"><span class="metric-label">Implicit</span><span class="metric-value">' + (expression_modes.Implicit || 0) + ' (' + expr_pct_implicit + '%)</span></div>';
email_body += '<div class="metric-row"><span class="metric-label">Masked</span><span class="metric-value">' + (expression_modes.Masked || 0) + ' (' + expr_pct_masked + '%)</span></div>';
email_body += '<div class="metric-row"><span class="metric-label">Performative</span><span class="metric-value">' + (expression_modes.Performative || 0) + ' (' + expr_pct_performative + '%)</span></div>';
email_body += '<div class="metric-row"><span class="metric-label">Conflicted</span><span class="metric-value">' + (expression_modes.Conflicted || 0) + ' (' + expr_pct_conflicted + '%)</span></div>';
email_body += '<div class="metric-row"><span class="metric-label">Absent</span><span class="metric-value">' + (expression_modes.Absent || 0) + ' (' + expr_pct_absent + '%)</span></div>';
email_body += '</div></div>';

if (top_domains && top_domains.length > 0) {
  email_body += '<div class="section"><h2 class="section-title"><span class="emoji">🔍</span>Pain Point Domains</h2>';
  let domain_limit = top_domains.length > 5 ? 5 : top_domains.length;
  for (let i = 0; i < domain_limit; i++) {
    let dom = top_domains[i];
    email_body += '<div class="domain-item"><span class="domain-name">' + dom.domain + '</span><span class="domain-count">' + dom.total + '</span></div>';
  }
  email_body += '</div>';
}

email_body += '<div class="section"><h2 class="section-title"><span class="emoji">📋</span>Pending Approval</h2>';
email_body += '<div class="metric-card"><div class="metric-large">' + (s16.all_time_pending || 0) + '</div>';
email_body += '<div class="metric-label">Draft(s) awaiting your review (all time)</div></div>';
email_body += '<a href="https://docs.google.com/spreadsheets/d/1JT0jt_l4NthR2n3Eu0-DUcWkhsMLV6mKaVJ5FFgIU6w" class="cta-button" style="color: #FFFFFF; text-decoration: none; border-bottom: none;">View & Approve Drafts →</a></div>';

email_body += '</div>';
email_body += '<div class="footer"><div class="footer-note">SubtextCX detects and interprets signals only.<br>Operational decisions remain with your team.</div></div>';
email_body += '</div></body></html>';

const brevo_to = {};
brevo_to['email'] = s16.approval_email || 'miguel@solofella.com';
brevo_to['name'] = client_name;
const brevo_to_arr = [];
brevo_to_arr.push(brevo_to);

const brevo_sender = {};
brevo_sender['name'] = 'SubtextCX Reports';
brevo_sender['email'] = 'marellano@solofella.com';

const brevo_obj = {};
brevo_obj['sender'] = brevo_sender;
brevo_obj['to'] = brevo_to_arr;
brevo_obj['subject'] = email_subject;
brevo_obj['htmlContent'] = email_body;

return [{ json: {
  mra_run_id: s16.mra_run_id,
  report_type: 'daily',
  client_id: client_id_str,
  approval_email: s16.approval_email,
  nocodb_record_id: null,
  email_subject: email_subject,
  email_body: email_body,
  magic_token: s16.magic_token,
  brevo_body: JSON.stringify(brevo_obj)
} }];
