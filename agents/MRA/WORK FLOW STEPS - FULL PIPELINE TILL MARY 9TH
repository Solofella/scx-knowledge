icit || 0) / total_expr) * 100) : 0;\nexpr_pct.Implicit = total_expr > 0 ? Math.round(((expression_modes.Implicit || 0) / total_expr) * 100) : 0;\nexpr_pct.Masked = total_expr > 0 ? Math.round(((expression_modes.Masked || 0) / total_expr) * 100) : 0;\nexpr_pct.Performative = total_expr > 0 ? Math.round(((expression_modes.Performative || 0) / total_expr) * 100) : 0;\nexpr_pct.Conflicted = total_expr > 0 ? Math.round(((expression_modes.Conflicted || 0) / total_expr) * 100) : 0;\nexpr_pct.Absent = total_expr > 0 ? Math.round(((expression_modes.Absent || 0) / total_expr) * 100) : 0;\n\nlet email_body = '<!DOCTYPE html><html><head><style>' + emailStyles + '</style></head><body>';\nemail_body += '<div class=\"container\">';\nemail_body += '<div class=\"header\"><h1>24-Hour Review Summary</h1><p>' + client_id_str + ' • ' + period_end + '</p></div>';\nemail_body += '<div class=\"content\">';\n\nemail_body += '<h2 style=\"font-size: 18px; color: #2E304E; margin: 0 0 16px 0; font-weight: 600;\">LAST 24 HOURS SNAPSHOT</h2>';\n\nemail_body += '<div class=\"section\"><h3 class=\"section-title\">NEW REVIEWS</h3><div class=\"metric-card\">';\nemail_body += '<div class=\"metric-large\">' + total_records + '</div>';\nemail_body += '<div class=\"metric-label\">Total reviews received from last 24 hours</div>';\nemail_body += '</div></div>';\n\nemail_body += '<div class=\"section\"><h3 class=\"section-title\">PLATFORMS</h3><div class=\"metric-card\">';\nemail_body += '<div class=\"metric-row\"><span class=\"metric-label\">Google</span><span class=\"metric-value\">' + (platform_counts.Google || 0) + ' reviews</span></div>';\nemail_body += '<div class=\"metric-row\"><span class=\"metric-label\">OpenTable</span><span class=\"metric-value\">' + (platform_counts.OpenTable || 0) + ' reviews</span></div>';\nemail_body += '<div class=\"metric-row\"><span class=\"metric-label\">Yelp</span><span class=\"metric-value\">' + (platform_counts.Yelp || 0) + ' reviews</span></div>';\nemail_body += '<di