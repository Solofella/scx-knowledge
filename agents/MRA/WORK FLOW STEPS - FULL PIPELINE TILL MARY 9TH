        "jsCode": "const input = $input.first().json;\nconst p = typeof input.body === 'string' ? JSON.parse(input.body) : input;\nconst report_type = p.report_type || 'daily';\n\nconst now = new Date();\n\nconst pad = (n, l=2) => String(n).padStart(l, '0');\nconst d = `${now.getFullYear()}${pad(now.getMonth()+1)}${pad(now.getDate())}`;\nconst t = `${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;\nconst mra_run_id = `MRA-${d}-${t}`;\n\nlet period_start;\nlet period_end;\nlet window_days;\n\nif (report_type === 'daily') {\n  window_days = 1;\n  period_end = now.toISOString();\n  period_start = new Date(now.getTime() - 2 * 86400000).toISOString();\n} else if (report_type === 'weekly') {\n  window_days = 7;\n  period_end = now.toISOString();\n  period_start = new Date(now.getTime() - 7 * 86400000).toISOString();\n} else {\n  window_days = 30;\n  const firstOfThisMonth = new Date(now.getFullYear(), now.getMonth(), 1);\n  const firstOfLastMonth = new Date(now.getFullYear(), now.getMonth() - 1, 1);\n  period_start = firstOfLastMonth.toISOString();\n  period_end = new Date(firstOfThisMonth.getTime() - 1).toISOString();\n}\n\nconst result = {};\nresult.mra_run_id = mra_run_id;\nresult.report_type = report_type;\nresult.period_start = period_start;\nresult.period_end = period_end;\nresult.window_days = window_days;\nresult.run_timestamp = now.toISOString();\n\nreturn [{ json: result }];"
