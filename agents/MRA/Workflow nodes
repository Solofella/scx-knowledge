Step 12 - Build MRA Record
const s11 = $('Step 11 - Process SIA and SEO').first().json;

const now = new Date();
const expires = new Date(now.getTime() + 72 * 3600000);

const ey = expires.getFullYear();
const em = expires.getMonth() + 1;
const ed = expires.getDate();
const eh = expires.getHours();
const emin = expires.getMinutes();
const esec = expires.getSeconds();
const exp_str = ey + '-' + (em < 10 ? '0' + em : '' + em) + '-' + (ed < 10 ? '0' + ed : '' + ed) + 'T' + (eh < 10 ? '0' + eh : '' + eh) + ':' + (emin < 10 ? '0' + emin : '' + emin) + ':' + (esec < 10 ? '0' + esec : '' + esec) + '.000Z';

const hex_chars = '0123456789abcdef';
let tok_a = '';
let tok_b = '';
let tok_c = '';
let tok_d = '';
let tok_e = '';
for (let i = 0; i < 8; i++) { tok_a += hex_chars[Math.floor(Math.random() * 16)]; }
for (let i = 0; i < 4; i++) { tok_b += hex_chars[Math.floor(Math.random() * 16)]; }
for (let i = 0; i < 3; i++) { tok_c += hex_chars[Math.floor(Math.random() * 16)]; }
for (let i = 0; i < 3; i++) { tok_d += hex_chars[Math.floor(Math.random() * 16)]; }
