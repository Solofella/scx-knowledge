for (let i = 0; i < allRecords.length; i++) {
  let rec = allRecords[i];
  let raw = rec['Date'] || '';
  let ts = 0;
  if (raw.length > 0) {
    let parts = raw.split('/');
    if (parts.length === 3) {
      let month = parseInt(parts[0]);
      let day = parseInt(parts[1]);
      let year = 2000 + parseInt(parts[2]);
      ts = new Date(year, month - 1, day).getTime();
    }
  }
  if (ts >= periodStart && ts <= periodEnd) {
    records.push(rec);
  }
}

const total_records = records.length;

let avg_star_rating = 0;
if (total_records > 0) {
  let sum = 0;
  for (let i = 0; i < records.length; i++) {
    sum += parseFloat(records[i]['Star Rating'] || 0);
  }
  avg_star_rating = Math.round((sum / total_records) * 100) / 100;
}

const platform_counts = {};
for (let i = 0; i < records.length; i++) {
  let plat = records[i]['Platform'] || 'Unknown';
  platform_counts[plat] = (platform_counts[plat] || 0) + 1;
}

