Step 11 - Process SIA and SEO
const input = $input.first().json;
const s9 = $('Step 9 - Process RDA Records').first().json;

const allClusters = input.list || [];

const latestRunTs = allClusters.length > 0 ? allClusters[0]['Run Timestamp'] : null;

const clusters = [];
for (let i = 0; i < allClusters.length; i++) {
  if (allClusters[i]['Run Timestamp'] === latestRunTs) {
    clusters.push(allClusters[i]);
  }
}

let t_negative_count = 0;
let t_ambiguous_count = 0;
let t_positive_count = 0;

const domain_map = {};

for (let i = 0; i < clusters.length; i++) {
  let cl = clusters[i];
  let tier = (cl['Signal Tier'] || '').trim();
  let domain = (cl['Domain'] || 'Unknown').trim();
  let n = parseInt(cl['N'] || 0);

  if (tier === 'T-NEGATIVE') t_negative_count++;
  else if (tier === 'T-AMBIGUOUS') t_ambiguous_count++;
  else if (tier === 'T-POSITIVE') t_positive_count++;

  if (!domain_map[domain]) {
    domain_map[domain] = {};
    domain_map[domain].domain = domain;
    domain_map[domain].neg = 0;
    domain_map[domain].amb = 0;
    domain_map[domain].pos = 0;
    domain_map[domain].total = 0;
  }

  if (tier === 'T-NEGATIVE') domain_map[domain].neg += n;
  else if (tier === 'T-AMBIGUOUS') domain_map[domain].amb += n;
  else if (tier === 'T-POSITIVE') domain_map[domain].pos += n;

  domain_map[domain].total += n;
}

const domain_keys = Object.keys(domain_map);
const top_domains = [];
for (let i = 0; i < domain_keys.length; i++) {
  top_domains.push(domain_map[domain_keys[i]]);
}

let swap_tmp;
for (let i = 0; i < top_domains.length - 1; i++) {
  for (let j = i + 1; j < top_domains.length; j++) {
    if (top_domains[j].total > top_domains[i].total) {
      swap_tmp = top_domains[i];
      top_domains[i] = top_domains[j];
      top_domains[j] = swap_tmp;
    }
  }
}

const trend_signals = [];
for (let i = 0; i < clusters.length; i++) {
  let cl = clusters[i];
  let is_singleton = cl['Is Singleton'] === true || cl['Is Singleton'] === 1;
  if (!is_singleton) {
    let ts = {};
    ts.domain = (cl['Domain'] || '').trim();
    ts.tier = (cl['Signal Tier'] || '').trim();
    ts.n = parseInt(cl['N'] || 0);
    let prior_n_val = null;
    if (cl['Prior N'] !== null && cl['Prior N'] !== undefined) {
      prior_n_val = parseInt(cl['Prior N']);
    }
    ts.prior_n = prior_n_val;
    ts.trend_direction = (cl['Trend Direction'] || '').trim();
    ts.percentage = parseFloat(cl['Percentage'] || 0);
    trend_signals.push(ts);
  }
}

const tierOrder = {};
tierOrder['T-NEGATIVE'] = 0;
tierOrder['T-AMBIGUOUS'] = 1;
tierOrder['T-POSITIVE'] = 2;

let sort_tmp;
for (let i = 0; i < trend_signals.length - 1; i++) {
  for (let j = i + 1; j < trend_signals.length; j++) {
    let ta = tierOrder[trend_signals[i].tier] !== undefined ? tierOrder[trend_signals[i].tier] : 3;
    let tb = tierOrder[trend_signals[j].tier] !== undefined ? tierOrder[trend_signals[j].tier] : 3;
    let do_swap = false;
    if (tb < ta) do_swap = true;
    else if (tb === ta && trend_signals[j].n > trend_signals[i].n) do_swap = true;
    if (do_swap) {
      sort_tmp = trend_signals[i];
      trend_signals[i] = trend_signals[j];
      trend_signals[j] = sort_tmp;
    }
  }
}

const trend_signals_top5 = [];
for (let i = 0; i < trend_signals.length && i < 5; i++) {
  trend_signals_top5.push(trend_signals[i]);
}

const seo_keywords = s9.seo_keywords || [];
const published_drafts = s9.published_drafts || [];

const keyword_hits = {};
for (let i = 0; i < seo_keywords.length; i++) {
  keyword_hits[seo_keywords[i]] = 0;
}

for (let i = 0; i < published_drafts.length; i++) {
  let text = published_drafts[i].draft_text || '';
  for (let j = 0; j < seo_keywords.length; j++) {
    if (text.includes(seo_keywords[j])) {
      keyword_hits[seo_keywords[j]]++;
    }
  }
}

let seo_top_keyword = '';
let seo_top_count = 0;

const kw_keys = Object.keys(keyword_hits);
for (let i = 0; i < kw_keys.length; i++) {
  let kw = kw_keys[i];
  let count = keyword_hits[kw];
  if (count > seo_top_count) {
    seo_top_count = count;
    seo_top_keyword = kw;
  }
}

const total_published = s9.published_count || 0;
let drafts_with_keyword = 0;
for (let i = 0; i < published_drafts.length; i++) {
  let text = published_drafts[i].draft_text || '';
  let found = false;
  for (let j = 0; j < seo_keywords.length; j++) {
    if (text.includes(seo_keywords[j])) {
      found = true;
    }
  }
  if (found) {
    drafts_with_keyword++;
  }
}

const seo_coverage_rate = total_published > 0 ? Math.round((drafts_with_keyword / total_published) * 10000) / 100 : 0;

return [{ json: {
