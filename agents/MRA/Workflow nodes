Step 9 - Process RDA Records
const input = $input.first().json;
const s7 = $('Step 7b - Build RDA Query URL').first().json;

const allRda = input.list || [];
const alaRecords = s7.ala_records || [];

const pStart = new Date(s7.period_start);
pStart.setHours(0, 0, 0, 0);
const periodStartTs = pStart.getTime();

const pEnd = new Date(s7.period_end);
pEnd.setHours(0, 0, 0, 0);
const periodEndTs = pEnd.getTime();

const filteredRda = [];
const platform_counts = {};
let star_sum = 0;

for (let i = 0; i < allRda.length; i++) {
  let rec = allRda[i];
  let rdaTimestamp = rec['RDA Timestamp'] || '';
  let rdaTs = 0;
  
  if (rdaTimestamp.length > 0) {
    let datePart = rdaTimestamp.split(' ')[0];
    let d = new Date(datePart);
    d.setHours(0, 0, 0, 0);
    rdaTs = d.getTime();
  }
  
  if (rdaTs >= periodStartTs && rdaTs < periodEndTs) {
    filteredRda.push(rec);
    
    let alaId = String(rec['ALA Record ID'] || '');
    let matchedAla = null;
    
    for (let j = 0; j < alaRecords.length; j++) {
      if (String(alaRecords[j]['Id']) === alaId) {
        matchedAla = alaRecords[j];
        break;
      }
    }
    
    if (matchedAla) {
      let plat = matchedAla['Platform'] || 'Unknown';
      platform_counts[plat] = (platform_counts[plat] || 0) + 1;
      star_sum += parseFloat(matchedAla['Star Rating'] || 0);
    }
  }
}

const total_rda = filteredRda.length;
const avg_star_rating = total_rda > 0 ? Math.round((star_sum / total_rda) * 100) / 100 : 0;

let approved_count = 0;
let published_count = 0;
let sla_compliant = 0;
let velocity_sum = 0;
let velocity_count = 0;

const tier_map = {};
tier_map['T1'] = {};
tier_map['T1'].total = 0;
tier_map['T1'].approved = 0;
tier_map['T1'].pending = 0;
tier_map['T1'].velocity_sum = 0;
tier_map['T1'].velocity_count = 0;
tier_map['T2'] = {};
tier_map['T2'].total = 0;
tier_map['T2'].approved = 0;
tier_map['T2'].pending = 0;
tier_map['T2'].velocity_sum = 0;
tier_map['T2'].velocity_count = 0;
tier_map['T3'] = {};
tier_map['T3'].total = 0;
tier_map['T3'].approved = 0;
tier_map['T3'].pending = 0;
tier_map['T3'].velocity_sum = 0;
tier_map['T3'].velocity_count = 0;

const published_drafts = [];

for (let i = 0; i < filteredRda.length; i++) {
  let rec = filteredRda[i];
  let status = (rec['Approval Status'] || '').trim();
  let tier_raw = (rec['Confirmed Response Tier'] || '').trim();
  let tier = null;
  if (tier_raw.indexOf('T1') === 0) tier = 'T1';
  else if (tier_raw.indexOf('T2') === 0) tier = 'T2';
  else if (tier_raw.indexOf('T3') === 0) tier = 'T3';
  
  if (tier && tier_map[tier]) {
    tier_map[tier].total++;
  }
  
  let is_approved = status === 'Approved' || status === 'Edited-Approved';
  let is_pending = status === 'Pending' || status === 'Pending-Elevated';
  let is_published = status === 'Published';
  
  if (is_approved || is_published) {
    approved_count++;
    if (tier && tier_map[tier]) {
      tier_map[tier].approved++;
    }
  }
  
  if (is_pending) {
    if (tier && tier_map[tier]) {
      tier_map[tier].pending++;
    }
  }
  
  if (is_published) {
    published_count++;
    let pub_ts = rec['Published Timestamp'] ? new Date(rec['Published Timestamp']).getTime() : 0;
    let rda_ts = rec['RDA Timestamp'] ? new Date(rec['RDA Timestamp']).getTime() : 0;
    
    if (pub_ts > 0 && rda_ts > 0) {
      let hrs = (pub_ts - rda_ts) / 3600000;
      velocity_sum += hrs;
      velocity_count++;
      if (tier && tier_map[tier]) {
        tier_map[tier].velocity_sum += hrs;
        tier_map[tier].velocity_count++;
      }
      if (hrs <= 48) {
        sla_compliant++;
      }
    }
    
    let draft_text = (rec['Public Response Draft'] || '').toLowerCase();
    let pd = {};
    pd.draft_text = draft_text;
    pd.tier = tier;
    published_drafts.push(pd);
  }
}

const sla_compliance_rate = published_count > 0 ? Math.round((sla_compliant / published_count) * 10000) / 100 : 0;
const seo_avg_velocity_hrs = velocity_count > 0 ? Math.round((velocity_sum / velocity_count) * 100) / 100 : 0;
const seo_response_rate = total_rda > 0 ? Math.round((published_count / total_rda) * 10000) / 100 : 0;

const tier_labels = {};
tier_labels['T1'] = 'T1 Standard';
tier_labels['T2'] = 'T2 Calibrated';
tier_labels['T3'] = 'T3 Dignity-restoration';

const tier_breakdown = [];
const tier_keys = ['T1', 'T2', 'T3'];
for (let i = 0; i < tier_keys.length; i++) {
  let tk = tier_keys[i];
  let tm = tier_map[tk];
  let avg_hrs = tm.velocity_count > 0 ? Math.round((tm.velocity_sum / tm.velocity_count) * 10) / 10 : 0;
  let tb = {};
  tb.tier = tier_labels[tk];
  tb.total = tm.total;
  tb.approved = tm.approved;
  tb.pending = tm.pending;
  tb.avg_approval_hrs = avg_hrs;
  tier_breakdown.push(tb);
}

return [{ json: {
  mra_run_id: s7.mra_run_id,
  report_type: s7.report_type,
  period_start: s7.period_start,
  period_end: s7.period_end,
  window_days: s7.window_days,
  run_timestamp: s7.run_timestamp,
  client_id: s7.client_id,
  client_name: s7.client_name,
  approval_email: s7.approval_email,
  seo_keywords: s7.seo_keywords,
  total_records: total_rda,
  avg_star_rating: avg_star_rating,
  platform_counts: platform_counts,
  sla_compliance_rate: sla_compliance_rate,
  seo_avg_velocity_hrs: seo_avg_velocity_hrs,
  seo_response_rate: seo_response_rate,
  tier_breakdown: tier_breakdown,
  published_drafts: published_drafts,
  total_rda: total_rda,
  published_count: published_count
} }];

