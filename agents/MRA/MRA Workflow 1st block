      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst s3 = $('Step 3 - Set Window Parameters').first().json;\n\nconst records = input.list || [];\n\nif (records.length === 0) {\n  throw new Error('MRA: No Client Config found for PAK-001');\n}\n\nconst config = records[0];\n\nconst seo_raw = config['SEO Keywords'] || '';\nconst seo_keywords = seo_raw\n  .split(',')\n  .map(k => k.trim().toLowerCase())\n  .filter(k => k.length > 0);\n\nconst result = {};\nresult.mra_run_id = s3.mra_run_id;\nresult.report_type = s3.report_type;\nresult.period_start = s3.period_start;\nresult.period_end = s3.period_end;\nresult.window_days = s3.window_days;\nresult.run_timestamp = s3.run_timestamp;\nresult.client_id = config['Client ID'] || 'PAK-001';\nresult.client_name = config['Client Name'] || 'PAK-001';\nresult.approval_email = config['Approval Contact Email'] || '';\nresult.seo_keywords = seo_keywords;\n\nreturn [{ json: result }];"
