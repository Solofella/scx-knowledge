      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst s5 = $('Step 5 - Extract Client Config').first().json;\n\nconst allRecords = input.list || [];\n\nreturn [{ json: {\n  mra_run_id: s5.mra_run_id,\n  report_type: s5.report_type,\n  period_start: s5.period_start,\n  period_end: s5.period_end,\n  window_days: s5.window_days,\n  run_timestamp: s5.run_timestamp,\n  client_id: s5.client_id,\n  client_name: s5.client_name,\n  approval_email: s5.approval_email,\n  seo_keywords: s5.seo_keywords,\n  total_records: 0,\n  avg_star_rating: 0,\n  platform_counts: {},\n  ala_records: allRecords\n} }];"
