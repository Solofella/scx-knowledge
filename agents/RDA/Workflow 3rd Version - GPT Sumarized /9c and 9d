        "jsCode": "const response = $input.first().json;\nconst raw = response.content?.[0]?.text;\nconst inp = $('Step 9b - Build Audit Prompt').first().json;\nlet auditPassed = false;\nlet auditFailedItems = null;\nlet publicDraft = inp.generation_draft;\nif (raw) {\n  let clean = raw.replace(/`{1,3}json/gi, '').replace(/`{1,3}/g, '').trim();\n  try {\n    const parsed = JSON.parse(clean);\n    if (parsed.final_public_response_draft && parsed.final_public_response_draft.length >= 20) {\n      publicDraft = parsed.final_public_response_draft;\n      auditPassed = parsed.audit_passed === true || parsed.audit_passed === 'true';\n      const failedCount = (parsed.failed_items || []).length;\n      auditFailedItems = failedCount >= 3\n        ? 'FULL REVIEW REQUIRED — ' + (parsed.failed_items || []).join(', ')\n        : (parsed.failed_items || []).join(', ') || null;\n    } else {\n      auditFailedItems = 'AUDIT PARSE ERROR — draft field missing';\n    }\n  } catch(e) {\n    auditFailedItems = 'AUDIT PARSE ERROR — invalid JSON from audit call';\n  }\n} else {\n  auditFailedItems = 'AUDIT PARSE ERROR — empty audit response';\n}\nif (!publicDraft || publicDraft.length < 20)\n  throw new Error('No valid public_response_draft available from generation or audit.');\n\nconst internalDraft = inp.generation_internal;\n\nconst closings = inp.confirmed_response_tier === 'T1'\n  ? ['Warm regards', 'Warmly', 'Cheers!', 'Have the best day!']\n  : ['Warm regards', 'Sincerely', 'With appreciation'];\n\nconst rdaRecordId = inp.bra_record_id;\nconst closingIndex = rdaRecordId % closings.length;\nconst closing = closings[closingIndex];\n\nconst bv = typeof inp.brand_voice === 'string'\n  ? JSON.parse(inp.brand_voice)\n  : inp.brand_voice;\nconst brandSignature = bv?.['Client Name'] || inp.client_id || 'VRYOH Intelligence';\n\nconst finalDraft = publicDraft.trim() + '\\n\\n' + closing + ',\\n' + brandSignature;\n\nreturn [{ json: {\n  bra_record_id: inp.bra_record_id,\n  confirmed_response_tier: inp.confirmed_response_tier,\n  governance_flag: inp.governance_flag,\n  human_review_required: inp.human_review_required,\n  solution_type: inp.solution_type,\n  emotional_axis: inp.emotional_axis,\n  pain_axis: inp.pain_axis,\n  stability_axis: inp.stability_axis,\n  signal_based_consideration: inp.signal_based_consideration,\n  tone_style: inp.tone_style,\n  urgency_level: inp.urgency_level,\n  commercial_risk_flag: inp.commercial_risk_flag,\n  behavioral_interpretation: inp.behavioral_interpretation,\n  lang: inp.lang,\n  client_id: inp.client_id,\n  enriched_emotion_tag: inp.enriched_emotion_tag,\n  enriched_pain_point: inp.enriched_pain_point,\n  pain_point_sub_category: inp.pain_point_sub_category,\n  signal_type: inp.signal_type,\n  intensity_level: inp.intensity_level,\n  hsi_record_id: inp.hsi_record_id,\n  ess_record_id: inp.ess_record_id,\n  eip_record_id: inp.eip_record_id,\n  ala_record_id: inp.ala_record_id,\n  prior_run_id: inp.prior_run_id,\n  reviewer_handle: inp.reviewer_handle,\n  emotion_hypothesis: inp.emotion_hypothesis,\n  keywords: inp.keywords,\n  brand_voice: inp.brand_voice,\n  brand_voice_brief: inp.brand_voice_brief,\n  lang_resolved: inp.lang_resolved,\n  audit_passed: auditPassed,\n  audit_failed_items: auditFailedItems,\n  public_response_draft: finalDraft,\n  internal_followup_draft: internalDraft\n} }];"
