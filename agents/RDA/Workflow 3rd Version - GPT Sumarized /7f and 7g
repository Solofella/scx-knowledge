        "jsCode": "const response = $input.first().json;\nconst raw = response.content?.[0]?.text;\nif (!raw || raw.trim().length < 20)\n  throw new Error('SEO Governance Claude call returned empty or too short. Response: ' + JSON.stringify(response).substring(0, 200));\n\nconst public_response_draft = raw.trim();\nconst inp = $('Step 7e - Parse Body + Build SEO/Governance Prompt3').first().json;\n\nconst internal_system_prompt =\n'Role: Write a 3-5 sentence internal signal interpretation for the client management team. Explain what the guest signal means, not what the team should do.\\n\\n' +\n\n'Include: the guest\\'s emotional state and drivers, what the signal reveals about the guest-brand relationship, recurrence/stability context (first visit, repeat guest, or pattern), and any loyalty or behavioral risk indicators.\\n\\n' +\n\n'Do not include: recommendations, operational directives, action items, headings, prescriptive language, or generic filler.\\n\\n' +\n\n'Output: Return plain text only. No JSON, preamble, or explanation.';\n\nconst internal_user_prompt =\n`RESPONSE TIER: ${inp.confirmed_response_tier}\\n` +\n`SIGNAL TYPE: ${inp.signal_type}\\n` +\n`INTENSITY LEVEL: ${inp.intensity_level}\\n` +\n`URGENCY: ${inp.urgency_level}\\n` +\n`LANGUAGE: ${inp.lang_resolved}\\n\\n` +\n`SIGNAL ANALYSIS:\\n` +\n` Emotional axis: ${inp.emotional_axis}\\n` +\n` Pain axis: ${inp.pain_axis}\\n` +\n` Stability axis: ${inp.stability_axis}\\n` +\n` Signal-Based Consideration: ${inp.signal_based_consideration}\\n` +\n` Emotion hypothesis: ${inp.emotion_hypothesis || 'Not available'}\\n` +\n` Enriched emotion tag: ${inp.enriched_emotion_tag || 'Not available'}\\n` +\n` Pain point sub-category: ${inp.pain_point_sub_category || 'Not available'}\\n` +\n` Signal enrichment: ${inp.signal_enrichment_brief || 'Not available'}\\n\\n` +\n(inp.behavioral_interpretation ? `BEHAVIORAL CONTEXT: ${inp.behavioral_interpretation}\\n\\n` : '') +\n`Write the internal brief. Return plain text only.`;\n\nconst internal_prompt_body = JSON.stringify({\n  model: 'claude-sonnet-4-6',\n  max_tokens: 400,\n  temperature: 0,\n  system: internal_system_prompt,\n  messages: [{ role: 'user', content: internal_user_prompt }]\n});\n\nreturn [{ json: {\n  bra_record_id: inp.bra_record_id,\n  confirmed_response_tier: inp.confirmed_response_tier,\n  governance_flag: inp.governance_flag,\n  human_review_required: inp.human_review_required,\n  solution_type: inp.solution_type,\n  emotional_axis: inp.emotional_axis,\n  pain_axis: inp.pain_axis,\n  stability_axis: inp.stability_axis,\n  signal_based_consideration: inp.signal_based_consideration,\n  tone_style: inp.tone_style,\n  urgency_level: inp.urgency_level,\n  commercial_risk_flag: inp.commercial_risk_flag,\n  behavioral_interpretation: inp.behavioral_interpretation,\n  lang: inp.lang,\n  client_id: inp.client_id,\n  enriched_emotion_tag: inp.enriched_emotion_tag,\n  enriched_pain_point: inp.enriched_pain_point,\n  pain_point_sub_category: inp.pain_point_sub_category,\n  signal_type: inp.signal_type,\n  intensity_level: inp.intensity_level,\n  hsi_record_id: inp.hsi_record_id,\n  ess_record_id: inp.ess_record_id,\n  eip_record_id: inp.eip_record_id,\n  ala_record_id: inp.ala_record_id,\n  prior_run_id: inp.prior_run_id,\n  reviewer_handle: inp.reviewer_handle,\n  emotion_hypothesis: inp.emotion_hypothesis,\n  keywords: inp.keywords,\n  brand_voice: inp.brand_voice,\n  brand_voice_brief: inp.brand_voice_brief,\n  lang_resolved: inp.lang_resolved,\n  opening_sentence: inp.opening_sentence,\n  public_response_draft: public_response_draft,\n  internal_prompt_body: internal_prompt_body\n} }];"
