const inp = $('Step 7a - Build Opening Prompt1').first().json;
const raw = $input.first().json;
const opening_sentence = raw.content?.[0]?.text?.trim();
if (!opening_sentence || opening_sentence.length < 5)
  throw new Error('opening_sentence missing at Step 7c. bra_record_id: ' + inp.bra_record_id);

const bv = typeof inp.brand_voice === 'string' ? JSON.parse(inp.brand_voice) : inp.brand_voice;
const tier = inp.confirmed_response_tier;

const tierCeiling = tier === 'T1' ? 3 : tier === 'T2' ? 4 : 5;
const tierRule = tier === 'T1'
  ? 'Maximum 3 sentences total including the opening. Hard ceiling. Count to 3 — delete everything after.'
  : tier === 'T2'
  ? 'Maximum 4 sentences total including the opening. Hard ceiling. Count to 4 — delete everything after.'
  : 'Maximum 5 sentences total including the opening. Hard ceiling. Count to 5 — delete everything after.';

const tierCompletionRule = tier === 'T1'
  ? `T1 COMPLETION:
Write 1-2 sentences after the opening. ${tierCeiling} sentences total. Hard ceiling.
Filters — apply only what the review demands:
- Opening names a staff member: include that name naturally once in the body if room exists. Do not add a sentence just for this.
- Review contains minor criticism alongside positive sentiment: acknowledge it by name in one sentence. Do not add this sentence if no criticism exists.
- Final sentence: must reference something the guest actually said, described, or experienced. If nothing specific exists — one brief sincere sentence. Not a formula.`

  : tier === 'T2'
  ? `T2 COMPLETION:
Write 1-3 sentences after the opening. ${tierCeiling} sentences total. Hard ceiling.
Each sentence must introduce a dimension the previous did not cover. If you cannot introduce a new dimension — stop.
Name what the guest experienced specifically — not a category.
Acknowledge without asserting full understanding. Preserve ambiguity.
Final sentence: direct contact invitation — generic language only. No email, URL, or named channel.`

  : `T3 COMPLETION:
Write 2-4 sentences after the opening. ${tierCeiling} sentences total. Hard ceiling.
Each sentence serves one purpose in order: (1) acknowledge the specific harm, (2) acknowledge scope or impact, (3) offer direct private contact.
Never restate. Never use a generic apology. Never "We apologize for any inconvenience."
Contact offer: generic language only. No email, URL, or named channel.`;

const body_system_prompt =
`You are the Draft Body Builder for VRYOH RDA. Complete a hospitality response draft using the opening sentence provided. One job only.

CRITICAL OPENING RULE — NON-NEGOTIABLE:
Begin with the opening sentence exactly word for word. Do not paraphrase, improve, or rewrite it. Your first word must be the first word of that sentence.

${tierCompletionRule}

PADDING TEST — before returning:
For each sentence after the opening ask: does this sentence introduce something — a fact, a feeling, an acknowledgment, an action — that no previous sentence covered? If no, or if it restates the same idea in different words — delete it.

CLOSING RULE:
The closing sentence must reference something the guest actually said, described, or experienced. Never repeat a noun already used in the opening.
If no specific referent exists in the review — close with one brief sincere sentence. Not a formula. Not an invented detail.
These constructions always fail regardless of what follows:
- "we hope the food brings you back"
- "we hope to see you again soon"
- "we look forward to welcoming you back"
- "Esperamos verte de nuevo pronto"
- Any closing naming content not present in the guest's review

TONE: Apply tone_style from the user prompt exactly.
Empathetic-Formal: warm, structured, formal register, no contractions.
Empathetic-Warm: conversational, genuine, contractions allowed.
Neutral-Professional: measured, factual, acknowledge without amplifying.
Dignity-Restorative: specific, human, non-formulaic, acknowledge the actual experience.

BRAND VOICE:
- First-person plural using person_preference throughout.
- Formality: match formality_level (1=very casual, 5=very polished).
- Brand phrases: at most ONE from brand_phrases_include, only when natural. If none fit — omit.
- Never use any word from brand_phrases_avoid or vocabulary_restrictions.
- Never invent menu items, differentiators, or cultural claims not in the review or brand brief.

PROHIBITION:
Never use "señal" as a classification noun for the guest's review — use "reseña", "visita", "experiencia", or "comentario". Natural Spanish metaphor use is acceptable.
Never reference "tier", "T1", "T2", "T3", "pipeline", "audit", or "draft".
Named individuals: use he/she — never "they" for a single named person unless the guest signals non-binary preference.

RETURN plain text only. No JSON, no preamble, no explanation.
Start with the opening sentence exactly as provided.

LANGUAGE: If the LANGUAGE field in the user prompt is "es", write the entire response in Spanish.

Si el idioma es español: usa tu habilidad nativa en español. Escribe como un profesional de hospitalidad hispanohablante nativo — no traduzcas desde el inglés, piensa directamente en español. Español ligero, directo, amable, al punto. Una idea por oración. Si una oración explica la anterior — elimínala. Nada de justificaciones. Nada de contexto que el huésped no haya dado. Aplica todas las reglas de tono, voz de marca y gobernanza en español.`;

const body_user_prompt =
`TIER RULE — APPLY FIRST: ${tierRule}\n\n` +
`OPENING SENTENCE (copy exactly as line 1):\n${opening_sentence}\n\n` +
`RESPONSE TIER: ${tier}\n` +
`TONE STYLE: ${inp.tone_style}\n` +
`LANGUAGE: ${inp.lang_resolved}\n\n` +
`BRAND VOICE BRIEF:\n` +
` Register: ${bv.the_register || 'Not specified'}\n` +
` Core Driver: ${bv.the_core_driver || 'Not specified'}\n` +
` Regional Accent: ${bv.the_regional_accent || 'Not specified'}\n` +
` Recovery Protocol: ${bv.recovery_protocol || 'Not specified'}\n` +
` Brand Personality: ${bv.tone_descriptors || 'Not specified'}\n` +
` Formality Level: ${bv.formality_level || '3'}\n` +
` Person Preference: ${bv.person_preference || 'our team'}\n` +
` Guest Should Feel: ${bv.guest_feeling || 'Valued'}\n` +
` Differentiator: ${bv.differentiator || 'Not specified'}\n` +
` Brand Phrases To Include: ${bv.brand_phrases_include || 'None'}\n` +
` Brand Phrases To Avoid: ${bv.brand_phrases_avoid || 'None'}\n` +
` Negative Response Approach: ${bv.vocabulary_restrictions || 'Not specified'}\n` +
` Commitments NEVER To Make: ${bv.commitment_restrictions || 'None'}\n\n` +
`RESPONSE STRATEGY:\n` +
` Emotional axis: ${inp.emotional_axis}\n` +
` Pain axis: ${inp.pain_axis}\n` +
` Stability axis: ${inp.stability_axis}\n` +
` Signal-Based Consideration: ${inp.signal_based_consideration}\n` +
` Solution type: ${inp.solution_type}\n\n` +
`SIGNAL DETAIL:\n` +
` Emotion hypothesis: ${inp.emotion_hypothesis || 'Not available'}\n` +
` Keywords: ${inp.keywords || 'Not available'}\n\n` +
(inp.behavioral_interpretation ? `BEHAVIORAL CONTEXT: ${inp.behavioral_interpretation}\n\n` : '') +
`Complete the response. Plain text only. Start with the opening sentence.`;

const body_prompt_body = JSON.stringify({
  model: 'claude-sonnet-4-6',
  max_tokens: 500,
  temperature: 0.5,
  system: body_system_prompt,
  messages: [{ role: 'user', content: body_user_prompt }]
});

return [{ json: {
  bra_record_id:              inp.bra_record_id,
  confirmed_response_tier:    tier,
  governance_flag:            inp.governance_flag,
  human_review_required:      inp.human_review_required,
  solution_type:              inp.solution_type,
  emotional_axis:             inp.emotional_axis,
  pain_axis:                  inp.pain_axis,
  stability_axis:             inp.stability_axis,
  signal_based_consideration: inp.signal_based_consideration,
  tone_style:                 inp.tone_style,
  urgency_level:              inp.urgency_level,
  commercial_risk_flag:       inp.commercial_risk_flag,
  behavioral_interpretation:  inp.behavioral_interpretation,
  lang:                       inp.lang,
  lang_resolved:              inp.lang_resolved,
  client_id:                  inp.client_id,
  enriched_emotion_tag:       inp.enriched_emotion_tag,
  enriched_pain_point:        inp.enriched_pain_point,
  pain_point_sub_category:    inp.pain_point_sub_category,
  signal_type:                inp.signal_type,
  intensity_level:            inp.intensity_level,
  hsi_record_id:              inp.hsi_record_id,
  ess_record_id:              inp.ess_record_id,
  eip_record_id:              inp.eip_record_id,
  ala_record_id:              inp.ala_record_id,
  prior_run_id:               inp.prior_run_id,
  reviewer_handle:            inp.reviewer_handle,
  emotion_hypothesis:         inp.emotion_hypothesis,
  keywords:                   inp.keywords,
  brand_voice:                inp.brand_voice,
  opening_sentence:           opening_sentence,
  body_prompt_body:           body_prompt_body
} }];
