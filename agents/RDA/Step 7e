const response = $input.first().json;
const raw = response.content?.[0]?.text;
if (!raw || raw.trim().length < 20)
  throw new Error('Body Claude call returned empty or too short. Response: ' + JSON.stringify(response).substring(0, 200));

const raw_body_draft = raw.trim();
const inp = $('Step 7c - Parse Opening + Build Body Prompt').first().json;
const bv = inp.brand_voice;

const seo_system_prompt = `Your role: refine a draft that already reads as written by a person. Your changes must preserve that quality — never mechanize it. If a SEO keyword disrupts the human quality of the draft, omit it.

You are the SEO and Governance Layer for SubtextCX RDA. You receive a completed hospitality response draft. Your job is three tasks only:

TASK 1 — SEO INTEGRATION:
If seo_keywords are provided, weave 1-2 of the most contextually relevant keywords naturally into the draft. Keywords must appear as part of a genuine sentence — never listed, never forced, never at the expense of tone or human naturalness. If no keyword fits naturally without disrupting the draft, do not add any.

TASK 2 — GOVERNANCE CHECK:
Verify the draft contains none of the following. If any are present, remove or replace them:
- Any email address
- Any URL
- Any placeholder text such as [contact], [name], [email]
- The phrase "We apologize for any inconvenience"
- Any specific refund amounts, voucher offers, discount commitments, or financial commitments
- Any reference to named contact channels such as "our website", "our profile", "our direct messaging"
Generic contact invitations such as "please reach out to us directly" or "we would welcome the opportunity to speak with you" are permitted for T2 and T3 records — do not remove these.

TASK 3 — GUEST NAME CHECK:
The guest name is provided in the GUEST NAME field. If the guest name is available (not "Not available") and is absent from the draft entirely, insert it in the opening line. For T1 records: insert "[Name]," at the start of the opening sentence. For T2 and T3 records: insert "Hello [Name] —" before the existing opening content. Do not rewrite anything else.

RETURN the final draft as plain text only — no JSON, no preamble, no explanation.
If no changes are needed, return the draft exactly as received.
LANGUAGE: The draft may be in any language. Apply all three tasks in the same language as the draft. Do not translate. Return the draft in its original language.`

const seo_user_prompt =
`DRAFT TO REVIEW:\n${raw_body_draft}\n\n` +
`RESPONSE TIER: ${inp.confirmed_response_tier}\n` +
`GUEST NAME: ${(inp.reviewer_handle && !inp.reviewer_handle.toLowerCase().includes('review') && !inp.reviewer_handle.toLowerCase().startsWith('anonymous')) ? inp.reviewer_handle : 'Not available'}\n` +
`SEO KEYWORDS: ${bv.seo_keywords || 'none specified'}\n\n` +
`Apply all three tasks. Return plain text only.`;

const seo_prompt_body = JSON.stringify({
  model: 'claude-sonnet-4-6',
  max_tokens: 600,
  temperature: 0,
  system: seo_system_prompt,
  messages: [{ role: 'user', content: seo_user_prompt }]
});

return [{ json: {
  bra_record_id: inp.bra_record_id,
  confirmed_response_tier: inp.confirmed_response_tier,
  governance_flag: inp.governance_flag,
  human_review_required: inp.human_review_required,
  solution_type: inp.solution_type,
  emotional_axis: inp.emotional_axis,
  pain_axis: inp.pain_axis,
  stability_axis: inp.stability_axis,
  signal_based_consideration: inp.signal_based_consideration,
  tone_style: inp.tone_style,
  urgency_level: inp.urgency_level,
  commercial_risk_flag: inp.commercial_risk_flag,
  behavioral_interpretation: inp.behavioral_interpretation,
  lang: inp.lang,
  client_id: inp.client_id,
  enriched_emotion_tag: inp.enriched_emotion_tag,
  enriched_pain_point: inp.enriched_pain_point,
  pain_point_sub_category: inp.pain_point_sub_category,
  signal_type: inp.signal_type,
  intensity_level: inp.intensity_level,
  hsi_record_id: inp.hsi_record_id,
  ess_record_id: inp.ess_record_id,
  eip_record_id: inp.eip_record_id,
  ala_record_id: inp.ala_record_id,
  prior_run_id: inp.prior_run_id,
  reviewer_handle: inp.reviewer_handle,
  emotion_hypothesis: inp.emotion_hypothesis,
  keywords: inp.keywords,
  brand_voice: inp.brand_voice,
  lang_resolved: inp.lang_resolved,
  opening_sentence: inp.opening_sentence,
  raw_body_draft: raw_body_draft,
  seo_prompt_body: seo_prompt_body
} }];
