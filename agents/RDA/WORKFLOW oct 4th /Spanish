{
      "parameters": {
        "jsCode": "const inp = $input.first().json;\nlet draft = inp.public_response_draft;\nconst tier = inp.confirmed_response_tier;\nconst deterministicFailures = [];\n\nlet humanReviewRequired = inp.human_review_required;\n\nif (tier === 'T2') {\n  const contactRegex = /contáctenos|comuníquese con nosotros|escríbanos|háblenos|póngase en contacto/i;\n  if (!contactRegex.test(draft)) {\n    deterministicFailures.push('T2 FALTA INVITACIÓN DE CONTACTO (marcado — no autocorregido)');\n    humanReviewRequired = true;\n  }\n}\n\nlet auditFailedItems = inp.audit_failed_items;\nif (deterministicFailures.length > 0) {\n  const newItems = deterministicFailures.join(' | ');\n  auditFailedItems = auditFailedItems\n    ? auditFailedItems + ' | DETERMINISTIC: ' + newItems\n    : 'DETERMINISTIC: ' + newItems;\n}\n\nreturn [{ json: {\n  bra_record_id: inp.bra_record_id,\n  confirmed_response_tier: inp.confirmed_response_tier,\n  governance_flag: inp.governance_flag,\n  human_review_required: humanReviewRequired,\n  solution_type: inp.solution_type,\n  emotional_axis: inp.emotional_axis,\n  pain_axis: inp.pain_axis,\n  stability_axis: inp.stability_axis,\n  signal_based_consideration: inp.signal_based_consideration,\n  tone_style: inp.tone_style,\n  urgency_level: inp.urgency_level,\n  commercial_risk_flag: inp.commercial_risk_flag,\n  behavioral_interpretation: inp.behavioral_interpretation,\n  lang: inp.lang,\n  lang_resolved: inp.lang_resolved,\n  client_id: inp.client_id,\n  enriched_emotion_tag: inp.enriched_emotion_tag,\n  enriched_pain_point: inp.enriched_pain_point,\n  pain_point_sub_category: inp.pain_point_sub_category,\n  signal_type: inp.signal_type,\n  intensity_level: inp.intensity_level,\n  hsi_record_id: inp.hsi_record_id,\n  ess_record_id: inp.ess_record_id,\n  eip_record_id: inp.eip_record_id,\n  ala_record_id: inp.ala_record_id,\n  prior_run_id: inp.prior_run_id,\n  reviewer_handle: inp.reviewer_handle,\n  emotion_hypothesis: inp.emotion_hypothesis,\n  keywords: inp.keywords,\n  brand_voice: inp.brand_voice,\n  brand_voice_brief: inp.brand_voice_brief,\n  audit_passed: inp.audit_passed,\n  seo_keywords_used: inp.seo_keywords_used,\n  audit_failed_items: auditFailedItems,\n  public_response_draft: draft\n} }];"
