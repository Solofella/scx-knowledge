    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst raw = response.content?.[0]?.text;\nif (!raw || raw.trim().length < 20)\n  throw new Error('Body Claude call returned empty or too short. Response: ' + JSON.stringify(response).substring(0, 200));\n\nconst raw_body_draft = raw.trim();\nconst inp = $('Step 7c - Parse Opening + Build Body Prompt2').first().json;\nconst bv = inp.brand_voice;\n\nconst seo_system_prompt = `Your role: refine a draft that already reads as written by a person. Your changes must preserve that quality — never mechanize it. If a SEO keyword disrupts the human quality of the draft, omit it.\n\nYou are the SEO and Governance Layer for VRYOH RDA. You receive a completed hospitality response draft. Your job is three tasks only:\n\nTASK 1 — SEO INTEGRATION:\nIf seo_keywords are provided, weave 1-2 of the most contextually relevant keywords naturally into the draft. Keywords must appear as part of a genuine sentence — never listed, never forced, never at the expense of tone or human naturalness. If no keyword fits naturally without disrupting the draft, do not add any.\n\nTASK 2 — GOVERNANCE CHECK:\nVerify the draft contains none of the following. If any are present, remove or replace them:\n- Any email address\n- Any URL\n- Any placeholder text such as [contact], [name], [email]\n- The phrase \"We apologize for any inconvenience\"\n- Any specific refund amounts, voucher offers, discount commitments, or financial commitments\n- Any reference to named contact channels such as \"our website\", \"our profile\", \"our direct messaging\"\nGeneric contact invitations such as \"please reach out to us directly\" or \"we would welcome the opportunity to speak with you\" are permitted for T2 and T3 records — do not remove these.\n\nTASK 3 — GUEST NAME CHECK:\nThe guest name is provided in the GUEST NAME field. If the guest name is available (not \"Not available\") and is absent from the draft entirely, insert it in the opening line. For T1 records: insert \"[Name],\" at the start of the opening sentence. For T2 and T3 records: insert \"Hello [Name] —\" before the existing opening content. Do not rewrite anything else.\n\nRETURN the final draft as plain text only — no JSON, no preamble, no explanation.\nIf no changes are needed, return the draft exactly as received.`;\n\nconst seo_user_prompt =\n`DRAFT TO REVIEW:\\n${raw_body_draft}\\n\\n` +\n`RESPONSE TIER: ${inp.confirmed_response_tier}\\n` +\n`GUEST NAME: ${(inp.reviewer_handle && !inp.reviewer_handle.toLowerCase().includes('review') && !inp.reviewer_handle.toLowerCase().startsWith('anonymous')) ? inp.reviewer_handle : 'Not available'}\\n` +\n`SEO KEYWORDS: ${bv.seo_keywords || 'none specified'}\\n\\n` +\n`Apply all three tasks. Return plain text only.`;\n\nconst seo_prompt_body = JSON.stringify({\n  model: 'claude-sonnet-4-6',\n  max_tokens: 600,\n  temperature: 0,\n  system: seo_system_prompt,\n  messages: [{ role: 'user', content: seo_user_prompt }]\n});\n\nreturn [{ json: {\n  bra_record_id: inp.bra_record_id,\n  confirmed_response_tier: inp.confirmed_response_tier,\n  governance_flag: inp.governance_flag,\n  human_review_required: inp.human_review_required,\n  solution_type: inp.solution_type,\n  emotional_axis: inp.emotional_axis,\n  pain_axis: inp.pain_axis,\n  stability_axis: inp.stability_axis,\n  signal_based_consideration: inp.signal_based_consideration,\n  tone_style: inp.tone_style,\n  urgency_level: inp.urgency_level,\n  commercial_risk_flag: inp.commercial_risk_flag,\n  behavioral_interpretation: inp.behavioral_interpretation,\n  lang: inp.lang,\n  client_id: inp.client_id,\n  enriched_emotion_tag: inp.enriched_emotion_tag,\n  enriched_pain_point: inp.enriched_pain_point,\n  pain_point_sub_category: inp.pain_point_sub_category,\n  signal_type: inp.signal_type,\n  intensity_level: inp.intensity_level,\n  hsi_record_id: inp.hsi_record_id,\n  ess_record_id: inp.ess_record_id,\n  eip_record_id: inp.eip_record_id,\n  ala_record_id: inp.ala_record_id,\n  prior_run_id: inp.prior_run_id,\n  reviewer_handle: inp.reviewer_handle,\n  emotion_hypothesis: inp.emotion_hypothesis,\n  keywords: inp.keywords,\n  brand_voice: inp.brand_voice,\n  brand_voice_brief: inp.brand_voice_brief,\n  lang_resolved: inp.lang_resolved,\n  opening_sentence: inp.opening_sentence,\n  raw_body_draft: raw_body_draft,\n  seo_prompt_body: seo_prompt_body\n} }];"
