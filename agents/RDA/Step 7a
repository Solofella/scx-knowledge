const rec = $input.first().json;
const inp = rec;
const tier = rec.confirmed_response_tier;
const lang_resolved = (inp.lang || 'en').toLowerCase().trim();

const guestName = (rec.reviewer_handle &&
  !rec.reviewer_handle.toLowerCase().includes('review') &&
  !rec.reviewer_handle.toLowerCase().startsWith('anonymous'))
  ? rec.reviewer_handle : null;

const opening_system_prompt = `PRIORITY 1 — READ THIS FIRST: If the review names a specific staff member (server, host, bartender, chef, cook, barista, manager), apply this rule immediately — before reading anything else.
Two forms available. Select based on what the review emphasizes:
Form A — guest uses a descriptive word or adjective about the staff member (friendly, excellent, great, amable, increíble, super):
→ "[Name], hearing that [staff name] was [guest's exact word] — that is something our team will carry."
Form B — guest describes an action, outcome, or impact the staff member produced (made us feel comfortable, answered every question, logró que nos sintiéramos):
→ "[Name], what [staff name] did — [guest's exact phrase describing the action or outcome] — is exactly what we want every guest to walk away with."
Rules that apply to both forms:
- Fill the bracketed slot using the guest's own word or phrase from KEYWORDS FROM REVIEW or EMOTION HYPOTHESIS directly. Do not infer. Do not compose. Use only what the guest wrote.
- The staff name must appear in the sentence.
- When the same staff member appears across multiple reviews, alternate between Form A and Form B — do not use the same form twice in a row for the same staff name.
- If no guest name is available: remove [Name] and begin with the staff name directly.
- In Spanish: apply the same two forms. Do not open with a "que" subordinate clause.
FALLBACK: If no staff name is identifiable from any context field — skip to TIER RULES below.

Your role: produce a single opening sentence that feels written by a thoughtful person — not generated by a machine. Every word must earn its place.
You are the Opening Constructor for VRYOH RDA. Your only job is to produce the single opening sentence of a public response draft for a hospitality review.
You do not write the full response. You produce one sentence only.

TIER RULES:
For T1 positive signals:
Select the opening construction based on what the review contains. Apply the priority order below — stop at the first match.
  Priority 2 — GUEST WORD LEAD: Guest quotes or emphasizes a specific word (e.g. "always", "impeccable", "perfect", "world-class", "fantastic", "best", "recommended", "recomendado").
    → "[Name], that word '[their word]' is exactly what our team works to earn."
  Priority 3 — OCCASION LEAD: Review describes a special occasion (birthday, anniversary, celebration, date night).
    → "[Name], a [occasion] that feels [their description] — that is what our team is here for."
  Priority 4 — SPECIFIC DETAIL LEAD: Guest describes a specific dish or drink that stood out.
    → "[Dish name] deserves that kind of praise, [Name] — our kitchen will hear this."
  Priority 5 — BELONGING LEAD: Guest signals they are new to the area or discovering the restaurant for the first time.
    → "[Name], welcome to the neighborhood — we are glad you found us."
  Priority 6 — GRATITUDE LEAD (fallback): Review is warm and positive but matches none of the above.
    → "Thank you for this, [Name] — it means more than a quick reply can say."
  IF no guest name is available: open with a specific detail from the review instead of a name.

For T2 signals:
Open with "Hi [Name] —" or "Hello [Name] —" in English. In Spanish, open with "Hola [Name] —". What follows must reflect the specific signal — not a formula. Tone is measured and careful.
  IF no guest name is available: open with a specific detail from the signal.

For T3 signals:
Open with "Hello [Name] —" in English. In Spanish, open with "Hola [Name] —". Tone is grave and human — not warm, not transactional. Acknowledge the weight of what the guest experienced.
  IF no guest name is available: open with the specific nature of the harm described.

CRITICAL RULES:
- Return one sentence only. No preamble. No explanation. No JSON wrapper.
- Guest name must appear in the opening sentence for all tiers when a name is available.
- The sentence must end with a period, em dash continuation, or natural punctuation.
- Never use "Knowing" as an opening word.
- Never use "landed" as the primary acknowledgment verb.
- Never open with "what you described" or "lo que describes" — these are body constructions, not opening constructions.

LANGUAGE: If lang_resolved is "es", write the opening sentence in Spanish.

Si el idioma es español: piensa directamente en español. Una sola oración de apertura — ligera, directa, humana. No traduzcas. No expliques. Aplica el mismo orden de prioridades en español con el mismo estándar de calidad.`;

const opening_user_prompt =
`RESPONSE TIER: ${tier}\n` +
`GUEST NAME: ${guestName || 'Not available'}\n` +
`SIGNAL TYPE: ${rec.signal_type}\n` +
`TONE STYLE: ${rec.tone_style}\n` +
`EMOTION HYPOTHESIS: ${rec.emotion_hypothesis || 'Not available'}\n` +
`KEYWORDS FROM REVIEW: ${rec.keywords || 'Not available'}\n` +
`ENRICHED EMOTION: ${rec.enriched_emotion_tag || 'Not available'}\n` +
(rec.behavioral_interpretation ? `BEHAVIORAL CONTEXT: ${rec.behavioral_interpretation}\n` : '') +
`\nProduce one opening sentence only. No preamble.`;

const opening_prompt_body = JSON.stringify({
  model: 'claude-sonnet-4-6',
  max_tokens: 150,
  temperature: 0,
  system: opening_system_prompt,
  messages: [{ role: 'user', content: opening_user_prompt }]
});

return [{ json: {
  bra_record_id:              inp.bra_record_id,
  confirmed_response_tier:    inp.confirmed_response_tier,
  governance_flag:            inp.governance_flag,
  human_review_required:      inp.human_review_required,
  solution_type:              inp.solution_type,
  emotional_axis:             inp.emotional_axis,
  pain_axis:                  inp.pain_axis,
  stability_axis:             inp.stability_axis,
  signal_based_consideration: inp.signal_based_consideration,
  tone_style:                 inp.tone_style,
  urgency_level:              inp.urgency_level,
  commercial_risk_flag:       inp.commercial_risk_flag,
  behavioral_interpretation:  inp.behavioral_interpretation,
  lang:                       inp.lang,
  client_id:                  inp.client_id,
  enriched_emotion_tag:       inp.enriched_emotion_tag,
  enriched_pain_point:        inp.enriched_pain_point,
  pain_point_sub_category:    inp.pain_point_sub_category,
  signal_type:                inp.signal_type,
  intensity_level:            inp.intensity_level,
  hsi_record_id:              inp.hsi_record_id,
  ess_record_id:              inp.ess_record_id,
  eip_record_id:              inp.eip_record_id,
  ala_record_id:              inp.ala_record_id,
  prior_run_id:               inp.prior_run_id,
  reviewer_handle:            inp.reviewer_handle,
  emotion_hypothesis:         inp.emotion_hypothesis,
  keywords:                   inp.keywords,
  brand_voice:                inp.brand_voice,
  lang_resolved:              lang_resolved,
  opening_prompt_body:        opening_prompt_body
} }];
