        "jsCode": "const response = $input.first().json;\nconst raw = response.content?.[0]?.text;\nconst inp = $('Step 9b - Build Audit Prompt').first().json;\n\nlet auditPassed = false;\nlet auditFailedItems = null;\nlet publicDraft = inp.generation_draft;\n\nif (raw) {\n  let clean = raw.replace(/`{1,3}json/gi, '').replace(/`{1,3}/g, '').trim();\n  try {\n    const parsed = JSON.parse(clean);\n    if (parsed.final_public_response_draft && parsed.final_public_response_draft.length >= 20) {\n      publicDraft = parsed.final_public_response_draft;\n      auditPassed = parsed.audit_passed === true || parsed.audit_passed === 'true';\n      const failedCount = (parsed.failed_items || []).length;\n      auditFailedItems = failedCount >= 3\n        ? 'FULL REVIEW REQUIRED — ' + (parsed.failed_items || []).join(', ')\n        : (parsed.failed_items || []).join(', ') || null;\n    } else {\n      auditFailedItems = 'AUDIT PARSE ERROR — draft field missing';\n    }\n  } catch(e) {\n    auditFailedItems = 'AUDIT PARSE ERROR — invalid JSON from audit call';\n  }\n} else {\n  auditFailedItems = 'AUDIT PARSE ERROR — empty audit response';\n}\n\nif (!publicDraft || publicDraft.length < 20)\n  throw new Error('No valid public_response_draft available from generation or audit.');\n\nconst internalDraft = inp.generation_internal;\n\n// Signature closing variations (deterministic rotation)\nconst closingsEN = ['Warm regards', 'Warmly', 'Cheers!', 'Have the best day!'];\nconst closingsES = ['Atentamente', 'Cordialmente', 'Hasta pronto', 'Con gusto'];\nconst closings = (inp.lang_resolved || 'en').toLowerCase() === 'es' ? closingsES : closingsEN;\nconst rdaRecordId = inp.bra_record_id; // deterministic seed\nconst closingIndex = rdaRecordId % closings.length;\nconst closing = closings[closingIndex];\n\n// Brand signature from Client Config\nconst bv = typeof inp.brand_voice === 'string' \n  ? JSON.parse(inp.brand_voice) \n  : inp.brand_voice;\n\nconst brandSignature = bv?.['Client Name