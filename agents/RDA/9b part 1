const rawText = alaRecord['Raw Tex'] || alaRecord['Raw Text'] || 'Not available';
const publicDraft = inp.public_response_draft || '';
const internalDraft = inp.internal_followup_draft || '';

if (!publicDraft || publicDraft.length < 20)
  throw new Error('public_response_draft missing at Step 9b. ala_record_id: ' + inp.ala_record_id);
if (!internalDraft || internalDraft.length < 10)
  throw new Error('internal_followup_draft missing at Step 9b. ala_record_id: ' + inp.ala_record_id);

// Recent openings extraction — audit item 10 (OPENING REPETITION)
const recentList = (recentRecords.list || []);
const recentOpenings = [];
