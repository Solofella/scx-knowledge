        "jsCode": "const inp = $input.first().json;\n\nconst bv = inp.brand_voice || {};\n\nconst registerVal = bv.the_register || '';\nconst coreDriverVal = bv.the_core_driver || '';\nconst regionalAccentVal = bv.the_regional_accent || '';\nconst personalityVal = bv.tone_descriptors || '';\nconst formalityVal = bv.formality_level || '';\nconst personPreferenceVal = bv.person_preference || '';\nconst negativeResponseVal = bv.response_negative_experience || '';\nconst guestFeelVal = bv.guest_feeling || '';\nconst recoveryProtocolVal = bv.recovery_protocol || '';\nconst differentiatorVal = bv.differentiator || '';\nconst phrasesIncludeVal = bv.brand_phrases_include || '';\nconst phrasesAvoidVal = bv.brand_phrases_avoid || '';\n\nconst briefLines = [];\nbriefLines.push('REGISTER: ' + registerVal);\nbriefLines.push('CORE DRIVER: ' + coreDriverVal);\nbriefLines.push('REGIONAL ACCENT: ' + regionalAccentVal);\nbriefLines.push('PERSONALITY: ' + personalityVal);\nbriefLines.push('FORMALITY: ' + formalityVal);\nbriefLines.push('PERSON PREFERENCE: ' + personPreferenceVal);\nbriefLines.push('RESPONSE TO NEGATIVE EXPERIENCE: ' + negativeResponseVal);\nbriefLines.push('GUEST SHOULD FEEL: ' + guestFeelVal);\nbriefLines.push('RECOVERY PROTOCOL: ' + recoveryProtocolVal);\nbriefLines.push('DIFFERENTIATOR: ' + differentiatorVal);\nbriefLines.push('BRAND PHRASES TO INCLUDE: ' + phrasesIncludeVal);\nbriefLines.push('BRAND PHRASES TO AVOID: ' + phrasesAvoidVal);\n\nconst brandVoiceBrief = briefLines.join('\\n');\n\nconst out = {};\nconst inpKeys = Object.keys(inp);\nfor (let i = 0; i < inpKeys.length; i++) {\n  const k = inpKeys[i];\n  out[k] = inp[k];\n}\nout.brand_voice_brief = brandVoiceBrief;\n\nreturn [{ json: out }];"
