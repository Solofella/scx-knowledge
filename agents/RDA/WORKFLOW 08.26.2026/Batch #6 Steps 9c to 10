        "jsCode": "const inp = $input.first().json;\n\nlet draft = inp.public_response_draft;\nconst tier = inp.confirmed_response_tier;\nconst deterministicFailures = [];\n\nconst landedRegex = /\\blanded\\b/gi;\nconst landingRegex = /\\blanding\\b/gi;\nif (landedRegex.test(draft)) {\n  draft = draft.replace(landedRegex, 'came together');\n  deterministicFailures.push('BANNED WORD: landed (auto-corrected)');\n}\nif (landingRegex.test(draft)) {\n  draft = draft.replace(landingRegex, 'coming together');\n  deterministicFailures.push('BANNED WORD: landing (auto-corrected)');\n}\n\nlet humanReviewRequired = inp.human_review_required;\n\nif (tier === 'T2') {\n  const contactRegex = /reach out|contact us|hear from you|get in touch|speak with you|follow up on this/i;\n  if (!contactRegex.test(draft)) {\n    deterministicFailures.push('T2 MISSING CONTACT INVITATION (flagged — not auto-corrected)');\n    humanReviewRequired = true;\n  }\n}\n\nconst nearMissRegex = /\\bwe (genuinely |truly )?(carry|will carry)\\b/i;\nif (nearMissRegex.test(draft)) {\n  deterministicFailures.push('NEAR-MISS PHRASE: \"carry\" construction close to banned pattern (flagged for review)');\n  humanReviewRequired = true;\n}\n\nlet auditFailedItems = inp.audit_failed_items;\nif (deterministicFailures.length > 0) {\n  const newItems = deterministicFailures.join(' | ');\n  auditFailedItems = auditFailedItems\n    ? auditFailedItems + ' | DETERMINISTIC: ' + newItems\n    : 'DETERMINISTIC: ' + newItems;\n}\n\nreturn [{ json: {\n  bra_record_id: inp.bra_record_id,\n  confirmed_response_tier: inp.confirmed_response_tier,\n  governance_flag: inp.governance_flag,\n  human_review_required: humanReviewRequired,\n  solution_type: inp.solution_type,\n  emotional_axis: inp.emotional_axis,\n  pain_axis: inp.pain_axis,\n  stability_axis: inp.stability_axis,\n  signal_based_consideration: inp.signal_based_consideration,\n  tone_style: inp.tone_style,\n  urgency_level: inp.urgency_level,\n  commercial_risk_flag: inp