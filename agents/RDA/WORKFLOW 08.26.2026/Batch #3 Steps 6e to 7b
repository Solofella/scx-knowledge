      "parameters": {
        "jsCode": "const inp = $('Step 6a — Brand Voice Consolidation').first().json;\n\nconst eipData = $('Step 6b — Fetch EIP Signal Data').first().json;\nconst eipList = eipData.list || [];\nconst eipRow = eipList.length > 0 ? eipList[0] : {};\n\nconst emotionData = $('Step 6c — Fetch Emotion Dictionary Row').first().json;\nconst emotionList = emotionData.list || [];\nconst emotionRow = emotionList.length > 0 ? emotionList[0] : {};\n\nconst painData = $('Step 6d — Fetch Pain Point Master Row').first().json;\nconst painList = painData.list || [];\nconst painRow = painList.length > 0 ? painList[0] : {};\n\nconst cognitiveDriverVal = eipRow['Cognitive Driver'] || '';\nconst needStateVal = eipRow['Need State'] || '';\nconst commonExpressionsVal = emotionRow['Common Expressions'] || '';\nconst operationalSignalVal = painRow['Operational Signal'] || '';\nconst emotionalSignalVal = painRow['Emotional Signal'] || '';\nconst sampleExpressionVal = painRow['Sample User Expression'] || '';\n\nconst briefLines = [];\nbriefLines.push('COGNITIVE DRIVER: ' + cognitiveDriverVal);\nbriefLines.push('NEED STATE: ' + needStateVal);\nbriefLines.push('COMMON EXPRESSIONS: ' + commonExpressionsVal);\nbriefLines.push('OPERATIONAL SIGNAL: ' + operationalSignalVal);\nbriefLines.push('EMOTIONAL SIGNAL: ' + emotionalSignalVal);\nbriefLines.push('SAMPLE EXPRESSION: ' + sampleExpressionVal);\n\nconst signalEnrichmentBrief = briefLines.join('\\n');\n\nconst out = {};\nconst inpKeys = Object.keys(inp);\nfor (let i = 0; i < inpKeys.length; i++) {\n  const k = inpKeys[i];\n  out[k] = inp[k];\n}\nout.signal_enrichment_brief = signalEnrichmentBrief;\n\nreturn [{ json: out }];"
