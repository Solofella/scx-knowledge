const rec = $input.first().json;
const bv = rec.brand_voice;
const lang = rec.lang || bv.language || 'en';

const tier = rec.confirmed_response_tier;
const guestName = (rec.reviewer_handle &&
  !rec.reviewer_handle.toLowerCase().includes('review') &&
  !rec.reviewer_handle.toLowerCase().startsWith('anonymous'))
  ? rec.reviewer_handle : null;

const opening_system_prompt = `Your role: produce a single opening sentence that feels written by a thoughtful person — not generated by a machine. Every word must earn its place.

You are the Opening Constructor for VRYOH RDA. Your only job is to produce the single opening sentence of a public response draft for a hospitality review.

You do not write the full response. You produce one sentence only.

BRAND VOICE — THIS SHAPES YOUR SENTENCE:
Use the Brand Voice attributes (Register, Core Driver, Regional Accent, Personality, and Differentiator) to shape the tone, rhythm, and wording of the opening sentence. Write as the brand would naturally speak—not in a generic voice. Let the target Guest Feeling guide the emotional impact, expressing it through specific language rather than explicitly naming it. Demonstrate this qualities through specific detail — never name the category label itself.

GUEST NAME: Always address the guest by name when is available.

SIGNAL CHECKLIST — identify which applies, in this order, stop at first match. This tells you WHAT to notice — the brand voice above tells you HOW to write it:

For T1 positive signals:
  1. NAMED STAFF: The review names a specific staff member (server, host, bartender, chef). Write about this in the opening.
  2. SPECIFIC DETAIL: The guest describes a specific dish or drink that stood out. Write about this in the opening.
  3. GRATITUDE (fallback): Warm and positive, none of the above apply. Write a sincere, specific opening reaction.
  IF no guest name is available: open with the anchor detail instead of a name.

  ALSO DETECT (do not write about these in the opening — note them for the body):
  - OCCASION: The review describes a special occasion (birthday, anniversary, celebration, date night).
  - BELONGING: The guest signals they are new to the area or discovering the restaurant for the first time.

For T2 signals: open with Hi or Hello followed by the guest name. What follows must reflect the specific signal — not a formula. Tone is measured and careful.
  IF no guest name is available: open with a specific detail from the signal.

For T3 signals: open with Hello followed by the guest name. Tone is grave and human — not warm, not transactional. Acknowledge the weight of what the guest experienced.
  IF no guest name is available: open with the specific nature of the harm described.

CRITICAL RULES:
- Return one sentence only. No preamble. No explanation. No JSON wrapper.
- The guest name MUST appear in the opening sentence for all tiers when a name is available.
- The sentence must end with a period, em dash continuation, or natural punctuation.
- Never use "Knowing" as an opening word.
- Never use "landed" as the primary acknowledgment verb.
- Do not use a fixed sentence structure — construct the sentence fresh each time, guided by brand voice and the identified signal.`;

const opening_user_prompt =
`RESPONSE TIER: ${tier}\n` +
`GUEST NAME: ${guestName || 'Not available'}\n` +
`SIGNAL TYPE: ${rec.signal_type}\n` +
`TONE STYLE: ${rec.tone_style}\n` +
`EMOTION HYPOTHESIS: ${rec.emotion_hypothesis || 'Not available'}\n` +
`KEYWORDS FROM REVIEW: ${rec.keywords || 'Not available'}\n` +
`ENRICHED EMOTION: ${rec.enriched_emotion_tag || 'Not available'}\n` +
`SIGNAL ENRICHMENT: ${rec.signal_enrichment_brief || 'Not available'}\n` +
(rec.behavioral_interpretation ? `BEHAVIORAL CONTEXT: ${rec.behavioral_interpretation}\n` : '') +
`\nBRAND VOICE BRIEF:\n${rec.brand_voice_brief || ''}\n` +
`\nProduce one opening sentence only. No preamble.`;

const opening_prompt_body = JSON.stringify({
  model: 'claude-sonnet-4-6',
  max_tokens: 150,
  temperature: 0,
  system: opening_system_prompt,
  messages: [{ role: 'user', content: opening_user_prompt }]
});

return [{ json: {
  bra_record_id: rec.bra_record_id,
  confirmed_response_tier: rec.confirmed_response_tier,
  governance_flag: rec.governance_flag,
  human_review_required: rec.human_review_required,
  solution_type: rec.solution_type,
  emotional_axis: rec.emotional_axis,
  pain_axis: rec.pain_axis,
  stability_axis: rec.stability_axis,
  signal_based_consideration: rec.signal_based_consideration,
  tone_style: rec.tone_style,
  urgency_level: rec.urgency_level,
  commercial_risk_flag: rec.commercial_risk_flag,
  behavioral_interpretation: rec.behavioral_interpretation,
  lang: lang,
  client_id: rec.client_id,
  enriched_emotion_tag: rec.enriched_emotion_tag,
  enriched_pain_point: rec.enriched_pain_point,
  pain_point_sub_category: rec.pain_point_sub_category,
  signal_type: rec.signal_type,
  intensity_level: rec.intensity_level,
  hsi_record_id: rec.hsi_record_id,
  ess_record_id: rec.ess_record_id,
  eip_record_id: rec.eip_record_id,
  ala_record_id: rec.ala_record_id,
  prior_run_id: rec.prior_run_id,
  reviewer_handle: rec.reviewer_handle,
  emotion_hypothesis: rec.emotion_hypothesis,
  keywords: rec.keywords,
  brand_voice: rec.brand_voice,
  brand_voice_brief: rec.brand_voice_brief,
  signal_enrichment_brief: rec.signal_enrichment_brief,
  lang_resolved: lang,
  opening_prompt_body: opening_prompt_body
} }];
