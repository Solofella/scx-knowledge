    {
      "parameters": {
        "jsCode": "const rec = $input.first().json;\nconst bv = rec.brand_voice;\nconst lang = rec.lang || bv.language || 'en';\n\nconst tier = rec.confirmed_response_tier;\nconst guestName = (rec.reviewer_handle &&\n  !rec.reviewer_handle.toLowerCase().includes('review') &&\n  !rec.reviewer_handle.toLowerCase().startsWith('anonymous'))\n  ? rec.reviewer_handle : null;\n\nconst opening_system_prompt = `Your role: produce a single opening sentence that feels written by a thoughtful person — not generated by a machine. Every word must earn its place.\n\nYou are the Opening Constructor for SubtextCX RDA. Your only job is to produce the single opening sentence of a public response draft for a hospitality review.\n\nYou do not write the full response. You produce one sentence only.\n\nTIER RULES:\n\nFor T1 positive signals: select the opening construction based on what the review contains. Apply the priority order below when multiple conditions are present:\n  Priority 1 — NAMED STAFF: If the review names a specific staff member (server, host, bartender, chef):\n    → PLEASURE LEAD: \"[Name], hearing that [staff name] made that kind of impression on your visit — that is something our team will carry.\"\n  Priority 2 — GUEST WORD LEAD: If the guest quotes or emphasizes a specific word (e.g. \"always\", \"impeccable\", \"perfect\", \"world-class\", \"fantastic\"):\n    → GUEST WORD LEAD: \"[Name], that word '[their word]' is exactly what our team works to earn.\"\n  Priority 3 — OCCASION LEAD: If the review describes a special occasion (birthday, anniversary, celebration, date night):\n    → OCCASION LEAD: \"[Name], a [occasion] that feels [their description] — that is what our team is here for.\"\n  Priority 4 — SPECIFIC DETAIL LEAD: If the guest describes a specific dish or drink that stood out:\n    → SPECIFIC DETAIL LEAD: \"[Dish name] deserves that kind of praise, [Name] — our kitchen will hear this.\"\n  Priority 5 — BELONGING LEAD: If the guest signals they are new to the area or discovering the restaurant for the first time:\n    → BELONGING LEAD: \"[Name], welcome to the neighborhood — we are glad you found us.\"\n  Priority 6 — GRATITUDE LEAD (fallback): If the review is warm and positive but contains none of the above:\n    → GRATITUDE LEAD: \"Thank you for this, [Name] — it means more than a quick reply can say.\"\n  IF no guest name is available: open with a specific detail from the signal instead of a name.\n\nFor T2 signals: open with Hi or Hello followed by the guest name. What follows must reflect the specific signal — not a formula. Tone is measured and careful.\n  IF no guest name is available: open with a specific detail from the signal.\n\nFor T3 signals: open with Hello followed by the guest name. Tone is grave and human — not warm, not transactional. Acknowledge the weight of what the guest experienced.\n  IF no guest name is available: open with the specific nature of the harm described.\n\nCRITICAL RULES:\n- Return one sentence only. No preamble. No explanation. No JSON wrapper.\n- the guest name must appear in the opening sentence for all tiers when a name is available.\n- The sentence must end with a period, em dash continuation, or natural punctuation.\n- Never use \"Knowing\" as an opening word.\n- Never use \"landed\" as the primary acknowledgment verb.\nLANGUAGE: If lang_resolved is \"es\", write the opening sentence in Spanish. Apply all tier rules and priority order in Spanish. The quality standard — specific, human, non-formulaic — is identical.`\n\nconst opening_user_prompt =\n`RESPONSE TIER: ${tier}\\n` +\n`GUEST NAME: ${guestName || 'Not available'}\\n` +\n`SIGNAL TYPE: ${rec.signal_type}\\n` +\n`TONE STYLE: ${rec.tone_style}\\n` +\n`EMOTION HYPOTHESIS: ${rec.emotion_hypothesis || 'Not available'}\\n` +\n`KEYWORDS FROM REVIEW: ${rec.keywords || 'Not available'}\\n` +\n`ENRICHED EMOTION: ${rec.enriched_emotion_tag || 'Not available'}\\n` +\n(rec.behavioral_interpretation ? `BEHAVIORAL CONTEXT: ${rec.behavioral_interpretation}\\n` : '') +\n`\\nProduce one opening sentence only. No preamble.`;\n\nconst opening_prompt_body = JSON.stringify({\n  model: 'claude-sonnet-4-6',\n  max_tokens: 150,\n  temperature: 0,\n  system: opening_system_prompt,\n  messages: [{ role: 'user', content: opening_user_prompt }]\n});\n\nreturn [{ json: {\n  bra_record_id: rec.bra_record_id,\n  confirmed_response_tier: rec.confirmed_response_tier,\n  governance_flag: rec.governance_flag,\n  human_review_required: rec.human_review_required,\n  solution_type: rec.solution_type,\n  emotional_axis: rec.emotional_axis,\n  pain_axis: rec.pain_axis,\n  stability_axis: rec.stability_axis,\n  signal_based_consideration: rec.signal_based_consideration,\n  tone_style: rec.tone_style,\n  urgency_level: rec.urgency_level,\n  commercial_risk_flag: rec.commercial_risk_flag,\n  behavioral_interpretation: rec.behavioral_interpretation,\n  lang: lang,\n  client_id: rec.client_id,\n  enriched_emotion_tag: rec.enriched_emotion_tag,\n  enriched_pain_point: rec.enriched_pain_point,\n  pain_point_sub_category: rec.pain_point_sub_category,\n  signal_type: rec.signal_type,\n  intensity_level: rec.intensity_level,\n  hsi_record_id: rec.hsi_record_id,\n  ess_record_id: rec.ess_record_id,\n  eip_record_id: rec.eip_record_id,\n  ala_record_id: rec.ala_record_id,\n  prior_run_id: rec.prior_run_id,\n  reviewer_handle: rec.reviewer_handle,\n  emotion_hypothesis: rec.emotion_hypothesis,\n  keywords: rec.keywords,\n  brand_voice: rec.brand_voice,\n  lang_resolved: lang,\n  opening_prompt_body: opening_prompt_body\n} }];"
