      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst rec = response.list?.[0];\n\nif (!rec) throw new Error('Client Config not found. Check client_id: '\n  + $('Step 2 - Payload Validation').first().json.client_id);\n\nconst ms = function(val) {\n  return Array.isArray(val) ? val.join(', ') : (val || null);\n};\n\nconst brand_voice = {\n  Client_ID:               rec['Client ID'],\n  'Client Name':           rec['Client Name'] || null,\n  tone_descriptors:        ms(rec['Brand Personality']),\n  response_negative_experience: rec['Response for a negative experience'] || null,\n  formality_level:         rec['Formality Level'] || '3 — Balanced',\n  person_preference:       rec['Person Preference'] || null,\n  brand_phrases_include:   ms(rec['Brand Phrases To Include']),\n  brand_phrases_avoid:     ms(rec['Brand Phrases To Avoid']),\n  language:                ms(rec['Language']) || 'en',\n  seo_keywords:            rec['SEO Keywords'] || null,\n  approval_contact_email:  rec['Approval Contact Email'] || null,\n  recovery_protocol:       rec['THE RECOVERY PROTOCOL - How you handle negative or mixed reviews *'] || null,\n  guest_feeling:           ms(rec['Guests feeling after reading a response']),\n  commitment_restrictions: ms(rec['Commitments should NEVER be made']),\n  differentiator:          ms(rec['Differentiator']),\n  the_register:            rec['THE REGISTER - Your default communication style *'] || null,\n  the_core_driver:         rec['THE CORE DRIVER - What your responses champion most *'] || null,\n  the_regional_accent:     rec['THE REGIONAL ACCENT - Your cultural and geographic tone *'] || null\n};\n\nconst inp = $('Step 2 - Payload Validation').first().json;\n\nreturn [{ json: {\n  bra_record_id:              inp.bra_record_id,\n  confirmed_response_tier:    inp.confirmed_response_tier,\n  governance_flag:            inp.governance_flag,\n  human_review_required:      inp.human_review_required,\n  solution_type:              inp.solution_type,\n  emotional_axis:             inp.emotional_axis,\n  pain_axis:                  inp.pain_axis,\n  stability_axis:             inp.stability_axis,\n  signal_based_consideration: inp.signal_based_consideration,\n  tone_style:                 inp.tone_style,\n  urgency_level:              inp.urgency_level,\n  commercial_risk_flag:       inp.commercial_risk_flag,\n  behavioral_interpretation:  inp.behavioral_interpretation,\n  lang:                       inp.lang,\n  reviewer_handle:            inp.reviewer_handle,\n  client_id:                  inp.client_id,\n  enriched_emotion_tag:       inp.enriched_emotion_tag,\n  enriched_pain_point:        inp.enriched_pain_point,\n  pain_point_sub_category:    inp.pain_point_sub_category,\n  signal_type:                inp.signal_type,\n  intensity_level:            inp.intensity_level,\n  hsi_record_id:              inp.hsi_record_id,\n  ess_record_id:              inp.ess_record_id,\n  eip_record_id:              inp.eip_record_id,\n  ala_record_id:              inp.ala_record_id,\n  prior_run_id:               inp.prior_run_id,\n  emotion_hypothesis:         inp.emotion_hypothesis,\n  keywords:                   inp.keywords,\n  brand_voice:                brand_voice\n} }];"
