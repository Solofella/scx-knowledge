import React, { useState, useEffect } from 'react';
import { 
  ShieldCheck, 
  Search, 
  MessageSquare, 
  Mail, 
  Clock, 
  Layout, 
  CheckCircle, 
  Users, 
  LineChart, 
  Zap,
  Globe,
  Star,
  ChevronRight,
  Monitor,
  Sparkles,
  Loader2,
  AlertTriangle,
  Send,
  RefreshCw,
  BrainCircuit,
  Copy
} from 'lucide-react';

// Gemini API Configuration
const apiKey = ""; 
const MODEL_NAME = "gemini-2.5-flash-preview-09-2025";

const App = () => {
  const [activeTab, setActiveTab] = useState('brochure'); 
  const [view, setView] = useState('outer'); 
  
  // Lab State
  const [reviewInput, setReviewInput] = useState("");
  const [analysis, setAnalysis] = useState(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);

  // New Brand Palette Colors
  const BrandHeading = "text-[#2E3C4E]";
  const BrandBody = "text-[#384653]";
  const BrandLink = "text-[#3A6B7E]";
  const BrandPrimaryAccent = "#64B8CE";
  const BrandSecondaryAccent = "#C3643D"; // Terracotta
  const BrandLightBlue = "#C7E0E7";
  const BrandDeepSlate = "bg-[#2E3C4E]";
  const BrandGradient = "bg-gradient-to-r from-[#C7E0E7] to-[#64B8CE]";

  // API Helper
  const callGemini = async (userQuery, systemPrompt, isJson = true) => {
    let delay = 1000;
    for (let i = 0; i < 5; i++) {
      try {
        const payload = {
          contents: [{ parts: [{ text: userQuery }] }],
          systemInstruction: { parts: [{ text: systemPrompt }] },
          ...(isJson && {
            generationConfig: {
              responseMimeType: "application/json",
              responseSchema: {
                type: "OBJECT",
                properties: {
                  explicit: { type: "string" },
                  implicit: { type: "string" },
                  masked: { type: "string" },
                  risk_level: { type: "string" },
                  risk_reason: { type: "string" },
                  suggested_draft: { type: "string" }
                }
              }
            }
          })
        };

        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${MODEL_NAME}:generateContent?key=${apiKey}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (!response.ok) throw new Error('API request failed');
        
        const result = await response.json();
        const content = result.candidates?.[0]?.content?.parts?.[0]?.text;
        return isJson ? JSON.parse(content) : content;
      } catch (err) {
        if (i === 4) throw err;
        await new Promise(resolve => setTimeout(resolve, delay));
        delay *= 2;
      }
    }
  };

  const handleAnalyze = async () => {
    if (!reviewInput.trim()) return;
    setLoading(true);
    setError(null);
    setAnalysis(null);

    const systemPrompt = `You are SubtextCX Signal Intelligence. Analyze the provided hospitality review for three layers:
    1. Explicit: Facts stated clearly.
    2. Implicit: Subtext, tone, and comparative language.
    3. Masked: Sarcasm, deflection, or "polite dissatisfaction" indicating high churn risk.
    Determine the 'risk_level' (Low, Medium, High) based on these signals and draft a response that addresses the MASKED sentiment.
    Return JSON.`;

    try {
      const data = await callGemini(reviewInput, systemPrompt);
      setAnalysis(data);
    } catch (err) {
      setError("Analysis failed. Please try again.");
    } finally {
      setLoading(false);
    }
  };

  const generateSampleReview = () => {
    const samples = [
      "The room was fine, I guess. We found some other options for next time though. Staff were professional.",
      "Beautiful lobby. The wait for the elevator was a bit longer than expected but it's okay. Hope the renovation finishes soon.",
      "Thanks for the stay. It wasn't quite what we remembered from 2022, but the breakfast was decent."
    ];
    setReviewInput(samples[Math.floor(Math.random() * samples.length)]);
  };

  const Panel = ({ children, className = "" }) => (
    <div className={`w-full min-h-[600px] p-8 flex flex-col relative overflow-hidden ${className}`}>
      {children}
    </div>
  );

  const SectionTitle = ({ children }) => (
    <h3 className={`text-xs font-bold uppercase tracking-[0.2em] mb-4 text-[#3A6B7E]`}>
      {children}
    </h3>
  );

  return (
    <div className="min-h-screen bg-slate-50 p-4 md:p-8 font-['Roboto'] text-[#384653]">
      {/* Dynamic Font Styling */}
      <style>
        {`
          @import url('https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap');
          @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap');
          
          h1, h2, h3, h4, .heading {
            font-family: 'Plus Jakarta Sans', sans-serif; /* Best web fallback for Host Grotesk */
            font-weight: 500;
          }
          body {
            font-family: 'Roboto', sans-serif;
          }
        `}
      </style>

      {/* Main Navigation */}
      <div className="max-w-6xl mx-auto mb-6 flex flex-col items-center">
        <div className="flex bg-white p-1 rounded-xl shadow-sm border border-slate-200 mb-4">
          <button 
            onClick={() => setActiveTab('brochure')}
            className={`px-6 py-2 rounded-lg transition-all text-sm font-bold flex items-center gap-2 ${activeTab === 'brochure' ? `bg-[#2E3C4E] text-white shadow-md` : 'text-[#384653] hover:bg-slate-50'}`}
          >
            <Layout size={18} />
            Digital Brochure
          </button>
          <button 
            onClick={() => setActiveTab('lab')}
            className={`px-6 py-2 rounded-lg transition-all text-sm font-bold flex items-center gap-2 ${activeTab === 'lab' ? `bg-[#2E3C4E] text-white shadow-md` : 'text-[#384653] hover:bg-slate-50'}`}
          >
            <Sparkles size={18} className={activeTab === 'lab' ? 'text-[#C7E0E7]' : ''} />
            Signal Lab ✨
          </button>
        </div>

        {activeTab === 'brochure' && (
          <div className="bg-white p-1 rounded-full shadow-sm border border-slate-200">
            <button onClick={() => setView('outer')} className={`px-4 py-1.5 rounded-full text-xs font-semibold ${view === 'outer' ? `bg-[#64B8CE] text-white` : 'text-[#384653]'}`}>Outer Panels</button>
            <button onClick={() => setView('inner')} className={`px-4 py-1.5 rounded-full text-xs font-semibold ${view === 'inner' ? `bg-[#64B8CE] text-white` : 'text-[#384653]'}`}>Inner Panels</button>
          </div>
        )}
      </div>

      <div className="max-w-7xl mx-auto">
        {activeTab === 'brochure' ? (
          <div className="bg-white shadow-2xl rounded-sm overflow-hidden flex flex-col md:flex-row min-h-[700px]">
            {view === 'outer' ? (
              <>
                {/* PANEL 3 (Left Outer - BACK) */}
                <Panel className="border-r border-slate-100 bg-[#C7E0E7]/10">
                  <div className="mt-auto">
                    <SectionTitle>Next Steps</SectionTitle>
                    <h2 className={`text-2xl font-bold mb-6 ${BrandHeading}`}>Ready to see what you're missing?</h2>
                    <ul className="space-y-4 mb-12">
                      {["Complete Brand Voice Discovery (30 min)", "We integrate your review data", "First batch delivered in 5 days", "Weekly cadence begins"].map((step, i) => (
                        <li key={i} className="flex items-start gap-3 text-sm">
                          <div className={`mt-1 h-2 w-2 rounded-full bg-[#64B8CE]`} />
                          <span>{step}</span>
                        </li>
                      ))}
                    </ul>
                    <div className="p-6 bg-white border border-slate-100 rounded-lg shadow-sm">
                      <p className="text-xs uppercase tracking-widest text-[#3A6B7E] mb-2 font-bold">Contact</p>
                      <p className={`font-bold ${BrandHeading}`}>miguel@solofella.com</p>
                      <p className="text-sm text-[#3A6B7E]">subtextcx.com</p>
                    </div>
                  </div>
                </Panel>

                {/* PANEL 2 (Center Outer - MIDDLE) */}
                <Panel className="border-r border-slate-100">
                  <div className="absolute top-0 right-0 p-8 opacity-5"><ShieldCheck size={120} color="#2E3C4E" /></div>
                  <SectionTitle>The Problem</SectionTitle>
                  <h2 className={`text-3xl font-bold leading-tight mb-8 ${BrandHeading}`}>Your best customers are leaving — your team has no idea why.</h2>
                  <div className="space-y-8">
                    {[
                      { t: "Masked Truths", d: "Polite reviews mask real problems." },
                      { t: "Inconsistency", d: "Different managers = inconsistent brand voice." },
                      { t: "Hidden Data", d: "Review patterns hide in plain sight." },
                      { t: "The Gap", d: "What the review says ≠ what it actually signals." }
                    ].map((item, i) => (
                      <div key={i} className="group">
                        <p className={`text-sm font-bold uppercase text-[#C3643D] mb-1`}>{item.t}</p>
                        <p className="text-[#384653] leading-relaxed">{item.d}</p>
                      </div>
                    ))}
                  </div>
                  <div className="mt-auto pt-8 border-t border-slate-100 flex items-center gap-2 text-slate-400 italic text-sm">
                    <Search size={16} />
                    <span>Detection is the first step to protection.</span>
                  </div>
                </Panel>

                {/* PANEL 1 (Right Outer - COVER) */}
                <Panel className={`${BrandDeepSlate} text-white`}>
                  <div className="absolute inset-0 opacity-10 bg-[url('https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&q=80&w=1000')] bg-cover" />
                  <div className="relative z-10 flex flex-col h-full">
                    <div className={`w-20 h-1 ${BrandGradient} mb-12`} />
                    <h1 className="text-5xl font-bold tracking-tight mb-4 text-[#C7E0E7]">SubtextCX</h1>
                    <p className={`text-[#64B8CE] font-bold uppercase tracking-widest text-xs mb-12`}>Governed Review Responses & Guest Signal Intelligence</p>
                    <h2 className="text-3xl font-light italic mb-8 border-l-2 border-[#C7E0E7]/40 pl-6">"Know What Your Guests Meant. <br/><span className="font-bold not-italic text-[#C7E0E7]">Protect Every Response."</span></h2>
                    <div className="mt-auto space-y-4">
                      <div className="inline-block px-4 py-1 border border-[#C7E0E7]/30 rounded text-xs font-bold uppercase tracking-widest text-[#C7E0E7]">Pilot Program 2026</div>
                      <p className="text-sm opacity-50 font-light">Solofella LLC</p>
                    </div>
                  </div>
                </Panel>
              </>
            ) : (
              <>
                {/* PANEL 4 (Left Inner) */}
                <Panel className="border-r border-slate-100">
                  <SectionTitle>What It Detects</SectionTitle>
                  <h3 className={`font-bold text-lg mb-4 ${BrandHeading}`}>3 Signal Layers:</h3>
                  <div className="space-y-4 mb-8">
                    {[
                      { label: "Explicit", desc: "Direct praise or criticism" },
                      { label: "Implicit", desc: "Tone, word choice, comparative language" },
                      { label: "Masked", desc: "Sarcasm, deflection, polite dissatisfaction" }
                    ].map((item, i) => (
                      <div key={i} className="flex gap-3 items-start">
                        <div className={`w-2 h-2 rounded-full mt-2 bg-[#64B8CE]`} />
                        <div><span className={`font-bold block ${BrandHeading}`}>{item.label}</span><span className="text-sm text-slate-500">{item.desc}</span></div>
                      </div>
                    ))}
                  </div>
                  <h3 className={`font-bold text-lg mb-4 pt-4 border-t border-slate-100 ${BrandHeading}`}>What You Get:</h3>
                  <ul className="space-y-4 mb-8">
                    {["Unified platform view (Google, OpenTable, Yelp, TripAdvisor)", "On-brand responses that show you listened", "Signal patterns to act on before problems scale"].map((text, i) => (
                      <li key={i} className="flex items-start gap-2 text-sm">
                        <CheckCircle size={16} className="text-[#64B8CE] mt-0.5 shrink-0" />
                        <span>{text}</span>
                      </li>
                    ))}
                  </ul>
                  <div className="mt-auto p-4 bg-[#C7E0E7]/10 rounded-lg border-l-4 border-[#64B8CE] italic text-xs font-semibold text-[#2E3C4E]">"No B2B SaaS has shipped dual-instrument masked emotion detection."</div>
                </Panel>

                {/* PANEL 5 (Center Inner) */}
                <Panel className="border-r border-slate-100 bg-slate-50">
                  <SectionTitle>How It Works</SectionTitle>
                  <div className="space-y-4 mb-8">
                    {[
                      { n: "1", t: "COLLECT", d: "Unified intake, language detection, deduplication" },
                      { n: "2", t: "DECODE", d: "Detect masked emotions, map signals, identify patterns" },
                      { n: "3", t: "DRAFT", d: "Generate brand-voice responses calibrated to signal tier" },
                      { n: "4", t: "DELIVER", d: "Weekly briefs, monthly reports, daily summaries" }
                    ].map((item, i) => (
                      <div key={i} className="flex gap-4 p-3 bg-white rounded shadow-sm border border-slate-100">
                        <span className={`text-xl font-black text-[#64B8CE]`}>{item.n}</span>
                        <div><p className={`text-xs font-bold ${BrandHeading}`}>{item.t}</p><p className="text-[11px] text-slate-500 leading-tight">{item.d}</p></div>
                      </div>
                    ))}
                  </div>
                  <p className="text-[10px] text-center uppercase tracking-widest text-[#C3643D] font-bold mb-6">Human approval required at every stage.</p>
                  <SectionTitle>What You Receive</SectionTitle>
                  <div className="space-y-4">
                    {[
                      { t: "Response Drafts", d: "Calibrated brand voice, 48-hour SLA" },
                      { t: "Weekly Brief", d: "Pain points, distribution, priority alerts" },
                      { t: "Monthly Report", d: "Friction analysis, dignity-risk flags" }
                    ].map((item, i) => (
                      <div key={i} className="border-b border-slate-200 pb-2 last:border-0">
                        <p className={`text-xs font-bold ${BrandHeading}`}>{item.t}</p><p className="text-xs text-slate-500">{item.d}</p>
                      </div>
                    ))}
                  </div>
                </Panel>

                {/* PANEL 6 (Right Inner) */}
                <Panel>
                  <SectionTitle>Your Daily Workflow</SectionTitle>
                  <div className="flex items-center gap-3 mb-6">
                    <Clock className="text-[#C3643D]" size={24} />
                    <div><p className={`font-bold ${BrandHeading}`}>10 minutes per day.</p><p className="text-xs text-slate-500">4 simple steps.</p></div>
                  </div>
                  <div className="space-y-3 mb-8">
                    {[
                      { s: "RECEIVE", d: "7am email with all platforms" },
                      { s: "REVIEW", d: "Read reviews + drafts in Sheets" },
                      { s: "APPROVE", d: "Approve as-is, customize, or reject" },
                      { s: "PUBLISH", d: "Paste into original platform" }
                    ].map((item, i) => (
                      <div key={i} className="flex gap-3 text-xs leading-tight">
                        <span className={`font-bold text-[#3A6B7E] min-w-[60px]`}>{item.s}</span>
                        <span className="text-slate-600">{item.d}</span>
                      </div>
                    ))}
                  </div>
                  <div className="p-4 bg-[#C7E0E7]/10 rounded-lg mb-8"><SectionTitle>Efficiency Gains</SectionTitle>
                    <ul className="space-y-2">
                      {["Unified view", "SEO integration", "Brand consistency"].map((text, i) => (
                        <li key={i} className="flex items-center gap-2 text-xs font-medium"><Zap size={12} className="text-[#64B8CE]" />{text}</li>
                      ))}
                    </ul>
                  </div>
                  <div className="mt-auto pt-4 border-t border-slate-100">
                    <p className="text-[10px] font-bold uppercase text-slate-400 mb-1">Governance</p>
                    <p className="text-xs text-slate-500 italic leading-snug">SubtextCX detects and interprets signals only. It never prescribes operational actions.</p>
                  </div>
                </Panel>
              </>
            )}
          </div>
        ) : (
          /* LAB VIEW */
          <div className="grid md:grid-cols-2 gap-8">
            <div className="space-y-6">
              <div className="bg-white rounded-2xl p-8 shadow-xl border border-slate-100">
                <div className="flex items-center justify-between mb-6">
                  <h2 className={`text-2xl font-bold ${BrandHeading}`}>Intelligence Lab ✨</h2>
                  <button 
                    onClick={generateSampleReview}
                    className="text-xs font-bold text-[#64B8CE] uppercase tracking-widest hover:underline flex items-center gap-1"
                  >
                    <RefreshCw size={12} />
                    Sample Review
                  </button>
                </div>
                
                <p className="text-sm text-slate-500 mb-4 italic">
                  Analyze hospitality reviews for masked churn signals.
                </p>

                <textarea 
                  className="w-full h-40 p-4 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-[#64B8CE] focus:outline-none transition-all resize-none"
                  placeholder="Paste a review here..."
                  value={reviewInput}
                  onChange={(e) => setReviewInput(e.target.value)}
                />

                <button 
                  onClick={handleAnalyze}
                  disabled={loading || !reviewInput}
                  className={`w-full mt-6 py-4 rounded-xl font-bold text-white flex items-center justify-center gap-2 transition-all shadow-lg ${loading || !reviewInput ? 'bg-slate-300' : 'bg-[#2E3C4E] hover:bg-[#3A6B7E] active:scale-[0.98]'}`}
                >
                  {loading ? <Loader2 className="animate-spin" /> : <Sparkles className="text-[#C7E0E7]" />}
                  {loading ? 'Processing Signals...' : 'Analyze Intelligence ✨'}
                </button>
                
                {error && (
                  <div className="mt-4 p-3 bg-red-50 text-red-600 text-xs rounded-lg flex items-center gap-2">
                    <AlertTriangle size={14} /> {error}
                  </div>
                )}
              </div>

              <div className={`rounded-2xl p-6 shadow-xl relative overflow-hidden ${BrandDeepSlate} text-white`}>
                <div className="absolute top-0 right-0 p-4 opacity-10"><BrainCircuit size={80} color="#C7E0E7" /></div>
                <h3 className="font-bold text-[#C7E0E7] uppercase tracking-widest text-xs mb-3">Governance Alert</h3>
                <p className="text-sm leading-relaxed opacity-70">
                  SubtextCX is analyzing sentiment vectors across unified hospitality platforms. Output is restricted to signal mapping and brand-voice calibration.
                </p>
              </div>
            </div>

            <div className="space-y-6">
              {analysis ? (
                <div className="space-y-6 animate-in fade-in slide-in-from-bottom-4 duration-500">
                  {/* Risk Alert */}
                  <div className={`p-5 rounded-2xl border-l-8 flex items-center justify-between shadow-sm ${
                    analysis.risk_level === 'High' ? 'bg-red-50 border-[#C3643D]' : 
                    analysis.risk_level === 'Medium' ? 'bg-orange-50 border-[#C3643D]/50' : 'bg-green-50 border-[#64B8CE]'
                  }`}>
                    <div>
                      <p className="text-[10px] font-bold uppercase tracking-widest text-slate-500">Signal Priority</p>
                      <p className={`text-lg font-black ${BrandHeading}`}>{analysis.risk_level} Churn Risk ✨</p>
                    </div>
                    <AlertTriangle className={analysis.risk_level === 'High' ? 'text-[#C3643D]' : 'text-slate-300'} />
                  </div>

                  {/* Signal Breakdown */}
                  <div className="bg-white rounded-2xl p-8 shadow-xl border border-slate-100">
                    <h3 className={`text-xs font-bold uppercase tracking-widest mb-6 text-[#3A6B7E]`}>Signal Decoding</h3>
                    <div className="space-y-6">
                      {[
                        { label: 'Explicit', val: analysis.explicit, icon: '📍' },
                        { label: 'Implicit', val: analysis.implicit, icon: '⚖️' },
                        { label: 'Masked', val: analysis.masked, icon: '🎭' }
                      ].map((sig, i) => (
                        <div key={i}>
                          <div className="flex items-center gap-2 mb-1">
                            <span className="text-lg">{sig.icon}</span>
                            <span className={`font-bold text-[10px] uppercase tracking-tighter text-[#C3643D]`}>{sig.label}</span>
                          </div>
                          <p className="text-sm text-[#384653] pl-7 leading-snug">{sig.val}</p>
                        </div>
                      ))}
                    </div>
                  </div>

                  {/* Draft Response */}
                  <div className="bg-white rounded-2xl p-8 shadow-xl border border-slate-100 relative">
                    <div className="absolute top-0 left-0 w-full h-2 rounded-t-2xl bg-gradient-to-r from-[#C7E0E7] to-[#64B8CE]"></div>
                    <div className="flex items-center justify-between mb-4">
                      <h3 className={`text-xs font-bold uppercase tracking-widest text-[#3A6B7E]`}>Governed Response Draft</h3>
                      <button 
                        onClick={() => {
                          const el = document.createElement('textarea');
                          el.value = analysis.suggested_draft;
                          document.body.appendChild(el);
                          el.select();
                          document.execCommand('copy');
                          document.body.removeChild(el);
                        }}
                        className="p-2 hover:bg-slate-50 rounded-full transition-colors text-[#64B8CE]"
                      >
                        <Copy size={16} />
                      </button>
                    </div>
                    <div className="bg-slate-50 p-5 rounded-xl text-sm text-[#384653] leading-relaxed border border-slate-100 italic font-serif relative">
                      <span className="absolute top-2 left-2 text-2xl text-slate-200 leading-none">“</span>
                      {analysis.suggested_draft}
